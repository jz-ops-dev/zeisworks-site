---
---

<!--
  Gap Analysis Modal — globally mounted in BaseLayout.
  Trigger from any element with data-modal="gap-analysis".
  Netlify form detection: a hidden form with name="gap-analysis" must also
  exist on the page at build time (included below as a hidden form).
-->

<!-- Hidden Netlify detection form (never shown, needed for build-time scraping) -->
<form name="gap-analysis-modal" netlify netlify-honeypot="bot-field" hidden>
  <input type="text" name="name" />
  <input type="email" name="email" />
  <input type="text" name="business_name" />
  <input type="text" name="website" />
  <textarea name="description"></textarea>
  <select name="how_found"></select>
  <textarea name="concern"></textarea>
  <input type="tel" name="phone" />
</form>

<dialog
  id="ga-modal"
  class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent backdrop:bg-ink/60"
  style="width:100vw;height:100vh;max-width:100vw;max-height:100vh;"
  aria-labelledby="ga-modal-title"
>
  <div class="flex items-start justify-center min-h-full p-4 py-8 overflow-y-auto">
    <div
      id="ga-modal-panel"
      class="relative w-full max-w-xl rounded-2xl overflow-hidden shadow-2xl"
      style="background: #1e2e1e;"
    >

      <!-- Close button -->
      <button
        id="ga-modal-close"
        type="button"
        aria-label="Close"
        class="absolute top-4 right-4 z-10 text-white/50 hover:text-white transition-colors text-2xl leading-none"
      >
        &times;
      </button>

      <!-- Header -->
      <div class="px-8 pt-8 pb-0 text-center">
        <p
          class="text-xs font-semibold tracking-widest uppercase mb-3"
          style="color: rgba(255,255,255,0.45);"
        >
          Free &nbsp;·&nbsp; No call required &nbsp;·&nbsp; Results in 12 hours
        </p>
        <h2
          id="ga-modal-title"
          class="font-serif text-2xl font-bold text-white leading-tight mb-3"
          style="letter-spacing:-0.02em;"
        >
          Request your free gap analysis.
        </h2>
        <p class="text-sm mb-6" style="color:rgba(255,255,255,0.6);line-height:1.7;">
          Fill out the form below. I'll run the analysis and send you the results.
          <strong style="color:#fff;">No call required to receive your report.</strong>
        </p>
      </div>

      <!-- Form -->
      <div class="px-8 pb-8">
        <form
          id="ga-modal-form"
          name="gap-analysis-modal"
          class="flex flex-col gap-4"
          novalidate
        >
          <input type="hidden" name="form-name" value="gap-analysis-modal" />
          <p style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <!-- Row: name + email -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label for="gam-name" class="ga-modal-label">
                Your name <span style="color:var(--orange);">*</span>
              </label>
              <input
                type="text"
                id="gam-name"
                name="name"
                placeholder="Jane Smith"
                required
                autocomplete="name"
                class="ga-modal-input"
              />
            </div>
            <div class="flex flex-col gap-1">
              <label for="gam-email" class="ga-modal-label">
                Email address <span style="color:var(--orange);">*</span>
              </label>
              <input
                type="email"
                id="gam-email"
                name="email"
                placeholder="jane@yourbusiness.com"
                required
                autocomplete="email"
                class="ga-modal-input"
              />
            </div>
          </div>

          <!-- Row: business name + website -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label for="gam-business" class="ga-modal-label">
                Business name <span style="color:var(--orange);">*</span>
              </label>
              <input
                type="text"
                id="gam-business"
                name="business_name"
                placeholder="Acme Plumbing Co."
                required
                class="ga-modal-input"
              />
            </div>
            <div class="flex flex-col gap-1">
              <label for="gam-website" class="ga-modal-label">
                Website <span style="color:rgba(255,255,255,0.35);font-weight:400;">(optional)</span>
              </label>
              <input
                type="text"
                id="gam-website"
                name="website"
                placeholder="yourbusiness.com"
                autocomplete="url"
                class="ga-modal-input"
              />
            </div>
          </div>

          <!-- Description -->
          <div class="flex flex-col gap-1">
            <label for="gam-description" class="ga-modal-label">
              What do you do, and who are your customers?
              <span style="color:rgba(255,255,255,0.35);font-weight:400;">(optional)</span>
            </label>
            <textarea
              id="gam-description"
              name="description"
              placeholder="e.g. Med spa in Boise, ID — skin care and body treatments for women 35–60."
              class="ga-modal-input"
              style="min-height:80px;resize:vertical;"
            ></textarea>
          </div>

          <!-- How found -->
          <div class="flex flex-col gap-1">
            <label for="gam-how-found" class="ga-modal-label">
              How are customers currently finding you?
              <span style="color:rgba(255,255,255,0.35);font-weight:400;">(optional)</span>
            </label>
            <select id="gam-how-found" name="how_found" class="ga-modal-input">
              <option value="">Select the best answer</option>
              <option value="word-of-mouth">Mostly word of mouth / referrals</option>
              <option value="google-search">Google search — but I want more</option>
              <option value="google-maps">Google Maps / local pack</option>
              <option value="social-media">Social media</option>
              <option value="paid-ads">Paid ads (Google, Meta, etc.)</option>
              <option value="not-sure">I'm not sure where leads come from</option>
              <option value="not-enough">They're not — that's the problem</option>
            </select>
          </div>

          <!-- Concern -->
          <div class="flex flex-col gap-1">
            <label for="gam-concern" class="ga-modal-label">
              Biggest marketing concern right now?
              <span style="color:rgba(255,255,255,0.35);font-weight:400;">(optional)</span>
            </label>
            <textarea
              id="gam-concern"
              name="concern"
              placeholder="e.g. Not showing up when people search for my services on Google."
              class="ga-modal-input"
              style="min-height:60px;resize:vertical;"
            ></textarea>
          </div>

          <!-- Phone -->
          <div class="flex flex-col gap-1">
            <label for="gam-phone" class="ga-modal-label">
              Phone
              <span style="color:rgba(255,255,255,0.35);font-weight:400;">(optional — if you'd like me to be able to call)</span>
            </label>
            <input
              type="tel"
              id="gam-phone"
              name="phone"
              placeholder="(720) 650-2447"
              autocomplete="tel"
              class="ga-modal-input"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="ga-modal-submit"
            class="w-full font-medium text-white rounded-xl py-3.5 text-base transition-all mt-1"
            style="background:var(--orange);"
          >
            Send my analysis request →
          </button>
          <p class="text-xs text-center" style="color:rgba(255,255,255,0.35);line-height:1.6;">
            Free. No credit card. No obligation. Results within 12 hours.
          </p>
        </form>

        <!-- Success state -->
        <div id="ga-modal-success" class="hidden py-10 text-center">
          <div class="text-4xl mb-4">✓</div>
          <p class="font-serif text-xl font-semibold text-white mb-2">Request received.</p>
          <p class="text-sm" style="color:rgba(255,255,255,0.6);">
            I'll run your analysis and send the results to your inbox within 12 hours.
          </p>
        </div>
      </div>

    </div>
  </div>
</dialog>

<style is:global>
  /* Shared modal input styles */
  .ga-modal-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.02em;
  }
  .ga-modal-input {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.5rem;
    padding: 0.7rem 0.875rem;
    font-size: 0.9375rem;
    color: #fff;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }
  .ga-modal-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }
  .ga-modal-input:focus {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.12);
  }
  .ga-modal-input option {
    background: #1e2e1e;
    color: #fff;
  }

  /* Floating trigger button */
  #ga-float-btn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(200, 90, 32, 0.45);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    text-decoration: none;
    white-space: nowrap;
  }
  #ga-float-btn:hover {
    background: #a8511f;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(200, 90, 32, 0.55);
  }
  #ga-float-btn:active {
    transform: translateY(0);
  }

  /* Hide float button on the gap-analysis page itself to avoid redundancy */
  body[data-page="gap-analysis"] #ga-float-btn {
    display: none;
  }

  /* Smooth dialog backdrop */
  #ga-modal::backdrop {
    background: rgba(30, 28, 24, 0.65);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  const modal = document.getElementById('ga-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('ga-modal-close');
  const form = document.getElementById('ga-modal-form') as HTMLFormElement | null;
  const success = document.getElementById('ga-modal-success');
  const submitBtn = document.getElementById('ga-modal-submit') as HTMLButtonElement | null;

  function openGaModal() {
    if (modal) modal.showModal();
  }

  // Expose globally so any page can call window.openGaModal()
  (window as any).openGaModal = openGaModal;

  // Wire up all triggers: data-modal="gap-analysis"
  document.querySelectorAll('[data-modal="gap-analysis"]').forEach(trigger => {
    trigger.addEventListener('click', openGaModal);
  });

  // Close on X button
  closeBtn?.addEventListener('click', () => modal?.close());

  // Close on backdrop click (click outside the panel)
  modal?.addEventListener('click', e => {
    const panel = document.getElementById('ga-modal-panel');
    if (panel && !panel.contains(e.target as Node)) modal.close();
  });

  // Reset on close
  modal?.addEventListener('close', () => {
    if (form) form.style.display = '';
    success?.classList.add('hidden');
    form?.reset();
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send my analysis request →';
    }
  });

  // Netlify AJAX submission
  form?.addEventListener('submit', async e => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const data = new URLSearchParams(new FormData(form) as any);
    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString(),
      });
    } catch (_) {
      // Fail silently — still show success to avoid blocking the user
    }

    if (form) form.style.display = 'none';
    success?.classList.remove('hidden');
  });
</script>
