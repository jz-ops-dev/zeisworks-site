---
// ZeisWorks brand mark: cream rounded-square tiles on the azure field.
// Geometry mirrors public/favicon.svg so the nav/footer mark and the
// browser tab icon stay identical. Size via the `class` prop.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect width="100" height="100" rx="22" fill="#E04530" />
  <!-- Row 1: three tiles -->
  <rect x="15" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
  <rect x="40" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
  <rect x="65" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
  <!-- Row 2: center tile -->
  <rect x="40" y="40" width="20" height="20" rx="4" fill="#FAF8F3" />
  <!-- Row 3: three tiles -->
  <rect x="15" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
  <rect x="40" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
  <rect x="65" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
</svg>
