---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  readingTime: string;
  slug: string;
}

const { title, description, publishDate, readingTime, slug } = Astro.props;

const dateFormatted = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article>
  <a href={`/guides/${slug}/`} class="group block">
    <div class="flex items-center gap-2 text-xs text-ink-light mb-2">
      <time datetime={publishDate.toISOString()}>{dateFormatted}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </div>
    <h2 class="font-serif text-lg font-semibold leading-snug group-hover:text-navy transition-colors mb-1.5">
      {title}
    </h2>
    <p class="text-ink-mid text-sm leading-relaxed line-clamp-2">{description}</p>
  </a>
</article>
