---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  readingTime: string;
  slug: string;
}

const { title, description, publishDate, readingTime, slug } = Astro.props;

const dateFormatted = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article>
  <a href={`/guides/${slug}/`} class="group block">
    <p class="text-xs text-ink-mid mb-2">
      <time datetime={publishDate.toISOString()}>{dateFormatted}</time>
      <span class="mx-1.5" aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </p>
    <h2 class="font-serif text-xl font-bold leading-snug group-hover:text-navy transition-colors mb-2">
      {title}
    </h2>
    <p class="text-ink-mid text-sm leading-relaxed line-clamp-2">{description}</p>
  </a>
</article>
