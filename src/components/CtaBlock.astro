---
import AuditCta from './AuditCta.astro';

// Closing CTA band (homepage section 6 pattern), reused across pages.
interface Props {
  heading: string;
  smallText?: string;
}

const { heading, smallText = 'Free. No obligation. No contracts.' } = Astro.props;
---

<section class="relative bg-navy-deep overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 60% at 50% 100%, rgba(224,69,48,0.14) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>
  <div class="relative max-w-3xl mx-auto px-6 py-16 sm:py-20 text-center">
    <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-white leading-tight mb-8">
      {heading}
    </h2>
    <AuditCta
      location="footer"
      class="inline-block bg-orange text-white font-semibold text-base px-8 py-4 rounded-lg hover:bg-orange-bright transition-colors shadow-lg shadow-orange/25"
    />
    <p class="mt-4 text-sm text-white/60">{smallText}</p>
  </div>
</section>
