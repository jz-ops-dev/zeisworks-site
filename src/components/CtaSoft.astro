---
import AuditCta from './AuditCta.astro';
---
<div class="mt-16 py-10 px-8 bg-cream-dark rounded-xl border border-cream-dark">
  <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">Free &middot; No obligation</p>
  <p class="font-serif text-xl font-semibold text-ink mb-2">
    Want to see what a VIK would do for your business?
  </p>
  <p class="text-ink-mid mb-6 text-sm leading-relaxed">
    Book a free intro call. We'll talk through where your institutional knowledge is trapped
    today and what owning a VIK would change. No pressure, no obligation.
  </p>
  <AuditCta
    location="footer"
    class="inline-block bg-orange text-white text-sm px-5 py-2.5 rounded-full hover:bg-orange-bright transition-colors font-semibold"
  />
</div>
