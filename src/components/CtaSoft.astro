---
import AuditCta from './AuditCta.astro';
---
<div class="mt-16 py-10 px-8 bg-cream-dark rounded-xl border border-cream-dark">
  <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">Free &middot; 5 minutes &middot; No call required</p>
  <p class="font-serif text-xl font-semibold text-ink mb-2">
    Want to know how your business scores on this?
  </p>
  <p class="text-ink-mid mb-6 text-sm leading-relaxed">
    Run the free 5-minute revenue audit. You get a gap analysis of your marketing and a
    12-month plan to fix the leaks. No call required. No contracts. Keep the plan either way.
  </p>
  <AuditCta
    location="footer"
    class="inline-block bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium"
  />
</div>
