---
---

<!-- Hidden Netlify detection form (never shown, needed for build-time scraping) -->
<form name="growth-plan" netlify netlify-honeypot="bot-field" hidden>
  <input type="text" name="name" />
  <input type="email" name="email" />
  <input type="text" name="business_name" />
  <input type="text" name="website" />
  <input type="text" name="services" />
  <input type="text" name="areas_served" />
  <select name="monthly_revenue"></select>
  <select name="revenue_goal"></select>
  <select name="monthly_ad_spend"></select>
  <select name="followup_speed"></select>
  <select name="close_rate"></select>
  <textarea name="biggest_gap"></textarea>
  <input type="tel" name="phone" />
</form>

<dialog
  id="gp-modal"
  class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent backdrop:bg-ink/60"
  style="width:100vw;height:100vh;max-width:100vw;max-height:100vh;"
  aria-labelledby="gp-modal-title"
>
  <div class="flex items-start justify-center min-h-full p-4 py-8 overflow-y-auto">
    <div
      id="gp-modal-panel"
      class="relative w-full rounded-2xl overflow-hidden shadow-2xl"
      style="max-width:580px;background:#1a1f2e;"
    >

      <!-- Close button -->
      <button
        id="gp-modal-close"
        type="button"
        aria-label="Close"
        class="absolute top-4 right-4 z-10 text-white/50 hover:text-white transition-colors text-2xl leading-none"
      >
        &times;
      </button>

      <!-- Header -->
      <div id="gp-modal-header" class="px-8 pt-8 pb-0 text-center">
        <p class="gp-modal-eyebrow">
          Free &nbsp;·&nbsp; No call required &nbsp;·&nbsp; 5 minutes
        </p>
        <h2
          id="gp-modal-title"
          class="gp-modal-title"
        >
          Start your free revenue audit.
        </h2>
        <p class="gp-modal-subtitle">
          Fill this out and I'll email you the link to run your 5-minute audit. Complete it to get your personalized gap analysis and 12-month growth plan.
          <strong style="color:#fff;">No call required.</strong>
        </p>
      </div>

      <!-- Form -->
      <div class="px-8 pb-8">
        <form
          id="gp-modal-form"
          name="growth-plan"
          class="flex flex-col gap-4"
          novalidate
        >
          <input type="hidden" name="form-name" value="growth-plan" />
          <p style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <!-- Name + Email -->
          <div class="gp-row">
            <div class="gp-field">
              <label for="gp-name" class="gp-label">Your name <span class="gp-req">*</span></label>
              <input type="text" id="gp-name" name="name" placeholder="Jane Smith" required autocomplete="name" class="gp-input" />
            </div>
            <div class="gp-field">
              <label for="gp-email" class="gp-label">Email address <span class="gp-req">*</span></label>
              <input type="email" id="gp-email" name="email" placeholder="jane@yourbusiness.com" required autocomplete="email" class="gp-input" />
            </div>
          </div>

          <!-- Business name + Website -->
          <div class="gp-row">
            <div class="gp-field">
              <label for="gp-business" class="gp-label">Business name <span class="gp-req">*</span></label>
              <input type="text" id="gp-business" name="business_name" placeholder="Acme Restoration" required class="gp-input" />
            </div>
            <div class="gp-field">
              <label for="gp-website" class="gp-label">Website <span class="gp-req">*</span></label>
              <input type="text" id="gp-website" name="website" placeholder="yourbusiness.com" autocomplete="url" required class="gp-input" />
            </div>
          </div>

          <!-- Services + Areas -->
          <div class="gp-row">
            <div class="gp-field">
              <label for="gp-services" class="gp-label">Services you offer <span class="gp-opt">optional</span></label>
              <input type="text" id="gp-services" name="services" placeholder="e.g. Water damage, mold remediation" class="gp-input" />
            </div>
            <div class="gp-field">
              <label for="gp-areas" class="gp-label">Areas served <span class="gp-opt">optional</span></label>
              <input type="text" id="gp-areas" name="areas_served" placeholder="e.g. Denver metro, suburbs" class="gp-input" />
            </div>
          </div>

          <!-- Current revenue + Goal -->
          <div class="gp-row">
            <div class="gp-field">
              <label for="gp-revenue" class="gp-label">Current monthly revenue <span class="gp-opt">optional</span></label>
              <select id="gp-revenue" name="monthly_revenue" class="gp-input">
                <option value="">Select a range</option>
                <option value="under-20k">Under $20K/mo</option>
                <option value="20k-50k">$20K–$50K/mo</option>
                <option value="50k-100k">$50K–$100K/mo</option>
                <option value="100k-250k">$100K–$250K/mo</option>
                <option value="250k-500k">$250K–$500K/mo</option>
                <option value="over-500k">Over $500K/mo</option>
              </select>
            </div>
            <div class="gp-field">
              <label for="gp-goal" class="gp-label">Revenue goal (12 months) <span class="gp-opt">optional</span></label>
              <select id="gp-goal" name="revenue_goal" class="gp-input">
                <option value="">Select a target</option>
                <option value="plus-10k">+$10K/mo</option>
                <option value="plus-25k">+$25K/mo</option>
                <option value="plus-50k">+$50K/mo</option>
                <option value="plus-100k">+$100K/mo</option>
                <option value="plus-250k">+$250K/mo</option>
                <option value="not-sure">Not sure — I want to see what's possible</option>
              </select>
            </div>
          </div>

          <!-- Ad spend + Follow-up -->
          <div class="gp-row">
            <div class="gp-field">
              <label for="gp-spend" class="gp-label">Monthly ad spend <span class="gp-opt">optional</span></label>
              <select id="gp-spend" name="monthly_ad_spend" class="gp-input">
                <option value="">Select a range</option>
                <option value="none">$0 — not running ads</option>
                <option value="under-1k">Under $1K/mo</option>
                <option value="1k-3k">$1K–$3K/mo</option>
                <option value="3k-10k">$3K–$10K/mo</option>
                <option value="over-10k">Over $10K/mo</option>
              </select>
            </div>
            <div class="gp-field">
              <label for="gp-followup" class="gp-label">How fast do you follow up on new leads? <span class="gp-opt">optional</span></label>
              <select id="gp-followup" name="followup_speed" class="gp-input">
                <option value="">Select one</option>
                <option value="under-5min">Under 5 minutes</option>
                <option value="under-1hr">Within an hour</option>
                <option value="same-day">Same day</option>
                <option value="next-day">Next day or longer</option>
                <option value="inconsistent">It's inconsistent</option>
              </select>
            </div>
          </div>

          <!-- Close rate -->
          <div class="gp-field">
            <label for="gp-close" class="gp-label">What percentage of inquiries turn into booked clients? <span class="gp-opt">optional</span></label>
            <select id="gp-close" name="close_rate" class="gp-input">
              <option value="">Select one</option>
              <option value="under-20">Under 20%</option>
              <option value="20-40">20–40%</option>
              <option value="40-60">40–60%</option>
              <option value="over-60">Over 60%</option>
              <option value="not-sure">I don't track it</option>
            </select>
          </div>

          <!-- Biggest gap -->
          <div class="gp-field">
            <label for="gp-gap" class="gp-label">Biggest growth challenge right now? <span class="gp-opt">optional</span></label>
            <textarea
              id="gp-gap"
              name="biggest_gap"
              placeholder="e.g. Not showing up on Google when people search for water damage near me. Leads come in but don't convert."
              class="gp-input"
              style="min-height:70px;resize:vertical;"
            ></textarea>
          </div>

          <!-- Phone -->
          <div class="gp-field">
            <label for="gp-phone" class="gp-label">Phone <span class="gp-opt">optional — if you'd like a follow-up call</span></label>
            <input type="tel" id="gp-phone" name="phone" placeholder="(720) 650-2447" autocomplete="tel" class="gp-input" />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="gp-modal-submit"
            class="gp-submit"
          >
            Send me my audit link →
          </button>
          <p class="gp-disclaimer">
            Free. No credit card. No obligation.
          </p>
        </form>

        <!-- Success state -->
        <div id="gp-modal-success" class="hidden py-10 text-center">
          <div class="text-4xl mb-4" style="color:#a5b4fc;">✓</div>
          <p class="font-serif text-xl font-semibold text-white mb-2">Check your email.</p>
          <p class="text-sm mb-5" style="color:rgba(255,255,255,0.6);line-height:1.75;">
            I just sent you the link to run your 5-minute revenue audit. Complete it to get your personalized gap analysis and 12-month growth plan.
          </p>
          <a
            href="https://app.mplannerpro.com/ab3e6ce00d/chat?pg=ff84446e91"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-sm font-medium px-5 py-2.5 rounded-lg transition-colors"
            style="background:rgba(99,102,241,0.2);color:#a5b4fc;border:1px solid rgba(99,102,241,0.35);"
          >
            Start the 5-minute audit now →
          </a>
        </div>
      </div>

    </div>
  </div>
</dialog>

<style is:global>
  .gp-modal-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a5b4fc;
    margin-bottom: 0.875rem;
    display: block;
  }
  .gp-modal-title {
    font-family: var(--font-serif, serif);
    font-size: 1.625rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .gp-modal-subtitle {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .gp-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 520px) {
    .gp-row { grid-template-columns: 1fr; }
  }
  .gp-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .gp-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.02em;
  }
  .gp-req { color: #f97316; }
  .gp-opt {
    color: rgba(255,255,255,0.3);
    font-weight: 400;
    font-size: 0.75rem;
    margin-left: 2px;
  }
  .gp-input {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 0.5rem;
    padding: 0.65rem 0.875rem;
    font-size: 0.9375rem;
    color: #fff;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }
  .gp-input::placeholder { color: rgba(255,255,255,0.25); }
  .gp-input:focus {
    border-color: rgba(165,180,252,0.5);
    background: rgba(255,255,255,0.1);
  }
  .gp-input option { background: #1a1f2e; color: #fff; }
  .gp-submit {
    background: #6366f1;
    color: #fff;
    border: none;
    padding: 0.9rem 2rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    width: 100%;
    font-family: inherit;
    margin-top: 0.25rem;
    box-shadow: 0 4px 20px rgba(99,102,241,0.35);
  }
  .gp-submit:hover {
    background: #4f46e5;
    transform: translateY(-1px);
    box-shadow: 0 6px 28px rgba(99,102,241,0.45);
  }
  .gp-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }
  .gp-disclaimer {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    text-align: center;
    line-height: 1.6;
    margin-top: 0.25rem;
  }
  #gp-modal::backdrop {
    background: rgba(20,20,30,0.7);
    backdrop-filter: blur(3px);
  }
</style>

<script>
  const modal = document.getElementById('gp-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('gp-modal-close');
  const form = document.getElementById('gp-modal-form') as HTMLFormElement | null;
  const success = document.getElementById('gp-modal-success');
  const header = document.getElementById('gp-modal-header');
  const submitBtn = document.getElementById('gp-modal-submit') as HTMLButtonElement | null;

  function openGpModal() {
    if (modal) modal.showModal();
  }

  (window as any).openGpModal = openGpModal;

  closeBtn?.addEventListener('click', () => modal?.close());

  modal?.addEventListener('click', e => {
    const panel = document.getElementById('gp-modal-panel');
    if (panel && !panel.contains(e.target as Node)) modal.close();
  });

  modal?.addEventListener('close', () => {
    if (form) form.style.display = '';
    success?.classList.add('hidden');
    header?.classList.remove('hidden');
    form?.reset();
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send me my audit link →';
    }
  });

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const data = new URLSearchParams(new FormData(form) as any);
    try {
      await fetch(window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString(),
      });
    } catch (_) {}

    if (form) form.style.display = 'none';
    header?.classList.add('hidden');
    success?.classList.remove('hidden');

    if (typeof (window as any).gtag !== 'undefined') {
      (window as any).gtag('event', 'growth_plan_form_submit');
    }
    if (typeof (window as any).fbq !== 'undefined') {
      (window as any).fbq('track', 'Lead', { content_name: 'growth-plan', content_category: 'zeisworks_form' });
    }
    if (typeof (window as any).oaiq !== 'undefined') {
      (window as any).oaiq('measure', 'registration_completed', { type: 'customer_action', amount: 0, currency: 'USD' });
    }
  });
</script>
