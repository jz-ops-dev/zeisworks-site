---
import { CALENDLY_URL } from '../config';

// The single conversion action on the site: book a free intro call. The data
// attributes drive the global cta-click tracking and UTM passthrough in the
// layouts.
interface Props {
  location: 'nav' | 'hero' | 'mid' | 'footer' | 'exit-modal';
  label?: string;
  class?: string;
}

const { location, label = 'Book a call', class: className = '' } = Astro.props;
---

<a
  href={CALENDLY_URL}
  data-audit-cta
  data-cta-location={location}
  class={className}
>{label}</a>
