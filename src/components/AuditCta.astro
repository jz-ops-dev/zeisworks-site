---
// The single conversion action on the site: open the interactive get-started
// funnel at /start (which qualifies, captures, then books). The data
// attributes drive the global cta-click tracking and UTM passthrough.
interface Props {
  location: 'nav' | 'hero' | 'mid' | 'footer' | 'exit-modal';
  label?: string;
  class?: string;
}

const { location, label = 'Get started', class: className = '' } = Astro.props;
---

<a
  href="/start"
  data-audit-cta
  data-cta-location={location}
  class={className}
>{label}</a>
