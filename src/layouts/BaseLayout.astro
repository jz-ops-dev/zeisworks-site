---
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage
  ? new URL(ogImage, siteUrl).href
  : undefined;
---

<!doctype html>
<html lang="en" class="bg-cream text-ink scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title} | zeisWorks. Modern small business growth.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <slot name="head" />
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col">
    <header class="border-b border-cream-dark sticky top-0 bg-cream/95 backdrop-blur-sm z-10">
      <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a
          href="/"
          class="font-serif text-xl font-semibold text-ink hover:text-navy transition-colors"
        >
          zeisWorks<span class="text-orange">.</span>
        </a>
        <nav class="flex items-center gap-5 text-sm">
          <a href="/#services" class="text-ink-mid hover:text-ink transition-colors">
            Services
          </a>
          <a href="/guides/" class="text-ink-mid hover:text-ink transition-colors">
            Guides
          </a>
          <a href="/what-i-use" class="text-ink-mid hover:text-ink transition-colors">
            What I Use
          </a>
          <a href="/about" class="text-ink-mid hover:text-ink transition-colors">
            About
          </a>
          <a
            href="/#contact"
            class="bg-navy text-cream text-sm px-4 py-2 rounded-lg hover:bg-navy/90 transition-colors font-medium"
          >
            Free analysis
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-cream-dark mt-24">
      <div
        class="max-w-3xl mx-auto px-6 py-10 flex flex-col sm:flex-row justify-between items-start gap-4 text-sm text-ink-mid"
      >
        <div>
          <span class="font-serif font-semibold text-ink">
            zeisWorks<span class="text-orange">.</span>
          </span>
          <p class="mt-1">Modern small business consulting. Golden, CO.</p>
        </div>
        <p class="shrink-0">&copy; {new Date().getFullYear()} Jack Zeis. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
