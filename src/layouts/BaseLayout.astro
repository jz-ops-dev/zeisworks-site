---
import GapAnalysisModal from '../components/GapAnalysisModal.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
  bodyPage?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  canonicalUrl,
  bodyPage,
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage
  ? new URL(ogImage, siteUrl).href
  : undefined;

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ZeisWorks',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Small business growth consulting for Golden, Colorado. Local SEO, paid ads, operations, and custom tools for Front Range service businesses.',
  telephone: '+17206502447',
  email: 'jack@zeisworks.com',
  founder: {
    '@type': 'Person',
    name: 'Jack Zeis',
    jobTitle: 'Small Business Growth Consultant',
    url: siteUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Golden',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'Golden', addressRegion: 'CO' },
    { '@type': 'City', name: 'Denver', addressRegion: 'CO' },
    { '@type': 'City', name: 'Arvada', addressRegion: 'CO' },
    { '@type': 'City', name: 'Lakewood', addressRegion: 'CO' },
    { '@type': 'City', name: 'Wheat Ridge', addressRegion: 'CO' },
    { '@type': 'City', name: 'Littleton', addressRegion: 'CO' },
    { '@type': 'City', name: 'Boulder', addressRegion: 'CO' },
  ],
  sameAs: [
    'https://www.upwork.com',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'ZeisWorks Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Local SEO & Google Business Profile Optimization' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Paid Ads Management (Meta & Google)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Marketing Gap Analysis (Free)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Business Operations & Systems' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Tools & Automation' } },
    ],
  },
};
---

<!doctype html>
<html lang="en" class="bg-cream text-ink scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:site_name" content="zeisWorks" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <title>{title} | zeisWorks. Modern small business growth.</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F05WB9RWJT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F05WB9RWJT');
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    <slot name="head" />

    <!-- Meta Pixel Base Code -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '555580570097631');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=555580570097631&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Base Code -->

    <style is:global>
      :root {
        --ink: #1E1C18;
        --ink-mid: #5A5650;
        --ink-light: #9A9590;
        --cream: #FAF8F3;
        --cream-dark: #F0EAD9;
        --terra: #2D4A6B;
        --terra-light: #D6E0EC;
        --terra-dark: #1E3350;
        --orange: #C85A20;
        --orange-light: #F2E0D5;
        --navy: #2D4A6B;
        --forest: #2C4A3E;
        --forest-mid: #3D6B5A;
        --forest-light: #D8EAE4;
        --forest-dark: #1C3029;
        --font-serif: 'Lora', Georgia, serif;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --font-mono: 'DM Mono', monospace;
      }

      /* ─── Animation system ──────────────────────────────────────────── */
      @media (prefers-reduced-motion: no-preference) {

        /* Hero: first content block — children stagger in on load */
        .hz-hero > * {
          opacity: 0;
          animation: hz-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .hz-hero > *:nth-child(1) { animation-delay:   0ms; }
        .hz-hero > *:nth-child(2) { animation-delay: 100ms; }
        .hz-hero > *:nth-child(3) { animation-delay: 190ms; }
        .hz-hero > *:nth-child(4) { animation-delay: 280ms; }
        .hz-hero > *:nth-child(5) { animation-delay: 350ms; }

        /* Scroll-reveal: sections fade + rise into view */
        .hz-reveal {
          opacity: 0;
          transform: translateY(30px);
          transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hz-reveal.hz-in { opacity: 1; transform: none; }

        /* Stagger: list / grid items inside a revealed section */
        .hz-reveal .hz-item { opacity: 0; }
        .hz-reveal.hz-in .hz-item {
          animation: hz-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .hz-reveal.hz-in .hz-item:nth-child(1) { animation-delay:  50ms; }
        .hz-reveal.hz-in .hz-item:nth-child(2) { animation-delay: 115ms; }
        .hz-reveal.hz-in .hz-item:nth-child(3) { animation-delay: 180ms; }
        .hz-reveal.hz-in .hz-item:nth-child(4) { animation-delay: 245ms; }
        .hz-reveal.hz-in .hz-item:nth-child(5) { animation-delay: 310ms; }
        .hz-reveal.hz-in .hz-item:nth-child(n+6) { animation-delay: 360ms; }

        @keyframes hz-up {
          from { opacity: 0; transform: translateY(22px); }
          to   { opacity: 1; transform: none; }
        }

        /* Card hover lift — applied to block-link cards */
        .hz-card {
          transition: transform 0.2s ease, box-shadow 0.2s ease !important;
        }
        .hz-card:hover {
          transform: translateY(-4px) !important;
          box-shadow: 0 14px 36px rgba(30, 28, 24, 0.11) !important;
        }
        .hz-card:active { transform: translateY(-1px) !important; }

        /* Skill tags — subtle scale pop on hover */
        .hz-tag {
          transition: transform 0.15s ease, background-color 0.15s ease !important;
          cursor: default;
        }
        .hz-tag:hover { transform: scale(1.05) !important; }

        /* Floating button — spring bounce in after page settles */
        #ga-float-btn {
          opacity: 0;
          animation: hz-float-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
          animation-delay: 1.6s;
        }
        @keyframes hz-float-in {
          from { opacity: 0; transform: translateY(28px) scale(0.85); }
          to   { opacity: 1; transform: none; }
        }

        /* Nav logo — fade in */
        header .font-serif { animation: hz-fade 0.4s ease both; }
        header nav { animation: hz-fade 0.5s ease 0.1s both; }
        @keyframes hz-fade {
          from { opacity: 0; }
          to   { opacity: 1; }
        }
      }
      /* ──────────────────────────────────────────────────────────────── */
    </style>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col" data-page={bodyPage}>
    <header class="border-b border-cream-dark sticky top-0 bg-cream/95 backdrop-blur-sm z-10">
      <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a
          href="/"
          class="font-serif text-xl font-semibold text-ink hover:text-navy transition-colors"
        >
          zeisWorks<span class="text-orange">.</span>
        </a>
        <!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-5 text-sm">
          <a href="/#services" class="text-ink-mid hover:text-ink transition-colors">Services</a>
          <a href="/guides/" class="text-ink-mid hover:text-ink transition-colors">Guides</a>
          <a href="/what-i-use" class="text-ink-mid hover:text-ink transition-colors">What I Use</a>
          <a href="/about" class="text-ink-mid hover:text-ink transition-colors">About</a>
          <button type="button" data-modal="gap-analysis" class="bg-navy text-cream text-sm px-4 py-2 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0">
            Get in touch
          </button>
        </nav>
        <!-- Mobile hamburger -->
        <button
          id="mobileMenuBtn"
          class="sm:hidden flex flex-col justify-center gap-[5px] w-9 h-9 p-1 rounded-lg hover:bg-cream-dark transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-transform duration-250 origin-center" id="hb1"></span>
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-opacity duration-200" id="hb2"></span>
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-transform duration-250 origin-center" id="hb3"></span>
        </button>
      </div>
      <!-- Mobile menu drawer -->
      <div id="mobileMenu" class="hidden sm:hidden border-t border-cream-dark bg-cream px-6 pb-5 pt-4">
        <nav class="flex flex-col gap-0">
          <a href="/#services" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">Services</a>
          <a href="/guides/" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">Guides</a>
          <a href="/what-i-use" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">What I Use</a>
          <a href="/about" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">About</a>
          <button type="button" data-modal="gap-analysis" class="mobile-nav-link mt-4 block w-full text-center bg-navy text-cream text-sm px-4 py-3 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0">
            Get in touch →
          </button>
        </nav>
      </div>
    </header>

    <script>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      const hb1 = document.getElementById('hb1');
      const hb2 = document.getElementById('hb2');
      const hb3 = document.getElementById('hb3');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const open = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!open));
          hb1.style.transform = open ? '' : 'translateY(7px) rotate(45deg)';
          hb2.style.opacity = open ? '' : '0';
          hb3.style.transform = open ? '' : 'translateY(-7px) rotate(-45deg)';
        });
        menu.querySelectorAll('.mobile-nav-link').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            hb1.style.transform = '';
            hb2.style.opacity = '';
            hb3.style.transform = '';
          });
        });
        document.addEventListener('click', (e) => {
          if (!btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            hb1.style.transform = '';
            hb2.style.opacity = '';
            hb3.style.transform = '';
          }
        });
      }
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Gap Analysis Modal -->
    <GapAnalysisModal />

    <!-- Floating trigger button (hidden on gap-analysis page via CSS) -->
    <button
      id="ga-float-btn"
      type="button"
      data-modal="gap-analysis"
      aria-label="Get your free gap analysis"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      Get in touch
    </button>

    <script>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const wrap = document.querySelector('main .max-w-3xl');
        if (!wrap) return;
        const kids = Array.from(wrap.children);
        if (!kids.length) return;

        // First block → hero entrance (CSS nth-child handles sequencing)
        kids[0].classList.add('hz-hero');

        // Remaining blocks → scroll-reveal + stagger their items
        kids.slice(1).forEach(el => {
          el.classList.add('hz-reveal');
          // Mark list items, grid children, and stacked block-links for stagger
          el.querySelectorAll(
            'ul > li, ol > li, .grid > div, .grid > a, .space-y-4 > a, .space-y-4 > div'
          ).forEach(item => item.classList.add('hz-item'));
        });

        // Block-link cards (e.g., about page service pillars) get hover lift
        document.querySelectorAll('a.block.rounded-xl').forEach(el => el.classList.add('hz-card'));

        // Skill / tag chips get a micro pop
        document.querySelectorAll('span.rounded-full').forEach(el => el.classList.add('hz-tag'));

        // IntersectionObserver — reveal sections as they scroll into view
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('hz-in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.07, rootMargin: '0px 0px -36px 0px' });

        wrap.querySelectorAll('.hz-reveal').forEach(el => io.observe(el));
      })();
    </script>

    <footer class="border-t border-cream-dark mt-24">
      <div
        class="max-w-3xl mx-auto px-6 py-10 flex flex-col sm:flex-row justify-between items-start gap-4 text-sm text-ink-mid"
      >
        <div>
          <span class="font-serif font-semibold text-ink">
            zeisWorks<span class="text-orange">.</span>
          </span>
          <p class="mt-1">Modern small business consulting. Golden, CO.</p>
        </div>
        <div class="shrink-0 flex flex-col items-end gap-1.5">
          <p>&copy; {new Date().getFullYear()} Jack Zeis. All rights reserved.</p>
          <p class="flex gap-3 text-xs" style="font-family:'DM Mono',monospace;letter-spacing:0.04em;">
            <a href="/terms" class="text-ink-light hover:text-ink-mid transition-colors">Terms</a>
            <span class="text-ink-light" aria-hidden="true">·</span>
            <a href="/privacy" class="text-ink-light hover:text-ink-mid transition-colors">Privacy</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
