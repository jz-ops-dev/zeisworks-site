---
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const resolvedOgImage = ogImage
  ? new URL(ogImage, siteUrl).href
  : undefined;

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ZeisWorks',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Modern small business growth consulting — local SEO, paid ads, operations, and custom tools for service businesses.',
  telephone: '+17206502447',
  email: 'jack@zeisworks.com',
  founder: {
    '@type': 'Person',
    name: 'Jack Zeis',
    jobTitle: 'Small Business Growth Consultant',
    url: siteUrl,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Golden',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  sameAs: [
    'https://www.upwork.com',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'ZeisWorks Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Local SEO & Google Business Profile Optimization' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Paid Ads Management (Meta & Google)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Marketing Gap Analysis (Free)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Business Operations & Systems' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Tools & Automation' } },
    ],
  },
};
---

<!doctype html>
<html lang="en" class="bg-cream text-ink scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:site_name" content="zeisWorks" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <title>{title} | zeisWorks. Modern small business growth.</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    <slot name="head" />

    <!-- Meta Pixel Base Code -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '555580570097631');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=555580570097631&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Base Code -->

    <style is:global>
      :root {
        --ink: #1E1C18;
        --ink-mid: #5A5650;
        --ink-light: #9A9590;
        --cream: #FAF8F3;
        --cream-dark: #F0EAD9;
        --terra: #2D4A6B;
        --terra-light: #D6E0EC;
        --terra-dark: #1E3350;
        --orange: #C85A20;
        --orange-light: #F2E0D5;
        --navy: #2D4A6B;
        --forest: #2C4A3E;
        --forest-mid: #3D6B5A;
        --forest-light: #D8EAE4;
        --forest-dark: #1C3029;
        --font-serif: 'Lora', Georgia, serif;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --font-mono: 'DM Mono', monospace;
      }
    </style>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col">
    <header class="border-b border-cream-dark sticky top-0 bg-cream/95 backdrop-blur-sm z-10">
      <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
        <a
          href="/"
          class="font-serif text-xl font-semibold text-ink hover:text-navy transition-colors"
        >
          zeisWorks<span class="text-orange">.</span>
        </a>
        <!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-5 text-sm">
          <a href="/#services" class="text-ink-mid hover:text-ink transition-colors">Services</a>
          <a href="/guides/" class="text-ink-mid hover:text-ink transition-colors">Guides</a>
          <a href="/what-i-use" class="text-ink-mid hover:text-ink transition-colors">What I Use</a>
          <a href="/about" class="text-ink-mid hover:text-ink transition-colors">About</a>
          <a href="/#contact" class="bg-navy text-cream text-sm px-4 py-2 rounded-lg hover:bg-navy/90 transition-colors font-medium">
            Free analysis
          </a>
        </nav>
        <!-- Mobile hamburger -->
        <button
          id="mobileMenuBtn"
          class="sm:hidden flex flex-col justify-center gap-[5px] w-9 h-9 p-1 rounded-lg hover:bg-cream-dark transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-transform duration-250 origin-center" id="hb1"></span>
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-opacity duration-200" id="hb2"></span>
          <span class="block w-[22px] h-[2px] bg-ink rounded transition-transform duration-250 origin-center" id="hb3"></span>
        </button>
      </div>
      <!-- Mobile menu drawer -->
      <div id="mobileMenu" class="hidden sm:hidden border-t border-cream-dark bg-cream px-6 pb-5 pt-4">
        <nav class="flex flex-col gap-0">
          <a href="/#services" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">Services</a>
          <a href="/guides/" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">Guides</a>
          <a href="/what-i-use" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">What I Use</a>
          <a href="/about" class="mobile-nav-link py-3 border-b border-cream-dark text-ink-mid hover:text-ink transition-colors text-sm">About</a>
          <a href="/#contact" class="mobile-nav-link mt-4 block text-center bg-navy text-cream text-sm px-4 py-3 rounded-lg hover:bg-navy/90 transition-colors font-medium">
            Free analysis →
          </a>
        </nav>
      </div>
    </header>

    <script>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      const hb1 = document.getElementById('hb1');
      const hb2 = document.getElementById('hb2');
      const hb3 = document.getElementById('hb3');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const open = menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!open));
          hb1.style.transform = open ? '' : 'translateY(7px) rotate(45deg)';
          hb2.style.opacity = open ? '' : '0';
          hb3.style.transform = open ? '' : 'translateY(-7px) rotate(-45deg)';
        });
        menu.querySelectorAll('.mobile-nav-link').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            hb1.style.transform = '';
            hb2.style.opacity = '';
            hb3.style.transform = '';
          });
        });
        document.addEventListener('click', (e) => {
          if (!btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            hb1.style.transform = '';
            hb2.style.opacity = '';
            hb3.style.transform = '';
          }
        });
      }
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-cream-dark mt-24">
      <div
        class="max-w-3xl mx-auto px-6 py-10 flex flex-col sm:flex-row justify-between items-start gap-4 text-sm text-ink-mid"
      >
        <div>
          <span class="font-serif font-semibold text-ink">
            zeisWorks<span class="text-orange">.</span>
          </span>
          <p class="mt-1">Modern small business consulting. Golden, CO.</p>
        </div>
        <div class="shrink-0 flex flex-col items-end gap-1.5">
          <p>&copy; {new Date().getFullYear()} Jack Zeis. All rights reserved.</p>
          <p class="flex gap-3 text-xs" style="font-family:'DM Mono',monospace;letter-spacing:0.04em;">
            <a href="/terms" class="text-ink-light hover:text-ink-mid transition-colors">Terms</a>
            <span class="text-ink-light" aria-hidden="true">·</span>
            <a href="/privacy" class="text-ink-light hover:text-ink-mid transition-colors">Privacy</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
