---
// Shared template for the /for/* segment landing pages (CO-002 item A).
// Data-only pages pass copy in; structure is: hero → what your VIK holds →
// what runs on it → demo band → condensed offer ladder → CTA.
import LandingLayout from './LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import FileExplorer from '../components/FileExplorer.astro';
import type { Route } from '../components/FileExplorer.astro';
import OfferLadder from '../components/OfferLadder.astro';

interface Props {
  title: string;
  description: string;
  segment: 'consulting' | 'agency';
  eyebrow: string;
  h1: string;
  intro: string[];
  holds: { lead: string; body: string }[];
  runs: string[];
  routes: Route[];
  serviceName: string;
  audienceName: string;
}

const { title, description, segment, eyebrow, h1, intro, holds, runs, routes, serviceName, audienceName } =
  Astro.props;

const siteUrl = 'https://zeisworks.com';
const startHref = `/start?segment=${segment}`;

// All on-page anchors: a segment landing page should never send a visitor
// away mid-scroll.
const navLinks = [
  { label: 'What you own', href: '#holds' },
  { label: 'See it working', href: '#demo' },
  { label: 'Pricing', href: '#pricing' },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  description,
  url: new URL(Astro.url.pathname, siteUrl).href,
  serviceType: 'Institutional knowledge systems and AI assistants',
  provider: {
    '@type': 'ProfessionalService',
    name: 'ZeisWorks',
    url: siteUrl,
    email: 'jack@zeisworks.com',
  },
  audience: {
    '@type': 'BusinessAudience',
    name: audienceName,
  },
};
---

<LandingLayout title={title} description={description} ogImage="/og.png" navLinks={navLinks} brandHref="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="zw-section zw-hero-pad bg-zw-cream border-b border-zw-border">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure-wide">
      <p class="zw-eyebrow mb-4 zw-reveal" style="color: var(--zw-rust);">{eyebrow}</p>
      <h1 class="zw-h1 text-zw-ink mb-6 zw-reveal">{h1}</h1>
      <div class="zw-lede space-y-5 zw-reveal">
        {intro.map((p) => <p set:html={p} />)}
      </div>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 zw-reveal">
        <AuditCta
          location="hero"
          label="Book a free intro call"
          href={startHref}
          class="inline-flex items-center justify-center gap-2 bg-zw-teal text-white font-semibold px-7 py-3.5 rounded-full hover:bg-zw-rust transition-colors"
        />
        <a
          href="#demo"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-medium text-zw-ink border border-zw-ink/15 hover:bg-zw-ink/[0.04] transition-colors"
        >
          See it working
        </a>
      </div>
    </div></div>
  </section>

  <!-- ═══════════════════ WHAT YOUR VIK HOLDS ═══════════════════ -->
  <section id="holds" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">What you own</p>
      <h2 class="zw-h2 mb-8 zw-reveal">What your VIK holds</h2>
      <ul class="space-y-6">
        {holds.map((item) => (
          <li class="zw-reveal flex gap-4">
            <span class="zw-mono text-zw-teal text-sm pt-1 shrink-0" aria-hidden="true">→</span>
            <p class="text-zw-muted">
              <strong class="text-zw-ink font-semibold">{item.lead}</strong>{' '}{item.body}
            </p>
          </li>
        ))}
      </ul>
    </div></div>
  </section>

  <!-- ═══════════════════ WHAT RUNS ON IT ═══════════════════ -->
  <section class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">What it powers</p>
      <h2 class="zw-h2 mb-8 zw-reveal">What runs on it</h2>
      <ul class="space-y-6">
        {runs.map((item) => (
          <li class="zw-reveal flex gap-4">
            <span class="zw-mono text-zw-teal text-sm pt-1 shrink-0" aria-hidden="true">→</span>
            <p class="text-zw-muted">{item}</p>
          </li>
        ))}
      </ul>
    </div></div>
  </section>

  <!-- ═══════════════════ DEMO ═══════════════════ -->
  <section id="demo" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">See it working</p>
      <h2 class="zw-h2 mb-8 max-w-[820px] zw-reveal text-zw-cream">
        Every answer traces back to a file you can read and edit. Try it.
      </h2>
      <FileExplorer routes={routes} instanceId={segment} theme="dark" />
      <!-- CO-002 item D mounts the live query box in FileExplorer's "query" slot. -->
    </div>
  </section>

  <!-- ═══════════════════ OFFER LADDER + CTA ═══════════════════ -->
  <section id="pricing" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">How to start</p>
      <h2 class="zw-h2 mb-8 zw-reveal">Start small. Keep everything.</h2>
      <OfferLadder variant="condensed" startHref={startHref} />
    </div></div>
  </section>
</LandingLayout>
