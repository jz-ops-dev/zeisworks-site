---
import BaseLayout from './BaseLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { AUDIT_STEPS } from '../data/faq';

// Shared template for the three vertical conversion pages (handoff section 5).
// Four scroll-depths: hero, vertical problem, compressed how-it-works,
// FAQ + closing CTA. Every CTA books a free intro call.
interface FaqItem {
  q: string;
  a: string;
}

interface Problem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  subhead: string;
  problemH2: string;
  problems: Problem[];
  faq: FaqItem[];
  closingH2: string;
}

const { title, description, eyebrow, h1, subhead, problemH2, problems, faq, closingH2 } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <!-- 1. Hero -->
  <section class="relative bg-navy-deep overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 100% 80% at 88% 0%, rgba(224,69,48,0.22) 0%, transparent 60%), radial-gradient(ellipse 60% 45% at 10% 100%, rgba(18,58,49,0.55) 0%, transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-3xl mx-auto px-6 pt-16 sm:pt-24 pb-16 sm:pb-20 text-center">
      <p class="inline-block text-xs font-semibold uppercase tracking-widest text-rust-soft bg-white/5 border border-white/10 rounded-full px-4 py-1.5 mb-6">{eyebrow}</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.12] tracking-tight text-white mb-6">{h1}</h1>
      <p class="text-lg text-white/70 leading-relaxed max-w-2xl mx-auto mb-9">{subhead}</p>
      <AuditCta
        location="hero"
        class="inline-block bg-orange text-white font-semibold text-lg px-9 py-4 rounded-lg hover:bg-orange-bright transition-colors shadow-lg shadow-orange/30"
      />
      <p class="mt-4 text-sm text-white/50">Free. Quick. No obligation.</p>
    </div>
  </section>

  <!-- 2. The vertical-specific problem -->
  <section class="bg-white border-b border-cream-dark">
    <div class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">The problem</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-10">{problemH2}</h2>
      <div class="space-y-5">
        {problems.map((p) => (
          <div class="bg-cream border border-cream-dark border-l-4 border-l-orange rounded-xl p-6 sm:p-7">
            <h3 class="font-serif text-lg font-semibold text-ink mb-1.5">{p.title}</h3>
            <p class="text-ink-mid leading-relaxed text-[0.9375rem]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. How the intro call works (compressed) -->
  <section class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">How it works</p>
    <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-12">
      Three steps. One quick call. A clear outline.
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
      {AUDIT_STEPS.map((step, i) => (
        <div>
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-navy text-white font-serif font-semibold text-lg mb-4 shadow-sm">{i + 1}</span>
          <h3 class="font-semibold text-ink mb-1.5">{step.title}</h3>
          <p class="text-sm text-ink-mid leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>
    <div class="mt-12">
      <AuditCta
        location="mid"
        class="inline-block bg-orange text-white font-semibold text-base px-7 py-3.5 rounded-lg hover:bg-orange-bright transition-colors shadow-md shadow-orange/20"
      />
    </div>
  </section>

  <!-- 4. Vertical FAQ + closing CTA -->
  <section class="bg-white border-t border-cream-dark">
    <div class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">Questions</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-10">Straight answers.</h2>
      <dl class="divide-y divide-cream-dark border-y border-cream-dark">
        {faq.map(({ q, a }) => (
          <div class="py-6">
            <dt class="font-semibold text-ink mb-2">{q}</dt>
            <dd class="text-sm text-ink-mid leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBlock heading={closingH2} smallText="Free. Quick. No obligation." />
</BaseLayout>
