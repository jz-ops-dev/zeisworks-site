---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import CtaSoft from '../components/CtaSoft.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  readingTime: string;
  ogImage?: string;
  faq?: FaqItem[];
  slug: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  readingTime,
  ogImage,
  faq,
  slug,
} = Astro.props;

const siteUrl = 'https://zeisworks.com';
const canonicalUrl = `${siteUrl}/guides/${slug}/`;

const publishDateIso = publishDate.toISOString();
const updatedDateIso = (updatedDate ?? publishDate).toISOString();

const publishDateFormatted = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedDateFormatted = updatedDate
  ? updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDateIso,
  dateModified: updatedDateIso,
  url: canonicalUrl,
  ...(ogImage ? { image: new URL(ogImage, siteUrl).href } : {}),
  author: {
    '@type': 'Person',
    name: 'Jack Zeis',
    url: siteUrl,
    jobTitle: 'Small Business Growth Consultant',
    worksFor: {
      '@type': 'Organization',
      name: 'ZeisWorks',
      url: siteUrl,
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Golden',
      addressRegion: 'CO',
      addressCountry: 'US',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'ZeisWorks',
    url: siteUrl,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${siteUrl}/guides/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ZeisWorks',
  url: siteUrl,
  founder: {
    '@type': 'Person',
    name: 'Jack Zeis',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Golden',
    addressRegion: 'CO',
    addressCountry: 'US',
  },
};

const faqJsonLd =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <article class="max-w-3xl mx-auto px-6 py-16">
    <nav class="text-sm text-ink-mid mb-10" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/guides/" class="hover:text-ink transition-colors">Guides</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink truncate max-w-xs">{title}</li>
      </ol>
    </nav>

    <header class="mb-12">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold leading-tight mb-6">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-mid">
        <span>By Jack Zeis</span>
        <span aria-hidden="true">·</span>
        <time datetime={publishDateIso}>{publishDateFormatted}</time>
        {updatedDateFormatted && updatedDate && updatedDate > publishDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated <time datetime={updatedDateIso}>{updatedDateFormatted}</time>
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <div class="prose prose-zeisworks max-w-none">
      <slot />
    </div>

    {faq && faq.length > 0 && (
      <section class="mt-16 pt-12 border-t border-cream-dark">
        <h2 class="font-serif text-2xl font-bold mb-8">Common questions</h2>
        <dl class="space-y-8">
          {faq.map(({ question, answer }) => (
            <div>
              <dt class="font-sans font-semibold text-ink mb-2">{question}</dt>
              <dd class="text-ink-mid leading-relaxed">{answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <CtaSoft />
    <AuthorBio />
  </article>
</BaseLayout>
