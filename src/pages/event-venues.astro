---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How do I get my event venue to rank in Google for wedding and corporate event searches?",
    a: "Event venue searches are highly competitive and often have long lead times — couples searching for wedding venues are typically 12–18 months out. The highest-leverage actions are: a fully optimized Google Business Profile with event-specific categories, consistent citations across wedding and event directories (The Knot, WeddingWire, Yelp Events), and dedicated landing pages for each event type (weddings, corporate events, private parties) optimized for local search terms.",
  },
  {
    q: "Should an event venue be on The Knot and WeddingWire?",
    a: "Yes, both are essential for wedding venue visibility. They function as high-authority citation sources that Google uses as trust signals, and they drive direct inquiry traffic from couples actively searching for venues. Paid listings on these platforms can also be worth the investment once your organic presence is established, but the free listings alone provide meaningful SEO value.",
  },
  {
    q: "How do I increase inquiry form submissions from my venue website?",
    a: "The three highest-impact changes are: (1) adding a specific, low-friction inquiry form on every event type page (not just the contact page); (2) showing real availability or a 'check your date' prompt to create urgency; and (3) featuring specific pricing ranges or packages — venues that hide pricing entirely see significantly lower inquiry rates because couples self-select out before reaching out.",
  },
  {
    q: "What's the best way to market an event venue for corporate events?",
    a: "Corporate event searches are different from wedding searches — they're often shorter lead time and driven by specific capacity and amenity requirements. Dedicated pages for 'corporate event venue [city]', 'meeting room rental [city]', and 'private dining [city]' with specific capacity numbers, AV capabilities, and catering options will rank for these searches and convert corporate planners who know exactly what they need.",
  },
  {
    q: "What does a Marketing Gap Analysis include for an event venue?",
    a: "The analysis covers your Google Business Profile completeness, local search rankings for your key event categories benchmarked against your top 3–5 competitors, citation consistency across event and wedding directories, review velocity and rating, and a prioritized list of specific fixes with estimated impact on inquiry volume.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Event Venue Marketing & Local SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'ZeisWorks',
    url: 'https://zeisworks.com',
  },
  description: 'Local SEO, directory optimization, and inquiry conversion systems for event venues, wedding venues, and private event spaces.',
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: 'Marketing Consulting',
};
---

<BaseLayout
  title="Event Venue Marketing & Local SEO"
  description="Fill your event calendar with more wedding, corporate, and private event inquiries. Local SEO and conversion optimization built for event venues."
  ogTitle="Event Venue Marketing & Local SEO | zeisWorks"
  ogDescription="More inquiry form submissions. Local SEO and conversion optimization built for wedding venues, corporate event spaces, and private event venues."
  canonicalUrl="https://zeisworks.com/event-venues/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <nav class="text-sm text-ink-mid mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">Event Venues</li>
        </ol>
      </nav>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Event Venues</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink leading-tight mb-6">
        Fill your calendar.<br class="hidden sm:block" /> From the couples and<br class="hidden sm:block" /> planners already searching.
      </h1>
      <p class="text-ink-mid text-lg leading-relaxed max-w-xl mb-8">
        Weddings, corporate events, private parties — your clients are searching months in advance. I build the local search presence and inquiry conversion systems that make sure your venue is the first result they find and the first one they contact.
      </p>
      <div class="flex flex-wrap gap-3">
        <button type="button" data-modal="gap-analysis" class="bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0">
          Get a free Gap Analysis →
        </button>
        <a href="/local-search-checklist" class="border border-ink-light text-ink-mid text-sm px-5 py-2.5 rounded-lg hover:border-navy hover:text-navy transition-colors font-medium">
          Free Local Search Checklist
        </a>
      </div>
    </div>

    <!-- Outcome strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-y border-cream-dark">
      {[
        { stat: '90 days', label: 'to top-3 Maps placement in competitive markets' },
        { stat: '5.0 ★', label: 'Upwork rating · 100% Job Success Score' },
        { stat: '$0', label: 'to find out if I can help — gap analysis is free' },
        { stat: '1 person', label: 'direct line, no handoffs, no account managers' },
      ].map(({ stat, label }) => (
        <div>
          <div class="font-serif text-2xl font-semibold text-ink mb-1">{stat}</div>
          <div class="text-xs text-ink-mid leading-snug">{label}</div>
        </div>
      ))}
    </div>

    <!-- The problem -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">The problem</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-5">Your clients are searching. The question is whether they find you first.</h2>
      <div class="space-y-4 text-ink-mid leading-relaxed">
        <p>
          A couple gets engaged and immediately starts searching "wedding venues [your city]." A corporate event planner needs a space for 80 people and searches "event venue with AV [your city]." These searches happen every day. The venues that appear at the top of those results fill their calendars. The ones that don't rely entirely on word-of-mouth and paid directory listings.
        </p>
        <p>
          Most event venues have a beautiful website and a neglected Google Business Profile. They're listed on The Knot but haven't updated their photos in two years. Their website has a single "Events" page instead of dedicated pages for weddings, corporate events, and private parties. These are fixable gaps — and fixing them produces results quickly.
        </p>
      </div>
    </section>

    <!-- What's included -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">What's included</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">A complete inquiry generation system for your venue.</h2>
      <div class="space-y-6">
        {[
          {
            title: 'Google Business Profile Optimization',
            body: 'A fully optimized GBP with event-specific categories, updated photos, Q&A, and posts. I ensure your venue appears for the specific searches your ideal clients are making — "wedding venue [city]", "corporate event space [city]", "private dining [city]".',
          },
          {
            title: 'Wedding & Event Directory Citations',
            body: 'The Knot, WeddingWire, Yelp Events, and 30+ other directories are both direct lead sources and high-authority citation signals for Google. I audit, update, and build your presence across all of them.',
          },
          {
            title: 'Event-Type Landing Pages',
            body: 'Each event type deserves its own page: weddings, corporate events, private parties, rehearsal dinners. I build or optimize these pages to rank for the specific searches that drive inquiries for each category.',
          },
          {
            title: 'Inquiry Conversion Optimization',
            body: 'Getting found is step one. Getting the inquiry is step two. I audit your contact forms, inquiry flow, and pricing presentation to remove friction and increase the percentage of visitors who actually reach out.',
          },
          {
            title: 'Review Acquisition System',
            body: 'Reviews from couples and event planners are powerful trust signals for future clients and a local ranking factor. I build a simple system to consistently generate new reviews after each event.',
          },
        ].map(({ title, body }) => (
          <div class="flex gap-4 items-start">
            <span class="mt-2 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <h3 class="font-semibold text-ink mb-1">{title}</h3>
              <p class="text-ink-mid text-sm leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Common questions</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">What event venue owners ask before getting started.</h2>
      <div class="space-y-6">
        {faqItems.map(({ q, a }) => (
          <div class="border-b border-cream-dark pb-6">
            <h3 class="font-semibold text-ink mb-2">{q}</h3>
            <p class="text-ink-mid text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy text-cream rounded-2xl p-10 text-center">
      <h2 class="font-serif text-3xl font-semibold mb-4">See exactly where your venue is losing inquiries to competitors.</h2>
      <p class="text-cream/75 mb-8 max-w-lg mx-auto leading-relaxed">
        The free Gap Analysis shows how your local search presence compares to your top 3–5 competitors — with specific fixes and priorities. No call required. Results in your inbox within 12 hours.
      </p>
      <button type="button" data-modal="gap-analysis" class="inline-block bg-white text-ink font-medium px-8 py-3 rounded-lg hover:bg-cream transition-colors cursor-pointer border-0">
        Get your free Gap Analysis →
      </button>
      <p class="text-cream/50 text-xs mt-4">Free. No call required. No obligation.</p>
    </section>

  </div>
</BaseLayout>
