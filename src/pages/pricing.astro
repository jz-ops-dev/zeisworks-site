---
// Pricing on the current shell, built around the offer ladder — the single
// source of truth for the offer (OfferLadder.astro). The old page taught a
// two-step engagement with a "$2,500–$5,000/month" range that existed
// nowhere else on the site.
import LandingLayout from '../layouts/LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import OfferLadder from '../components/OfferLadder.astro';

const includes = [
  'Your VIK built out and updated as your business changes: a living, queryable system that holds how your company actually runs',
  'Done-for-you work performed with your VIK: research, drafts, and answers, all from knowledge you can read and edit',
  'Every interaction traceable back to the source knowledge it came from',
  'A short report you can read in two minutes',
  'A real person who knows your VIK and is available when you need them',
];

const faq = [
  {
    q: "What if it doesn't work?",
    a: 'Your VIK is something you can open and read from day one, so progress is visible, not promised. If it is not holding up its end, the work changes. And you can cancel anytime, so we have to earn the next month, every month.',
  },
  {
    q: 'Do I own it?',
    a: 'Yes. Your VIK is yours: the knowledge, the system that runs on it, all of it. Cancel anytime and you keep it. You own everything.',
  },
];

const navLinks = [
  { label: 'See it working', href: '/#demo' },
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'Proof', href: '/results/' },
  { label: 'About', href: '/about/' },
];
---

<LandingLayout
  title="Pricing · Month to month, no contracts · ZeisWorks"
  description="Start with a free intro call, then a fixed-price one-week Knowledge Audit, then build-and-run at $2,500 a month, month to month. Cancel any month. Keep every file at every step."
  ogImage="/og.png"
  navLinks={navLinks}
  brandHref="/"
>
  <!-- ═══════════════════ HERO + LADDER ═══════════════════ -->
  <section class="zw-section zw-hero-pad bg-zw-cream border-b border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-measure-wide">
        <p class="zw-eyebrow mb-4 zw-reveal" style="color: var(--zw-rust);">Pricing</p>
        <h1 class="zw-h1 text-zw-ink mb-6 zw-reveal">Start small. Keep everything.</h1>
        <p class="zw-lede mb-8 zw-reveal">
          Three steps, each one optional until you've seen the last. Month to month, no setup
          fees, and everything we write is yours to keep at every step.
        </p>
      </div>
      <div class="mt-6">
        <OfferLadder variant="full" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ WHAT BUILD-AND-RUN INCLUDES ═══════════════════ -->
  <section class="zw-section">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">Step 03, in full</p>
      <h2 class="zw-h2 mb-8 zw-reveal">What build-and-run includes</h2>
      <p class="text-zw-muted mb-12 zw-reveal">
        We write down how your business works in plain, readable files &mdash; the same files the
        AI reads to answer. Your VIK is what you end up owning: a living, queryable system that
        does work from knowledge you can read and edit.
      </p>
      <ul class="space-y-6">
        {includes.map((item) => (
          <li class="zw-reveal flex gap-4">
            <span class="zw-mono text-zw-teal text-sm pt-1 shrink-0" aria-hidden="true">→</span>
            <p class="text-zw-muted">{item}</p>
          </li>
        ))}
      </ul>
    </div></div>
  </section>

  <!-- ═══════════════════ FAQ ═══════════════════ -->
  <section class="zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">Questions</p>
      <h2 class="zw-h2 mb-8 zw-reveal">The two everyone asks.</h2>
      <dl class="space-y-8">
        {faq.map(({ q, a }) => (
          <div class="zw-reveal">
            <dt class="font-semibold text-zw-ink mb-2">{q}</dt>
            <dd class="text-sm text-zw-muted leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div></div>
  </section>

  <!-- ═══════════════════ CTA ═══════════════════ -->
  <section class="zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure mx-auto text-center">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">Get started</p>
      <h2 class="zw-h2 mb-6 text-zw-cream zw-reveal">Start with a free intro call.</h2>
      <p class="text-zw-cream/75 mb-9 zw-reveal">
        Fifteen minutes on where your knowledge is stuck and whether a VIK would fix it. No deck,
        no pitch. If we're not the right fit, we'll tell you on the call.
      </p>
      <AuditCta
        location="footer"
        label="Book a free intro call"
        class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors zw-reveal"
      />
    </div></div>
  </section>
</LandingLayout>
