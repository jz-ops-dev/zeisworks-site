---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import { CALENDLY_URL } from '../config';

const includes = [
  'Your VIK built out and updated as your business changes: a living, queryable system that holds how your company actually runs',
  'Done-for-you work performed with your VIK: research, drafts, and answers, all from knowledge you can read and edit',
  'Every interaction traceable back to the source knowledge it came from',
  'A short report you can read in two minutes',
  'A real person who knows your VIK and is available when you need them',
];

const faq = [
  {
    q: 'Why is there a range?',
    a: "Because the more your business runs on knowledge that only lives in people's heads, the more there is to capture and visualize. A quick intro call sizes the work to your situation and shows the cost before you commit.",
  },
  {
    q: "What if it doesn't work?",
    a: 'Your VIK is something you can open and read from day one, so progress is visible, not promised. If it is not holding up its end, the work changes. And you can cancel anytime, so we have to earn the next month, every month.',
  },
  {
    q: 'Do I own it?',
    a: 'Yes. Your VIK is yours: the knowledge, the system that runs on it, all of it. Cancel anytime and you keep it. You own everything.',
  },
];
---

<BaseLayout
  title="Pricing: Month to Month, No Contracts | ZeisWorks"
  description="Plans start at $2,500/month, sized on a free intro call. You're paying to build and own your VIK: the working system that holds how your business runs. Month to month, cancel anytime."
>
  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-6 pt-16 sm:pt-24 pb-10 text-center">
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-tight tracking-tight mb-6">
      You're paying to build and own your VIK.
    </h1>
    <p class="text-lg text-ink-mid leading-relaxed max-w-2xl mx-auto">
      Every engagement starts with a free intro call. We'll show you the knowledge trapped in people's heads today and what it costs to turn it into a VIK you own, before you pay anything.
    </p>
  </section>

  <!-- Single anchor pricing -->
  <section class="max-w-3xl mx-auto px-6 pb-14">
    <div class="relative bg-navy-deep rounded-2xl p-8 sm:p-10 text-center overflow-hidden">
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 90% 70% at 85% 0%, rgba(224,69,48,0.22) 0%, transparent 65%);"
        aria-hidden="true"
      ></div>
      <div class="relative">
      <p class="font-serif text-3xl sm:text-4xl font-semibold text-white mb-4">
        Plans start at $2,500/month.
      </p>
      <p class="text-white/70 leading-relaxed max-w-xl mx-auto mb-4">
        Most plans land between $2,500 and $5,000/month depending on how much of your business currently runs on knowledge nobody has written down: more to capture and visualize means more to build into your VIK.
      </p>
      <p class="text-white/70 leading-relaxed max-w-xl mx-auto">
        Month to month. Cancel anytime. No setup fees. The VIK is yours: cancel and you keep it.
      </p>
      </div>
    </div>
  </section>

  <!-- What every plan includes -->
  <section class="max-w-3xl mx-auto px-6 pb-14">
    <h2 class="font-serif text-2xl sm:text-3xl font-semibold leading-tight mb-7">
      What every plan includes
    </h2>
    <p class="text-ink-mid leading-relaxed mb-7">
      ICM is the method we use to capture how your business runs. Your VIK is what you end up owning: a living, queryable system that does work from knowledge you can read and edit.
    </p>
    <ul class="space-y-4">
      {includes.map((item) => (
        <li class="flex items-start gap-3 text-ink-mid leading-relaxed">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-navy shrink-0 mt-0.5"
            aria-hidden="true"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Two CTAs side by side -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="text-center">
        <AuditCta
          location="mid"
          class="block w-full bg-orange text-white font-semibold text-base px-6 py-4 rounded-lg hover:bg-orange-bright transition-colors shadow-md shadow-orange/20"
        />
      </div>
      <div class="text-center">
        <a
          href={CALENDLY_URL}
          class="block w-full border border-navy text-navy font-medium text-base px-6 py-4 rounded-lg hover:bg-navy hover:text-cream transition-colors"
        >Talk to a human first</a>
        <p class="mt-2 text-xs text-ink-light">15 minutes, no pitch deck</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white border-t border-cream-dark">
    <div class="max-w-3xl mx-auto px-6 py-16">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold leading-tight mb-8">Questions</h2>
      <dl class="divide-y divide-cream-dark border-y border-cream-dark">
        {faq.map(({ q, a }) => (
          <div class="py-6">
            <dt class="font-semibold text-ink mb-2">{q}</dt>
            <dd class="text-sm text-ink-mid leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
