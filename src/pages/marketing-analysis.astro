---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactModal from '../components/ContactModal.astro';


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing is scoped after the free analysis. You get a specific number, tied to a specific plan, before anything starts. Nothing runs until you approve it."
      }
    },
    {
      "@type": "Question",
      "name": "What's in the free marketing analysis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You get a ranked assessment of what's currently working, what's missing, and what the projected ROI looks like if I fix it. It takes about 5 minutes of your time. No sales call required to get the output."
      }
    },
    {
      "@type": "Question",
      "name": "How is this different from a marketing agency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "One operator, no handoffs, direct accountability. I run the strategy and watch the campaigns. You're not handed off to a team that changes every six months. If something isn't working, you call me."
      }
    },
    {
      "@type": "Question",
      "name": "Do I have to sign a long-term contract?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Short commitment to start, then month-to-month. Nothing begins until you've seen the plan and the price. You're not locked in until you decide you want to be."
      }
    },
    {
      "@type": "Question",
      "name": "What kinds of businesses do you work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Home services, healthcare practices, professional services, trades and contractors. Inbound-lead-driven businesses where consistent marketing actually moves revenue."
      }
    }
  ]
};
---

<BaseLayout
  title="Marketing Done for You"
  description="Your marketing runs. I set it up, I watch it, and I'm the one you call. Full-service marketing execution for small businesses: gap analysis, 12-month plan, done-for-you campaigns, and weekly reporting."
  ogTitle="Marketing Done for You | zeisWorks"
  ogDescription="One operator. Direct accountability. I run the campaigns, track every lead, and send you a plain-English report every Monday."
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Hero -->
    <div>
      <p
        class="text-xs text-orange uppercase tracking-widest mb-3"
        style="font-family: 'DM Mono', monospace;"
      >
        Marketing · Done for you
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink leading-tight">
        Your marketing runs.<br class="hidden sm:block" />
        I set it up, I watch it,<br class="hidden sm:block" />
        I'm the one you call.
      </h1>
      <p class="mt-5 text-ink-mid text-lg leading-relaxed max-w-xl">
        One operator, accountable end to end. No account managers, no handoffs, no team that changes every six months.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <button
          type="button"
          data-modal="gap-analysis"
          class="bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0"
        >
          Free analysis
        </button>
        <button
          type="button"
          data-modal="contact"
          class="border border-navy text-navy text-sm px-5 py-2.5 rounded-lg hover:bg-navy/5 transition-colors font-medium"
        >
          Talk to Jack →
        </button>
      </div>
    </div>

    <!-- Problem -->
    <section>
      <p
        class="text-xs text-ink-light uppercase tracking-widest mb-6"
        style="font-family: 'DM Mono', monospace;"
      >
        The pattern I keep seeing
      </p>
      <ul class="space-y-4">
        {[
          "Your ads are running. You haven't looked at what's converting.",
          "You got a report from the last agency. You got nothing else.",
          "You're getting leads from somewhere. You couldn't say where.",
          "Your Google Business Profile hasn't been touched in eight months.",
          "You tried managing it yourself. It stopped when you got busy.",
          "You're paying for a tool nobody on your team actually uses.",
        ].map(line => (
          <li class="font-serif text-xl text-ink-mid italic leading-snug">{line}</li>
        ))}
      </ul>
    </section>

    <!-- How it works -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">How it works</h2>
      <div class="space-y-4">
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-orange font-medium uppercase tracking-widest mb-2" style="font-family: 'DM Mono', monospace;">01</p>
          <h3 class="font-serif font-semibold text-ink text-lg mb-2">Free gap analysis</h3>
          <p class="text-sm text-ink-mid leading-relaxed mb-4">
            You answer a few questions about your business and your goals. I run an analysis that maps the gap between where your marketing is now and where it needs to be, with projected ROI if I close it. You get the output in writing. No sales call required.
          </p>
          <p class="text-sm text-ink italic leading-relaxed border-l-2 border-orange pl-4">
            An HVAC company in the Denver suburbs had Google Ads running for two years. The analysis showed 80% of their spend was going to keywords that had never produced a booked job.
          </p>
        </div>

        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-orange font-medium uppercase tracking-widest mb-2" style="font-family: 'DM Mono', monospace;">02</p>
          <h3 class="font-serif font-semibold text-ink text-lg mb-2">12-month growth roadmap</h3>
          <p class="text-sm text-ink-mid leading-relaxed">
            From the gap analysis, I build a 12-month plan specific to your business: which channels, which campaigns, which targets, in what order. You review it before anything starts. The plan is a real document with numbers attached, not a slide deck.
          </p>
        </div>

        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-orange font-medium uppercase tracking-widest mb-2" style="font-family: 'DM Mono', monospace;">03</p>
          <h3 class="font-serif font-semibold text-ink text-lg mb-2">Done-for-you execution</h3>
          <p class="text-sm text-ink-mid leading-relaxed">
            I run the campaigns. Every lead gets traced back to its source. Calls are recorded and transcribed. After-hours calls get answered. A plain-English report lands in your inbox every Monday. The system keeps improving without you having to touch it.
          </p>
        </div>
      </div>
    </section>

    <!-- Founder block -->
    <section class="overflow-hidden">
      <img
        src="/jack.jpg"
        alt="Jack Zeis"
        class="rounded-xl w-28 h-36 object-cover float-left mr-6 mb-3"
      />
      <div>
        <h2 class="font-serif text-2xl font-semibold text-ink mb-3">One person. Direct line.</h2>
        <div class="space-y-3 text-ink-mid leading-relaxed">
          <p>
            I'm Jack. I run ZeisWorks. When you work with me, you get my number, not a support ticket system.
          </p>
          <p>
            If a campaign is underperforming, I know before you do. If something changes in your market, I adjust the strategy. If you have a question at 7pm, you text me.
          </p>
          <p>
            This is one person, not a team. That means I know your business from the first conversation to the last report. No new account manager every six months. No context lost in a handoff.
          </p>
        </div>
      </div>
    </section>

    <!-- What's included -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">What's included</h2>
      <ul class="space-y-4">
        {[
          { title: 'A ranked gap analysis', body: 'You see exactly where your marketing stands: what\'s working, what\'s costing you leads, and what fixing it is worth. Free to start.' },
          { title: 'A 12-month growth plan', body: 'Specific channels, specific campaigns, specific revenue targets. Built for your business, reviewed and approved before anything runs.' },
          { title: 'Campaign execution', body: 'Google Ads, Meta, local SEO, Google Business Profile. I run the campaigns and optimize them continuously. You don\'t manage any of it.' },
          { title: 'Lead tracking on every channel', body: 'Every form fill and inbound call traced back to its source. You always know what\'s generating business and what isn\'t.' },
          { title: 'Call recording and coverage', body: 'All inbound calls recorded and transcribed. After-hours calls answered so leads don\'t go to voicemail and disappear.' },
          { title: 'Monday performance reports', body: 'A plain-English weekly report: what happened, where leads came from, what improved. No jargon, no vanity metrics.' },
          { title: 'Continuous optimization', body: 'The campaigns improve over time on their own. I monitor performance and adjust strategy between your weekly reports, not just at the monthly check-in.' },
        ].map(item => (
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <strong class="text-ink font-medium">{item.title}.</strong>{' '}
              <span class="text-ink-mid">{item.body}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Who it's for -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-4">Who I work with</h2>
      <p class="text-ink-mid leading-relaxed mb-4">
        This is the right fit if your business runs on inbound leads and nobody on your team has time to manage marketing consistently. If any of these sound familiar:
      </p>
      <div class="grid sm:grid-cols-2 gap-3 mb-4">
        {[
          "You're generating leads but don't know where they're coming from",
          "Your Google Ads are running but you've never looked at what's converting",
          "You rely on word-of-mouth because you never had time to set up anything else",
          "You tried an agency and got a report, not results",
          "Your marketing stops when you get busy",
          "You're missing calls and losing business after hours",
        ].map(situation => (
          <div class="rounded-lg border border-cream-dark bg-cream p-4 text-sm text-ink-mid">{situation}</div>
        ))}
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        {[
          'Home services (HVAC, plumbing, electrical, roofing)',
          'Healthcare and dental practices',
          'Professional services (law, accounting, insurance)',
          'Real estate and property management',
          'Trades and contractors',
        ].map(sector => (
          <div class="rounded-lg border border-cream-dark bg-cream p-4 text-sm text-ink-mid">{sector}</div>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section class="rounded-xl border border-cream-dark bg-cream-dark p-8">
      <p class="text-xs text-ink-light uppercase tracking-widest mb-3" style="font-family: 'DM Mono', monospace;">Pricing</p>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-3">Flat monthly. No hourly rate.</h2>
      <p class="text-sm text-ink-mid italic mb-6">Pricing is scoped to your business after the free analysis. You see the number before anything starts.</p>
      <ul class="space-y-4 mb-8">
        {[
          { label: 'Approved before anything starts', body: 'You see the plan and the price before I do anything. Nothing begins until you say so.' },
          { label: 'Face-to-face time is always free', body: 'No pitch, no clock running. Any call or conversation before you commit costs nothing.' },
          { label: 'Start with the free analysis', body: 'The gap analysis is free and gives you the plan with a price attached. You decide what happens next.' },
        ].map(item => (
          <li class="flex gap-4 items-start">
            <span class="mt-1 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <strong class="text-ink font-medium">{item.label}.</strong>{' '}
              <span class="text-ink-mid text-sm">{item.body}</span>
            </div>
          </li>
        ))}
      </ul>
      <button
        type="button"
        data-modal="gap-analysis"
        class="inline-block bg-navy text-cream text-sm px-5 py-2.5 rounded-lg font-medium hover:bg-navy/90 transition-colors cursor-pointer border-0"
      >
        Free analysis
      </button>
    </section>

    <!-- Author bio -->
    <section class="border-t border-cream-dark pt-10">
      <p class="text-xs text-ink-light uppercase tracking-widest mb-3" style="font-family: 'DM Mono', monospace;">About</p>
      <h3 class="font-serif text-xl font-semibold text-ink mb-3">Jack Zeis</h3>
      <p class="text-sm text-ink-mid leading-relaxed mb-4 max-w-xl">
        Jack runs <strong class="text-ink font-medium">ZeisWorks</strong>, a modern growth practice for independent service businesses. Based in Golden, Colorado.
      </p>
      <div class="flex flex-wrap gap-4 text-sm">
        <a
          href="https://zeisworks.com"
          class="text-navy hover:underline font-medium"
        >
          zeisworks.com →
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <p class="text-xs text-ink-light uppercase tracking-widest mb-3" style="font-family: 'DM Mono', monospace;">Common questions</p>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-8">Before you get started.</h2>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-7">
        {[
          {
            q: 'How much does it cost?',
            a: 'Pricing is scoped after the free analysis. You get a specific number, tied to a specific plan, before anything starts. Nothing runs until you approve it.',
          },
          {
            q: "What's in the free marketing analysis?",
            a: "You get a ranked assessment of what's currently working, what's missing, and what the projected ROI looks like. It takes about 5 minutes of your time. No sales call required to get the output.",
          },
          {
            q: 'How is this different from a marketing agency?',
            a: "One operator, no handoffs, direct accountability. I run the strategy and watch the campaigns. You're not handed off to a team that changes every six months. If something isn't working, you call me.",
          },
          {
            q: 'Do I have to sign a long-term contract?',
            a: "Short commitment to start, then month-to-month. Nothing begins until you've seen the plan and the price. You're not locked in until you decide you want to be.",
          },
          {
            q: 'What kinds of businesses do you work with?',
            a: 'Home services, healthcare practices, professional services, trades and contractors. Inbound-lead-driven businesses where consistent marketing actually moves revenue.',
          },
        ].map(item => (
          <div>
            <p class="font-medium text-ink text-sm mb-1">{item.q}</p>
            <p class="text-sm text-ink-mid leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Back nav -->
    <p class="text-sm text-ink-light">
      <a href="/marketing" class="hover:text-ink transition-colors">← Marketing</a>
      &nbsp;·&nbsp;
      <a href="/" class="hover:text-ink transition-colors">Back to home →</a>
    </p>

  </div>

  <!-- Contact modal -->
  <ContactModal />

  <!-- Netlify form detection (hidden, for build-time scraping) -->
  <form name="contact" netlify netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="text" name="business" />
    <select name="interest"><option value=""></option></select>
    <textarea name="message"></textarea>
  </form>

</BaseLayout>
