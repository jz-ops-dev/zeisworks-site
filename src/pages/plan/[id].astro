---
import { plans } from '../../data/plans';

export function getStaticPaths() {
  return Object.keys(plans).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const planUrl = plans[id];
---

<!doctype html>
<html lang="en" style="margin:0;padding:0;height:100%;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Your Plan | zeisWorks.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@600&family=DM+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: #F7F4EF;
        font-family: 'DM Sans', sans-serif;
      }
      .plan-header {
        height: 52px;
        min-height: 52px;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        border-bottom: 1px solid #E8E3D8;
        background: #F7F4EF;
      }
      .plan-header a {
        font-family: 'Lora', serif;
        font-weight: 600;
        font-size: 1.1rem;
        color: #1A1714;
        text-decoration: none;
      }
      .plan-header a span { color: #E8602C; }
      .plan-frame {
        flex: 1;
        width: 100%;
        border: none;
        display: block;
      }
    </style>
  </head>
  <body>
    <header class="plan-header">
      <a href="/">zeisWorks<span>.</span></a>
    </header>
    <iframe
      class="plan-frame"
      src={planUrl}
      title="Your marketing plan"
      allow="fullscreen"
    ></iframe>
  </body>
</html>
