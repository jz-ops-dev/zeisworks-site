---
import { plans } from '../../data/plans';

export function getStaticPaths() {
  return Object.keys(plans).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const planUrl = plans[id];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Your Plan | zeisWorks.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #F7F4EF;
        font-family: 'DM Sans', sans-serif;
        color: #1A1714;
        -webkit-font-smoothing: antialiased;
      }
      .plan-header {
        height: 56px;
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        border-bottom: 1px solid #E8E3D8;
        background: rgba(247, 244, 239, 0.95);
        backdrop-filter: blur(4px);
      }
      .plan-header a {
        font-family: 'Lora', serif;
        font-weight: 600;
        font-size: 1.125rem;
        color: #1A1714;
        text-decoration: none;
      }
      .plan-header a span { color: #E8602C; }
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
      }
      .card {
        background: #fff;
        border: 1px solid #E8E3D8;
        border-radius: 16px;
        padding: 3rem 2.5rem;
        max-width: 420px;
        width: 100%;
        text-align: center;
        box-shadow: 0 2px 16px rgba(26,23,20,0.06);
      }
      .icon {
        width: 52px;
        height: 52px;
        background: #FBF1EC;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
      }
      h1 {
        font-family: 'Lora', serif;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.3;
        margin: 0 0 0.75rem;
        color: #1A1714;
      }
      p {
        font-size: 0.9375rem;
        color: #6B6460;
        line-height: 1.6;
        margin: 0 0 2rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #1B2B4B;
        color: #F7F4EF;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        padding: 0.8rem 1.75rem;
        border-radius: 10px;
        transition: background 0.2s;
      }
      .btn:hover { background: rgba(27,43,75,0.88); }
    </style>
  </head>
  <body>
    <header class="plan-header">
      <a href="/">zeisWorks<span>.</span></a>
    </header>
    <main>
      <div class="card">
        <div class="icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8602C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <h1>Your marketing plan is ready.</h1>
        <p>Click below to open your plan. It'll open in a new tab.</p>
        <a href={planUrl} target="_blank" rel="noopener noreferrer" class="btn">
          Open your plan
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </main>
  </body>
</html>
