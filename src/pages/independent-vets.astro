---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How can an independent vet clinic outrank Banfield and VCA in local search?",
    a: "Corporate chains have brand authority, but they often have generic, templated Google Business Profiles and inconsistent local signals. Independent clinics can outrank them by having a more complete GBP with more recent reviews, stronger local citation consistency, and service pages that answer the specific questions pet owners in their area are searching. Local wins on specificity.",
  },
  {
    q: "What are the most important local SEO factors for a vet clinic?",
    a: "Google Business Profile completeness and review velocity are the top two. After that: consistent NAP data across veterinary directories (Yelp, Angi, Vetstreet, local directories), on-page optimization for specific services (emergency vet, exotic animals, dental cleanings), and proximity signals. A fully optimized GBP with 50+ recent reviews will outrank a corporate chain with a neglected profile in most markets.",
  },
  {
    q: "How do I get more Google reviews for my vet clinic?",
    a: "Ask immediately after a positive interaction — when a client is checking out after a successful visit or wellness exam. A text message with a direct Google review link sent within 2 hours of the appointment converts at 3–5x the rate of a follow-up email. For emotional situations (illness, end-of-life care), wait for a follow-up touchpoint. Never incentivize reviews.",
  },
  {
    q: "Should a vet clinic have separate pages for each service?",
    a: "Yes. A dedicated page for 'emergency vet care,' 'dental cleaning for dogs,' 'exotic animal vet,' or 'senior pet wellness' allows each page to rank for its own set of searches. A single 'Services' page competes for all of these terms simultaneously and typically ranks for none of them well. Individual service pages are one of the highest-ROI SEO investments for vet clinics.",
  },
  {
    q: "What does a Marketing Gap Analysis include for a vet clinic?",
    a: "The analysis covers your Google Business Profile completeness, local search rankings for your core services benchmarked against your top 3–5 competitors (including corporate chains), citation consistency across veterinary directories, review velocity and rating, and a prioritized list of specific fixes with estimated impact.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Veterinary Clinic Marketing & Local SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'ZeisWorks',
    url: 'https://zeisworks.com',
  },
  description: 'Local SEO and Google Business Profile optimization for independent veterinary clinics competing against corporate chains.',
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: 'Marketing Consulting',
};
---

<BaseLayout
  title="Veterinary Clinic Marketing & Local SEO"
  description="Help your independent vet clinic outrank Banfield and VCA in local search. Local SEO, GBP optimization, and review systems built for independent veterinary practices."
  ogTitle="Vet Clinic Marketing & Local SEO | zeisWorks"
  ogDescription="Outrank the corporate chains in your area. Local SEO and Google Business Profile optimization built for independent vet clinics."
  canonicalUrl="https://zeisworks.com/independent-vets/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <nav class="text-sm text-ink-mid mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">Independent Vet Clinics</li>
        </ol>
      </nav>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Independent Vet Clinics</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink leading-tight mb-6">
        Outrank the chains.<br class="hidden sm:block" /> Win on local search.
      </h1>
      <p class="text-ink-mid text-lg leading-relaxed max-w-xl mb-8">
        Banfield and VCA have brand budgets. You have something they don't: genuine local roots, a real relationship with your clients, and the ability to move faster. I build the local search presence that levels the playing field — and tips it in your favor.
      </p>
      <div class="flex flex-wrap gap-3">
        <button type="button" data-modal="gap-analysis" class="bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0">
          Get a free Gap Analysis →
        </button>
        <a href="/guides/local-seo-for-independent-vet-clinics/" class="border border-ink-light text-ink-mid text-sm px-5 py-2.5 rounded-lg hover:border-navy hover:text-navy transition-colors font-medium">
          Read: Local SEO for Vet Clinics
        </a>
      </div>
    </div>

    <!-- Outcome strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-y border-cream-dark">
      {[
        { stat: '90 days', label: 'to top-3 Maps placement in competitive markets' },
        { stat: '5.0 ★', label: 'Upwork rating · 100% Job Success Score' },
        { stat: '$0', label: 'to find out if I can help — gap analysis is free' },
        { stat: '1 person', label: 'direct line, no handoffs, no account managers' },
      ].map(({ stat, label }) => (
        <div>
          <div class="font-serif text-2xl font-semibold text-ink mb-1">{stat}</div>
          <div class="text-xs text-ink-mid leading-snug">{label}</div>
        </div>
      ))}
    </div>

    <!-- The problem -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">The problem</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-5">Corporate chains win on brand. You can win on local.</h2>
      <div class="space-y-4 text-ink-mid leading-relaxed">
        <p>
          When a new pet owner moves to your area and searches "vet near me," they see a list. Banfield has a polished brand and a national marketing budget. But their local Google Business Profiles are often templated, their reviews are inconsistent, and their local SEO signals are weaker than you'd expect.
        </p>
        <p>
          Independent clinics that invest in their local search presence — a complete GBP, a steady stream of genuine reviews, consistent directory listings, and service pages that answer the questions pet owners are actually searching — regularly outrank corporate chains in their local markets.
        </p>
        <p>
          The gap between where you are and where you could be is almost always a systems gap, not a quality gap.
        </p>
      </div>
    </section>

    <!-- What's included -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">What's included</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">Everything your clinic needs to dominate local search.</h2>
      <div class="space-y-6">
        {[
          {
            title: 'Google Business Profile Optimization',
            body: 'A fully optimized GBP is the highest-leverage action for local visibility. I audit and rebuild your profile — service categories, photos, Q&A, posts, and the specific attributes that influence your Maps ranking for searches like "emergency vet near me" and "vet clinic [your city]."',
          },
          {
            title: 'Review Acquisition System',
            body: 'Review velocity is a top-3 local ranking signal. I build a simple system that asks clients for a review at the right moment and routes them directly to your Google profile. The goal is 3–5 new reviews per month, consistently.',
          },
          {
            title: 'Veterinary Directory Citations',
            body: 'Consistent NAP data across Yelp, Vetstreet, Angi, and 40+ other directories signals legitimacy to Google. I audit, fix, and build the citations your competitors already have.',
          },
          {
            title: 'Service-Specific Landing Pages',
            body: 'Emergency care, exotic animals, dental cleanings, senior wellness — each service deserves its own page optimized for the specific searches that drive those appointments. I build or optimize these pages to rank for high-intent local searches.',
          },
          {
            title: 'Lapsed Client Reactivation',
            body: 'Your existing client base is your most underutilized asset. I build a simple reactivation sequence that brings back clients who haven\'t visited in 6+ months — without discounting or aggressive outreach.',
          },
        ].map(({ title, body }) => (
          <div class="flex gap-4 items-start">
            <span class="mt-2 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <h3 class="font-semibold text-ink mb-1">{title}</h3>
              <p class="text-ink-mid text-sm leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related guides -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Related guides</p>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">Free resources for vet clinic owners.</h2>
      <div class="grid sm:grid-cols-1 gap-4">
        <a href="/guides/local-seo-for-independent-vet-clinics/" class="block p-5 bg-cream-dark rounded-xl hover:bg-cream border border-transparent hover:border-cream-dark transition-all">
          <p class="text-xs font-semibold uppercase tracking-widest text-ink-light mb-2">Guide</p>
          <h3 class="font-serif font-semibold text-ink leading-snug">Local SEO for Independent Vet Clinics</h3>
          <p class="text-ink-mid text-sm mt-2">How to optimize your GBP, build a review engine, and outrank corporate chains in your local market.</p>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Common questions</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">What vet clinic owners ask before getting started.</h2>
      <div class="space-y-6">
        {faqItems.map(({ q, a }) => (
          <div class="border-b border-cream-dark pb-6">
            <h3 class="font-semibold text-ink mb-2">{q}</h3>
            <p class="text-ink-mid text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy text-cream rounded-2xl p-10 text-center">
      <h2 class="font-serif text-3xl font-semibold mb-4">See exactly where the chains are outranking you — and how to close the gap.</h2>
      <p class="text-cream/75 mb-8 max-w-lg mx-auto leading-relaxed">
        The free Gap Analysis shows how your local search presence compares to your top 3–5 competitors — with specific fixes and priorities. No call required. Results in your inbox within 12 hours.
      </p>
      <button type="button" data-modal="gap-analysis" class="inline-block bg-white text-ink font-medium px-8 py-3 rounded-lg hover:bg-cream transition-colors cursor-pointer border-0">
        Get your free Gap Analysis →
      </button>
      <p class="text-cream/50 text-xs mt-4">Free. No call required. No obligation.</p>
    </section>

  </div>
</BaseLayout>
