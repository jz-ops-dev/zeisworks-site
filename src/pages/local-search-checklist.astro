---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free: Local Search Visibility Checklist | zeisWorks"
  description="25 things every local service business should have locked down to rank in Google Maps and the local 3-pack. Enter your email and I'll send it directly to your inbox."
  ogTitle="Free Local Search Checklist | zeisWorks"
  ogDescription="25 things every local service business should have locked down to rank in Google Maps. Enter your email and get it instantly."
>

<style>
  .cl-hero {
    background: var(--forest);
    padding: 5rem 2rem 4rem;
    text-align: center;
  }
  .cl-hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .cl-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 1.25rem;
  }
  .cl-h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .cl-h1 em { font-style: italic; color: var(--terra-light, #e8a87c); }
  .cl-subhead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .cl-download-box {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 480px;
    margin: 0 auto;
  }
  .cl-download-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1rem;
  }
  .cl-download-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .cl-download-desc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .cl-btn-download {
    display: inline-block;
    background: var(--terra);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    width: 100%;
    text-align: center;
  }
  .cl-btn-download:hover { background: var(--terra-dark, #c0622a); transform: translateY(-1px); }
  .cl-note {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    margin-top: 0.875rem;
  }
  .cl-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .cl-form input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    outline: none;
    box-sizing: border-box;
  }
  .cl-form input::placeholder { color: rgba(255,255,255,0.4); }
  .cl-form input:focus { border-color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.12); }
  .cl-form button {
    width: 100%;
    background: var(--terra);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  .cl-form button:hover { background: var(--terra-dark, #c0622a); transform: translateY(-1px); }

  /* Preview section */
  .cl-preview {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }
  .cl-section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .cl-section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1rem;
  }
  .cl-section-body {
    color: var(--ink-mid);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .cl-sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .cl-section-card {
    background: var(--cream-dark);
    border: 1px solid #E8E3D8;
    border-radius: 0.875rem;
    padding: 1.5rem;
  }
  .cl-section-card-num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.5rem;
  }
  .cl-section-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.375rem;
  }
  .cl-section-card p {
    font-size: 0.85rem;
    color: var(--ink-mid);
    line-height: 1.6;
  }

  /* Bottom CTA */
  .cl-bottom-cta {
    background: var(--cream-dark);
    border-top: 1px solid #E8E3D8;
    padding: 4rem 2rem;
    text-align: center;
  }
  .cl-bottom-inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .cl-bottom-cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.875rem;
  }
  .cl-bottom-cta p {
    color: var(--ink-mid);
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }
  .cl-btn-analysis {
    display: inline-block;
    background: var(--terra);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .cl-btn-analysis:hover { background: var(--terra-dark, #c0622a); transform: translateY(-1px); }
  .cl-bottom-note {
    font-size: 0.8rem;
    color: var(--ink-light);
    margin-top: 1rem;
  }
</style>

<!-- Hero -->
<section class="cl-hero">
  <div class="cl-hero-inner">
    <p class="cl-eyebrow">Free resource · Delivered to your inbox</p>
    <h1 class="cl-h1">The Local Search<br><em>Visibility Checklist</em></h1>
    <p class="cl-subhead">
      25 things every local service business should have locked down to rank in Google Maps and the local 3-pack. Most businesses are missing at least 8 of them.
    </p>

    <div class="cl-download-box">
      <p class="cl-download-label">Free PDF — sent to your inbox</p>
      <p class="cl-download-title">Local Search Visibility Checklist</p>
      <p class="cl-download-desc">25-point checklist covering GBP, reviews, citations, website basics, and competitive positioning. Enter your email and I'll send it directly.</p>
      <form
        name="checklist-download"
        method="POST"
        action="/local-search-checklist/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="cl-form"
      >
        <input type="hidden" name="form-name" value="checklist-download" />
        <input type="hidden" name="bot-field" />
        <input type="text" name="name" placeholder="Your first name" required />
        <input type="email" name="email" placeholder="Your email address" required />
        <button type="submit">Send me the checklist →</button>
      </form>
      <p class="cl-note">No spam. Unsubscribe any time.</p>
    </div>
  </div>
</section>

<!-- What's inside -->
<section class="cl-preview">
  <p class="cl-section-label">What's inside</p>
  <h2 class="cl-section-title">5 sections. 25 checkpoints.</h2>
  <p class="cl-section-body">
    The checklist covers every major factor that determines whether you show up in local search — or your competitor does. Work through it in 20 minutes and you'll know exactly where your gaps are.
  </p>

  <div class="cl-sections-grid">
    {[
      { num: '01', title: 'Google Business Profile', desc: '10 checkpoints covering every field Google uses to rank your listing — categories, description, photos, services, and more.' },
      { num: '02', title: 'Reviews', desc: '5 checkpoints for review volume, rating, response rate, and the system that keeps reviews coming in consistently.' },
      { num: '03', title: 'Citation Consistency', desc: '4 checkpoints for NAP consistency across directories — the silent ranking killer most businesses never fix.' },
      { num: '04', title: 'Website Basics', desc: '5 checkpoints for the on-page signals Google uses to verify your location and service relevance.' },
      { num: '05', title: 'Competitive Positioning', desc: '4 checkpoints for understanding where you stand relative to the competitors showing up above you.' },
    ].map(s => (
      <div class="cl-section-card">
        <p class="cl-section-card-num">Section {s.num}</p>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>

  <div style="text-align:center;">
    <a href="#top" class="cl-btn-analysis" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">
      Get the checklist →
    </a>
    <p style="font-size:0.8rem;color:var(--ink-light);margin-top:0.75rem;">Enter your email above and I'll send it directly.</p>
  </div>
</section>

<!-- Bottom CTA -->
<section class="cl-bottom-cta">
  <div class="cl-bottom-inner">
    <h2>Want to know how your business actually scores?</h2>
    <p>
      The checklist tells you what to look for. The free gap analysis tells you exactly where you stand — with a written report showing your rankings, GBP gaps, citation issues, and how you compare to your top competitors. Delivered within 12 hours.
    </p>
    <button type="button" data-modal="gap-analysis" class="cl-btn-analysis cursor-pointer border-0">Get in touch →</button>
    <p class="cl-bottom-note">Free · No call required · Results in 12 hours</p>
  </div>
</section>

</BaseLayout>
