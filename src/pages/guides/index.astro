---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const clusters = [
  {
    id: 'med-spa',
    label: 'Med Spas & Aesthetics',
    title: 'Med Spa Growth',
    description: 'Membership programs, filling injector slots, and the local SEO that brings high-value clients through your door.',
    pillarUrl: '/med-spas/',
    pillarLabel: 'Med Spa Marketing Overview →',
    slugs: [
      'tiered-med-spa-membership-program-monthly-recurring-revenue',
      'how-to-fill-injector-slots-without-discounting',
    ],
  },
  {
    id: 'home-services',
    label: 'Home Services',
    title: 'Home Services Growth',
    description: 'Lead nurturing and the systems that keep your schedule full without chasing every inquiry.',
    pillarUrl: '/home-services/',
    pillarLabel: 'Home Services Marketing Overview →',
    slugs: [
      'lead-nurturing-for-home-remodelers',
    ],
  },
  {
    id: 'vet-clinics',
    label: 'Independent Vet Clinics',
    title: 'Vet Clinic Growth',
    description: 'Outrank the corporate chains, build a review engine, and reactivate lapsed clients.',
    pillarUrl: '/independent-vets/',
    pillarLabel: 'Vet Clinic Marketing Overview →',
    slugs: [
      'local-seo-for-independent-vet-clinics',
    ],
  },
];

const clusteredSlugs = clusters.flatMap(c => c.slugs);
const unclusteredGuides = sortedGuides.filter(g => !clusteredSlugs.includes(g.id));
---

<BaseLayout
  title="Guides"
  description="Plain-English breakdowns of what's actually working in small business marketing, operations, and growth. Written from real experience, not agency talking points."
  ogTitle="Guides | zeisWorks"
  ogDescription="Free guides on local SEO, lead generation, and growth systems for service businesses. Written by someone who actually does the work."
  canonicalUrl="https://zeisworks.com/guides/"
>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-light mb-4">
        Guides
      </p>
      <h1 class="font-serif text-3xl font-semibold text-ink mb-3 leading-snug">
        Plain-English breakdowns of what's actually working.
      </h1>
      <p class="text-ink-mid leading-relaxed max-w-xl text-sm">
        No agency talking points. No theory. These are the tactics and systems that move the needle for real service businesses — written from direct experience.
      </p>
    </header>

    <!-- Content Clusters -->
    <div class="space-y-16 mb-16">
      {clusters.map((cluster) => {
        const clusterGuides = sortedGuides.filter(g => cluster.slugs.includes(g.id));
        if (clusterGuides.length === 0) return null;
        return (
          <section>
            <div class="flex items-start justify-between mb-6 pb-3 border-b border-cream-dark gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-1">{cluster.label}</p>
                <h2 class="font-serif text-xl font-semibold text-ink">{cluster.title}</h2>
                <p class="text-ink-mid text-sm mt-1 max-w-md">{cluster.description}</p>
              </div>
              <a href={cluster.pillarUrl} class="hidden sm:block text-xs font-medium text-navy hover:underline shrink-0">
                {cluster.pillarLabel}
              </a>
            </div>
            <div class="divide-y divide-cream-dark">
              {clusterGuides.map((guide) => (
                <div class="py-7 first:pt-0">
                  <GuideCard
                    title={guide.data.title}
                    description={guide.data.description}
                    publishDate={guide.data.publishDate}
                    readingTime={guide.data.readingTime}
                    slug={guide.id}
                  />
                </div>
              ))}
            </div>
            <a href={cluster.pillarUrl} class="sm:hidden mt-4 inline-block text-xs font-medium text-navy hover:underline">
              {cluster.pillarLabel}
            </a>
          </section>
        );
      })}
    </div>

    <!-- Unclustered guides -->
    {unclusteredGuides.length > 0 && (
      <section class="mb-16">
        <div class="mb-6 pb-3 border-b border-cream-dark">
          <h2 class="font-serif text-xl font-semibold text-ink">More Guides</h2>
        </div>
        <div class="divide-y divide-cream-dark">
          {unclusteredGuides.map((guide) => (
            <div class="py-7 first:pt-0">
              <GuideCard
                title={guide.data.title}
                description={guide.data.description}
                publishDate={guide.data.publishDate}
                readingTime={guide.data.readingTime}
                slug={guide.id}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <div class="mt-4 p-8 bg-cream-dark rounded-2xl text-center">
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Free Analysis</p>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-4">Want to know exactly what's holding your business back?</h2>
      <p class="text-ink-mid text-sm leading-relaxed max-w-lg mx-auto mb-6">
        The free Marketing Gap Analysis shows how your local search presence compares to your top competitors — with specific fixes and priorities. No call required.
      </p>
      <button type="button" data-modal="gap-analysis" class="inline-block bg-navy text-cream text-sm font-medium px-6 py-3 rounded-lg hover:bg-navy/90 transition-colors cursor-pointer border-0">
        Get your free Gap Analysis →
      </button>
    </div>

  </div>
</BaseLayout>
