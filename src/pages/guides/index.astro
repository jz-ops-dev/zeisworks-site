---
import { getCollection } from 'astro:content';
import AuditCta from '../../components/AuditCta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const clusters = [
  {
    id: 'marketing',
    label: 'Marketing & Growth',
    title: 'Get Found by the Right Customers',
    description: 'Local SEO, lead generation, and the marketing systems that fill your calendar, without agency retainers or discounting your way to empty chairs.',
    slugs: [
      'google-seo-changes-2025-2026-small-business-guide',
      'tiered-med-spa-membership-program-monthly-recurring-revenue',
      'how-to-fill-injector-slots-without-discounting',
      'lead-nurturing-for-home-remodelers',
      'local-seo-for-independent-vet-clinics',
    ],
  },
];

const clusteredSlugs = clusters.flatMap(c => c.slugs);
const unclusteredGuides = sortedGuides.filter(g => !clusteredSlugs.includes(g.id));
---

<BaseLayout
  title="Guides | ZeisWorks"
  description="Free guides on local SEO, lead generation, operations, and growth systems for service businesses. Written by someone who actually does the work."
  ogTitle="Guides | ZeisWorks"
  ogDescription="Free guides on local SEO, lead generation, operations, and growth systems for service businesses. Written by someone who actually does the work."
  canonicalUrl="https://zeisworks.com/guides/"
>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-light mb-4">
        Guides
      </p>
      <h1 class="font-serif text-3xl font-semibold text-ink mb-3 leading-snug">
        What's actually working for service businesses right now.
      </h1>
      <p class="text-ink-mid leading-relaxed max-w-xl text-sm">
        No agency playbooks. No theory. These are the tactics and systems we use with real clients: local SEO, lead nurturing, operations, and the systems that make growth repeatable.
      </p>
    </header>

    <!-- Content Clusters -->
    <div class="space-y-16 mb-16">
      {clusters.map((cluster) => {
        const clusterGuides = sortedGuides.filter(g => cluster.slugs.includes(g.id));
        if (clusterGuides.length === 0) return null;
        return (
          <section>
            <div class="flex items-start justify-between mb-6 pb-3 border-b border-cream-dark gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-1">{cluster.label}</p>
                <h2 class="font-serif text-xl font-semibold text-ink">{cluster.title}</h2>
                <p class="text-ink-mid text-sm mt-1 max-w-md">{cluster.description}</p>
              </div>
            </div>
            <div class="divide-y divide-cream-dark">
              {clusterGuides.map((guide) => (
                <div class="py-7 first:pt-0">
                  <GuideCard
                    title={guide.data.title}
                    description={guide.data.description}
                    publishDate={guide.data.publishDate}
                    readingTime={guide.data.readingTime}
                    slug={guide.id}
                  />
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <!-- Unclustered guides -->
    {unclusteredGuides.length > 0 && (
      <section class="mb-16">
        <div class="mb-6 pb-3 border-b border-cream-dark">
          <h2 class="font-serif text-xl font-semibold text-ink">More Guides</h2>
        </div>
        <div class="divide-y divide-cream-dark">
          {unclusteredGuides.map((guide) => (
            <div class="py-7 first:pt-0">
              <GuideCard
                title={guide.data.title}
                description={guide.data.description}
                publishDate={guide.data.publishDate}
                readingTime={guide.data.readingTime}
                slug={guide.id}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <div class="mt-4 p-8 bg-cream-dark rounded-2xl text-center">
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Free Revenue Audit</p>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-4">Want to know exactly what's holding your business back?</h2>
      <p class="text-ink-mid text-sm leading-relaxed max-w-lg mx-auto mb-6">
        Run the free 5-minute revenue audit. You get a gap analysis of your marketing and a 12-month plan to fix it. No call required. No contracts.
      </p>
      <AuditCta
        location="footer"
        class="inline-block bg-orange text-white text-sm font-semibold px-6 py-3 rounded-lg hover:bg-orange-bright transition-colors"
      />
    </div>

  </div>
</BaseLayout>
