---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Guides"
  description="Plain-English breakdowns of what's actually working in small business marketing, operations, and growth. Written from real experience, not agency talking points."
  canonicalUrl="https://zeisworks.com/guides/"
>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-light mb-4">
        Guides
      </p>
      <h1 class="font-serif text-3xl font-semibold text-ink mb-3 leading-snug">
        Plain-English breakdowns of what's actually working.
      </h1>
      <p class="text-ink-mid leading-relaxed max-w-xl text-sm">
        Small business marketing, operations, and growth — written from real experience, not agency talking points.
      </p>
    </header>

    {
      sortedGuides.length === 0 ? (
        <div class="space-y-4">
          <p class="text-ink-mid leading-relaxed">
            More coming soon. In the meantime, the free analysis is a good place to start.
          </p>
          <a href="/#contact" class="inline-block bg-navy text-cream text-sm px-5 py-2.5 rounded-lg font-medium hover:bg-navy/90 transition-colors">
            Free analysis →
          </a>
        </div>
      ) : (
        <div class="divide-y divide-cream-dark">
          {sortedGuides.map((guide) => (
            <div class="py-7 first:pt-0">
              <GuideCard
                title={guide.data.title}
                description={guide.data.description}
                publishDate={guide.data.publishDate}
                readingTime={guide.data.readingTime}
                slug={guide.id}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
