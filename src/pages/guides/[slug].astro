---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

type Props = {
  guide: CollectionEntry<'guides'>;
};

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<ArticleLayout
  title={guide.data.title}
  description={guide.data.description}
  publishDate={guide.data.publishDate}
  updatedDate={guide.data.updatedDate}
  readingTime={guide.data.readingTime}
  ogImage={guide.data.ogImage}
  faq={guide.data.faq}
  slug={guide.id}
>
  <Content />
</ArticleLayout>
