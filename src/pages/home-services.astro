---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How do I get my HVAC or plumbing company into the Google Maps 3-pack?",
    a: "The three highest-leverage actions are: (1) fully completing your Google Business Profile with all service categories and photos; (2) building consistent citations across home service directories like Angi, HomeAdvisor, Thumbtack, and the BBB; and (3) generating a steady stream of recent reviews. Most home service companies see meaningful ranking improvements within 60–90 days of addressing all three.",
  },
  {
    q: "What's the difference between Google Local Services Ads and regular Google Ads for home services?",
    a: "Google Local Services Ads (LSAs) appear above regular search ads and show a 'Google Guaranteed' badge. They charge per lead rather than per click, and they require a background check and license verification. Regular Google Ads give you more control over targeting and messaging. For most home service businesses, LSAs are the highest-ROI paid channel for emergency and high-intent searches.",
  },
  {
    q: "How many reviews does a home service company need to rank in the local pack?",
    a: "In most markets, 30–80 reviews with a 4.5+ rating and recent review velocity (at least 2–3 new reviews per month) is sufficient to compete for top-3 placement. The key metric is recency — 10 reviews from the last 90 days outweigh 100 reviews from 3 years ago in Google's algorithm.",
  },
  {
    q: "Should a home service company have separate pages for each service?",
    a: "Yes. A dedicated page for 'HVAC repair [city]', 'AC installation [city]', 'furnace replacement [city]', and 'emergency plumber [city]' allows each page to rank for its own set of high-intent searches. A single 'Services' page competes for all of these simultaneously and typically ranks for none of them well.",
  },
  {
    q: "What does a Marketing Gap Analysis include for a home service business?",
    a: "The analysis covers your Google Business Profile completeness, local search rankings for your core services benchmarked against your top 3–5 competitors, citation consistency across home service directories, review velocity and rating, and a prioritized list of specific fixes. Most businesses have 3–5 quick wins they can act on immediately.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Home Services Marketing & Local SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'ZeisWorks',
    url: 'https://zeisworks.com',
  },
  description: 'Local SEO, Google Business Profile optimization, and lead generation systems for HVAC, plumbing, landscaping, and home service businesses.',
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: 'Marketing Consulting',
};
---

<BaseLayout
  title="Home Services Marketing & Local SEO"
  description="Get your HVAC, plumbing, or home service business into the Google Maps 3-pack and drive more inbound calls. Local SEO and lead generation systems built for home service companies."
  ogTitle="Home Services Marketing & Local SEO | zeisWorks"
  ogDescription="More calls from Google Maps. Local SEO and lead generation built for HVAC, plumbing, landscaping, and home service businesses."
  canonicalUrl="https://zeisworks.com/home-services/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <nav class="text-sm text-ink-mid mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">Home Services</li>
        </ol>
      </nav>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Home Services</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink leading-tight mb-6">
        More calls.<br class="hidden sm:block" /> More trucks moving.<br class="hidden sm:block" /> Less slow season.
      </h1>
      <p class="text-ink-mid text-lg leading-relaxed max-w-xl mb-8">
        When someone's AC goes out or a pipe bursts, they search Google and call the first result they trust. I build the local search presence that puts your business there — and the lead systems that convert that traffic into booked jobs.
      </p>
      <div class="flex flex-wrap gap-3">
        <button type="button" data-modal="gap-analysis" class="bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium cursor-pointer border-0">
          Get a free Gap Analysis →
        </button>
        <a href="/local-search-checklist" class="border border-ink-light text-ink-mid text-sm px-5 py-2.5 rounded-lg hover:border-navy hover:text-navy transition-colors font-medium">
          Free Local Search Checklist
        </a>
      </div>
    </div>

    <!-- Outcome strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-y border-cream-dark">
      {[
        { stat: '90 days', label: 'to top-3 Maps placement in competitive markets' },
        { stat: '5.0 ★', label: 'Upwork rating · 100% Job Success Score' },
        { stat: '$0', label: 'to find out if I can help — gap analysis is free' },
        { stat: '1 person', label: 'direct line, no handoffs, no account managers' },
      ].map(({ stat, label }) => (
        <div>
          <div class="font-serif text-2xl font-semibold text-ink mb-1">{stat}</div>
          <div class="text-xs text-ink-mid leading-snug">{label}</div>
        </div>
      ))}
    </div>

    <!-- The problem -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">The problem</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-5">In home services, showing up in the top 3 is everything.</h2>
      <div class="space-y-4 text-ink-mid leading-relaxed">
        <p>
          Home service searches are high-intent and fast-moving. Someone searching "emergency plumber near me" or "HVAC repair [city]" is ready to call right now. The business that appears in the Google Maps 3-pack gets the majority of those calls. The businesses below the fold get almost none.
        </p>
        <p>
          The challenge is that home services is one of the most competitive local search categories. Every HVAC company, plumber, and landscaper in your market is competing for the same top-3 spots. The ones that win have invested in their Google Business Profile, built a consistent review engine, and created service-specific pages that rank for high-intent searches.
        </p>
        <p>
          Most haven't. That's the gap — and it's closable.
        </p>
      </div>
    </section>

    <!-- What's included -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">What's included</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">A complete local search system for your home service business.</h2>
      <div class="space-y-6">
        {[
          {
            title: 'Google Business Profile Optimization',
            body: 'Your GBP is the most important asset for local search visibility. I audit and optimize every field — service categories, photos, Q&A, posts, and the specific attributes that influence your Maps ranking for searches like "HVAC repair near me" and "plumber [your city]."',
          },
          {
            title: 'Review Acquisition System',
            body: 'A consistent stream of new reviews is a top-3 local ranking signal. I build a simple system that asks customers for a review right after a completed job — when satisfaction is highest — and routes them directly to your Google profile.',
          },
          {
            title: 'Home Service Directory Citations',
            body: 'Consistent NAP data across Angi, HomeAdvisor, Thumbtack, BBB, and 40+ other directories signals legitimacy to Google. I audit, fix, and build the citations your competitors already have.',
          },
          {
            title: 'Service-Specific Landing Pages',
            body: 'AC repair, furnace installation, emergency plumbing, drain cleaning — each service deserves its own page optimized for the specific searches that drive those calls. I build or optimize these pages to rank for high-intent local searches.',
          },
          {
            title: 'Google Local Services Ads Setup',
            body: 'LSAs appear above regular search results with a "Google Guaranteed" badge and charge per lead rather than per click. For home service businesses, they\'re often the highest-ROI paid channel. I handle the setup, verification, and ongoing optimization.',
          },
        ].map(({ title, body }) => (
          <div class="flex gap-4 items-start">
            <span class="mt-2 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <h3 class="font-semibold text-ink mb-1">{title}</h3>
              <p class="text-ink-mid text-sm leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Common questions</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">What home service business owners ask before getting started.</h2>
      <div class="space-y-6">
        {faqItems.map(({ q, a }) => (
          <div class="border-b border-cream-dark pb-6">
            <h3 class="font-semibold text-ink mb-2">{q}</h3>
            <p class="text-ink-mid text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy text-cream rounded-2xl p-10 text-center">
      <h2 class="font-serif text-3xl font-semibold mb-4">See exactly where your competitors are outranking you — and how to close the gap.</h2>
      <p class="text-cream/75 mb-8 max-w-lg mx-auto leading-relaxed">
        The free Gap Analysis shows how your local search presence compares to your top 3–5 competitors — with specific fixes and priorities. No call required. Results in your inbox within 12 hours.
      </p>
      <button type="button" data-modal="gap-analysis" class="inline-block bg-white text-ink font-medium px-8 py-3 rounded-lg hover:bg-cream transition-colors cursor-pointer border-0">
        Get your free Gap Analysis →
      </button>
      <p class="text-cream/50 text-xs mt-4">Free. No call required. No obligation.</p>
    </section>

  </div>
</BaseLayout>
