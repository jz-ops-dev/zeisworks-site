  { id: 'section-3', label: '3. Services and Materials' },
  { id: 'section-4', label: '4. Accounts, Access, and Credentials' },
  { id: 'section-5', label: '5. Subscriptions, Term, and Renewal' },
  { id: 'section-6', label: '6. Payment and Billing' },
  { id: 'section-7', label: '7. No Refunds' },
  { id: 'section-8', label: '8. Cancellation and Termination' },
  { id: 'section-9', label: '9. Electronic Communications' },
  { id: 'section-10', label: '10. Privacy and Data Use' },
  { id: 'section-11', label: '11. Service Data and AI Training License' },
  { id: 'section-12', label: '12. Third-Party Platforms' },
  { id: 'section-13', label: '13. Prohibited Use' },
