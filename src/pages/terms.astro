  { id: 'section-17', label: '17. Limitation of Liability' },
  { id: 'section-18', label: '18. Indemnification' },
  { id: 'section-19', label: '19. No Guarantee of Results' },
  { id: 'section-20', label: '20. Accessibility Disclaimer' },
  { id: 'section-21', label: '21. Local Laws and Compliance' },
  { id: 'section-22', label: '22. Communications Compliance' },
  { id: 'section-23', label: '23. Force Majeure' },
  { id: 'section-24', label: '24. Service-Specific Terms' },
