---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free: The Independent Practice Guide to GEO"
  description="How independent practices get recommended by ChatGPT, Google AI Overviews, and modern search engines — before corporate chains take the top spots. Free PDF download."
  ogTitle="The Independent Practice Guide to GEO | zeisWorks"
  ogDescription="The search engines changed. Most practices don't know it. Download the free guide to Generative Engine Optimization for independent local practices."
>

<style>
  /* ============================================
     GEO GUIDE PAGE
     Design: Matches site's forest/cream palette.
     Hero uses forest dark bg (like local-search-checklist).
     Stats row uses cream-dark. Content uses cream.
     ============================================ */

  /* Hero */
  .geo-hero {
    background: var(--forest-dark);
    padding: 5rem 2rem 4rem;
    text-align: center;
  }
  .geo-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .geo-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 1.5rem;
  }
  .geo-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3dd68c;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.75); }
  }
  .geo-h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.18;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }
  .geo-h1 em {
    font-style: italic;
    color: var(--orange-light, #f2c4a0);
  }
  .geo-subhead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.75;
    margin-bottom: 2.75rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .geo-download-box {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 460px;
    margin: 0 auto;
  }
  .geo-download-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 0.875rem;
  }
  .geo-download-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .geo-download-desc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.58);
    margin-bottom: 1.5rem;
    line-height: 1.65;
  }
  .geo-btn-download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: var(--orange);
    color: #fff;
    padding: 0.9rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .geo-btn-download:hover {
    background: #a8461a;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(200, 90, 32, 0.4);
  }
  .geo-note {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(255,255,255,0.35);
    margin-top: 0.875rem;
    letter-spacing: 0.04em;
  }

  /* Stats Row */
  .geo-stats {
    background: var(--cream-dark);
    border-bottom: 1px solid #E8E3D8;
    padding: 3rem 2rem;
  }
  .geo-stats-inner {
    max-width: 720px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  @media (max-width: 600px) {
    .geo-stats-inner { grid-template-columns: 1fr; }
    .geo-stat { border-right: none !important; border-bottom: 1px solid #E8E3D8; }
    .geo-stat:last-child { border-bottom: none; }
  }
  .geo-stat {
    padding: 1.5rem 2rem;
    border-right: 1px solid #E8E3D8;
    text-align: center;
  }
  .geo-stat:last-child { border-right: none; }
  .geo-stat-value {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--orange);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 0.375rem;
  }
  .geo-stat-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .geo-stat-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-light);
    letter-spacing: 0.04em;
  }

  /* What's Inside */
  .geo-inside {
    max-width: 720px;
    margin: 0 auto;
    padding: 4.5rem 2rem;
  }
  .geo-section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .geo-section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .geo-section-body {
    color: var(--ink-mid);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    font-size: 0.9375rem;
  }
  .geo-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .geo-card {
    background: var(--cream-dark);
    border: 1px solid #E8E3D8;
    border-radius: 0.875rem;
    padding: 1.5rem;
    transition: border-color 0.2s;
  }
  .geo-card:hover { border-color: var(--orange); }
  .geo-card-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.5rem;
  }
  .geo-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.375rem;
    line-height: 1.4;
  }
  .geo-card p {
    font-size: 0.84rem;
    color: var(--ink-mid);
    line-height: 1.65;
  }

  /* Context block */
  .geo-context {
    background: var(--forest);
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 3rem;
  }
  .geo-context-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 1rem;
  }
  .geo-context-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  .geo-context-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .geo-context-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3dd68c;
    margin-top: 6px;
    flex-shrink: 0;
  }
  .geo-context-text {
    font-size: 0.84rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.55;
  }

  /* Bottom CTA */
  .geo-bottom-cta {
    background: var(--cream-dark);
    border-top: 1px solid #E8E3D8;
    padding: 4.5rem 2rem;
    text-align: center;
  }
  .geo-bottom-inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .geo-bottom-cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.875rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .geo-bottom-cta p {
    color: var(--ink-mid);
    line-height: 1.75;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }
  .geo-btn-analysis {
    display: inline-block;
    background: var(--navy);
    color: #fff;
    padding: 0.9rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    border: none;
    cursor: pointer;
  }
  .geo-btn-analysis:hover { background: var(--terra-dark, #1e3350); transform: translateY(-1px); }
  .geo-bottom-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-light);
    margin-top: 1rem;
    letter-spacing: 0.04em;
  }

  /* Contact line */
  .geo-contact {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid #E8E3D8;
    background: var(--cream);
  }
  .geo-contact p {
    font-size: 0.875rem;
    color: var(--ink-mid);
  }
  .geo-contact a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
  }
  .geo-contact a:hover { text-decoration: underline; }
</style>

<!-- Hero -->
<section class="geo-hero">
  <div class="geo-hero-inner">
    <p class="geo-eyebrow">
      <span class="geo-eyebrow-dot"></span>
      Free resource · Independent practice guide
    </p>
    <h1 class="geo-h1">
      The Search Engines Changed.<br>
      <em>Most Practices Don't Know It.</em>
    </h1>
    <p class="geo-subhead">
      When a new patient asks ChatGPT or Google's new AI Overviews to recommend a local practice, they get a single synthesized answer — not a list of links. The practices that show up in that answer win. This guide shows you exactly how to be the one that gets recommended.
    </p>

    <div class="geo-download-box">
      <p class="geo-download-label">Free PDF · Direct download</p>
      <p class="geo-download-title">The Independent Practice Guide to GEO</p>
      <p class="geo-download-desc">
        Generative Engine Optimization explained for independent local practices. The 4-step playbook to get recommended before corporate chains take the top spots.
      </p>
      <a href="/geo-guide.pdf" download="zeisWorks_GEO_Guide.pdf" class="geo-btn-download">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download the free GEO guide
      </a>
      <p class="geo-note">PDF · No email required · No strings attached</p>
    </div>
  </div>
</section>

<!-- Stats Row -->
<section class="geo-stats">
  <div class="geo-stats-inner">
    <div class="geo-stat">
      <div class="geo-stat-value">527%</div>
      <div class="geo-stat-label">AI Referral Traffic Growth</div>
      <div class="geo-stat-sub">Jan–May 2025</div>
    </div>
    <div class="geo-stat">
      <div class="geo-stat-value">4.4×</div>
      <div class="geo-stat-label">Higher Conversion Rate</div>
      <div class="geo-stat-sub">AI traffic vs. organic</div>
    </div>
    <div class="geo-stat">
      <div class="geo-stat-value">48%</div>
      <div class="geo-stat-label">Searches Show AI Overviews</div>
      <div class="geo-stat-sub">Google, March 2026</div>
    </div>
  </div>
</section>

<!-- What's Inside -->
<section class="geo-inside">
  <p class="geo-section-label">What's inside</p>
  <h2 class="geo-section-title">The 4-step GEO playbook for independent practices.</h2>
  <p class="geo-section-body">
    Corporate chains have entire teams working on this right now. As an independent owner, you can move faster by executing these four steps — each one directly increases the likelihood that a conversational search engine recommends your practice over a chain.
  </p>

  <!-- Who this is for -->
  <div class="geo-context">
    <p class="geo-context-label">Written for independent owners in</p>
    <div class="geo-context-grid">
      {[
        'Med Spa & Aesthetics',
        'Veterinary Clinics',
        'Dental Practices',
        'Physical Therapy',
        'Chiropractic',
        'Optometry',
        'Home Services',
        'Any local service business',
      ].map(v => (
        <div class="geo-context-item">
          <span class="geo-context-dot"></span>
          <span class="geo-context-text">{v}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="geo-cards-grid">
    {[
      {
        num: '01',
        title: 'Why GEO is Replacing Traditional SEO',
        desc: 'The data on how search behavior has shifted and why keyword rankings no longer tell the full story for local practices.',
      },
      {
        num: '02',
        title: 'How Conversational Engines Pick Winners',
        desc: 'The exact signals ChatGPT, Perplexity, and Google AI Overviews use to decide which practice to recommend.',
      },
      {
        num: '03',
        title: 'Fix Your Fragmented Data',
        desc: 'Why inconsistent directory listings are silently killing your visibility — and the exact fix that takes less than an afternoon.',
      },
      {
        num: '04',
        title: 'Cultivate Contextual Reviews',
        desc: 'Why a 5-star rating is useless for GEO and how to get the review text that actually gets you recommended.',
      },
      {
        num: '05',
        title: 'Add Verifiable Authority to Your Site',
        desc: 'The specific content modifications (statistics, expert quotes, citations) that increase AI visibility by up to 40%.',
      },
      {
        num: '06',
        title: 'Implement Schema Markup',
        desc: 'The hidden code that speaks directly to search engines and removes all guesswork about who you are and where you are.',
      },
    ].map(item => (
      <div class="geo-card">
        <p class="geo-card-num">{item.num}</p>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </div>
    ))}
  </div>

  <div style="text-align:center;">
    <a href="/geo-guide.pdf" download="zeisWorks_GEO_Guide.pdf" class="geo-btn-download" style="display:inline-flex;width:auto;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download the free GEO guide
    </a>
    <p style="font-family:var(--font-mono);font-size:0.68rem;color:var(--ink-light);margin-top:0.75rem;letter-spacing:0.04em;">PDF · No email required</p>
  </div>
</section>

<!-- Bottom CTA -->
<section class="geo-bottom-cta">
  <div class="geo-bottom-inner">
    <h2>Want to see exactly where your practice stands right now?</h2>
    <p>
      The guide tells you what to fix. The free gap analysis tells you exactly where you stand — with a full breakdown of your local search visibility, directory consistency, and how you compare to the chains competing for the same patients.
    </p>
    <button type="button" data-modal="gap-analysis" class="geo-btn-analysis">Get in touch →</button>
    <p class="geo-bottom-note">Free · No call required · Results in 12 hours</p>
  </div>
</section>

<!-- Contact -->
<section class="geo-contact">
  <p>
    Questions? Reach Jack directly:
    <a href="tel:+17206502447">+1 (720) 650-2447</a>
    &nbsp;·&nbsp;
    <a href="mailto:jack@zeisworks.com">jack@zeisworks.com</a>
  </p>
</section>

</BaseLayout>
