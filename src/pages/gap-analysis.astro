---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "What does this cost?",
    a: "Nothing. It's a free 30-minute analysis. There's no obligation to hire us afterward, and most of what we find, you can fix yourself.",
  },
  {
    q: "Will you try to sell me something?",
    a: "At the end of the call, if there's a gap that needs ongoing work, we'll mention what that would look like. If there isn't, we'll tell you that too.",
  },
  {
    q: "What do I need to prepare?",
    a: "Nothing. Just be at your computer for screen-sharing.",
  },
  {
    q: "Is this just SEO?",
    a: "No. SEO is about Google rankings. This is about whether AI tools — ChatGPT, Perplexity, Google's AI summaries — recommend your business when customers ask.",
  },
  {
    q: "How long until I see results if I act on the recommendations?",
    a: "Some fixes work within days (Google Business Profile updates, directory listings). Others take 60–90 days as AI engines re-index.",
  },
];

const deliverables = [
  {
    icon: "🔍",
    title: "AI Visibility Snapshot",
    desc: "We run 5–8 real customer queries through ChatGPT, Perplexity, and Google AI — live, on screen. You see exactly where you appear and where you don't.",
  },
  {
    icon: "⚔️",
    title: "Competitor Citation Comparison",
    desc: "The same queries, run against 3–5 competitors. You'll see who's getting cited in your category and why.",
  },
  {
    icon: "🗺️",
    title: "Citation-Source Map",
    desc: "The 5–10 websites AI is pulling from for your category — review sites, directories, blogs — and whether your business appears on any of them.",
  },
  {
    icon: "⚠️",
    title: "3 Specific Gaps",
    desc: "Concrete problems identified during the call: missing profile fields, absent directories, or service pages that don't answer what customers are actually asking AI.",
  },
  {
    icon: "✅",
    title: "2 Quick Wins (DIY)",
    desc: "Fixes you can make yourself this week. No agency required. GBP completeness, schema markup, FAQ structure — things that move the needle fast.",
  },
  {
    icon: "🎯",
    title: "1 Priority Recommendation",
    desc: "The biggest gap that needs sustained attention. We'll tell you what it is and what closing it looks like — no pressure, just an honest read.",
  },
];

const testimonials = [
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: "Alex Zemianek",
    title: "Owner & CEO, JZ Vacation Rentals",
    chips: ["Long-term Partnership", "Exceeded Expectations"],
  },
  {
    quote: "Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team. We know he will be the first person we reach out to for similar projects in the future.",
    name: "Verified Client",
    title: "Upwork · 5.0",
    chips: ["Collaborative", "Clear Communicator", "Reliable"],
  },
  {
    quote: "Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him for any sales or operations work.",
    name: "Ray Updyke",
    title: "Alpaca VC · 254 hrs logged",
    chips: ["Collaborative", "Detail Oriented", "Reliable"],
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Free Marketing Gap Analysis",
  provider: {
    "@type": "Organization",
    name: "ZeisWorks",
    url: "https://zeisworks.com",
  },
  description:
    "A free 30-minute AI visibility audit. We run real customer queries through ChatGPT, Perplexity, and Google AI to show you exactly where your business appears — and where it doesn't.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title="Free Marketing Gap Analysis"
  description="Find out if AI is sending your customers to you — or your competitor. Book a free 30-minute Marketing Gap Analysis. We run real queries through ChatGPT, Perplexity, and Google AI. You'll see exactly where you stand."
  ogTitle="Free Marketing Gap Analysis | zeisWorks"
  ogDescription="A free 30-minute AI visibility audit. See exactly where your business shows up in ChatGPT, Perplexity, and Google AI — and what to fix first."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
    <style>
      /* ── Page-level overrides ── */
      .ga-page {
        font-size: 1.0625rem;
        line-height: 1.75;
      }

      /* ── HERO ── */
      .ga-hero {
        background: var(--cream);
        padding: 5rem 1.5rem 4rem;
        border-bottom: 1px solid theme('colors.cream-dark');
      }
      .ga-hero-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }
      .ga-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 1.25rem;
      }
      .ga-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: theme('colors.ink');
        margin-bottom: 1.25rem;
      }
      .ga-h1 em {
        color: theme('colors.orange');
        font-style: italic;
      }
      .ga-subhead {
        font-size: 1.125rem;
        color: theme('colors.ink-mid');
        max-width: 580px;
        margin: 0 auto 2.25rem;
        line-height: 1.75;
      }
      .ga-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
      }
      .ga-btn-primary {
        background: theme('colors.navy');
        color: #fff;
        padding: 0.875rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        display: inline-block;
      }
      .ga-btn-primary:hover {
        background: #1e3350;
        transform: translateY(-1px);
      }
      .ga-btn-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: theme('colors.ink-mid');
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-btn-phone:hover {
        color: theme('colors.ink');
      }
      .ga-trust-strip {
        font-size: 0.8125rem;
        color: theme('colors.ink-light');
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }
      .ga-trust-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.25);
        flex-shrink: 0;
      }

      /* ── DELIVERABLES ── */
      .ga-section {
        padding: 4.5rem 1.5rem;
      }
      .ga-section-inner {
        max-width: 720px;
        margin: 0 auto;
      }
      .ga-section-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.75rem;
      }
      .ga-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .ga-section-body {
        color: theme('colors.ink-mid');
        max-width: 560px;
        margin-bottom: 2.5rem;
      }
      .ga-deliverables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      @media (max-width: 600px) {
        .ga-deliverables-grid { grid-template-columns: 1fr; }
      }
      .ga-deliverable-card {
        background: theme('colors.cream-dark');
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .ga-deliverable-icon {
        font-size: 1.375rem;
        line-height: 1;
        margin-bottom: 0.25rem;
      }
      .ga-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
      }
      .ga-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }
      .ga-walkaway-note {
        margin-top: 1.5rem;
        padding: 1.25rem 1.5rem;
        background: theme('colors.cream');
        border: 1px solid #e8e3d8;
        border-left: 3px solid theme('colors.orange');
        border-radius: 0.625rem;
        font-size: 0.9rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
      }
      .ga-walkaway-note strong {
        color: theme('colors.ink');
      }

      /* ── HOW IT WORKS ── */
      .ga-how {
        background: theme('colors.cream-dark');
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .ga-steps { grid-template-columns: 1fr; gap: 1.5rem; }
      }
      .ga-step-num {
        font-family: theme('fontFamily.serif');
        font-size: 3rem;
        font-weight: 700;
        color: theme('colors.cream');
        -webkit-text-stroke: 1.5px #c8bfaa;
        line-height: 1;
        margin-bottom: 0.5rem;
        letter-spacing: -0.03em;
      }
      .ga-step h3 {
        font-family: theme('fontFamily.serif');
        font-size: 1.0625rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.375rem;
      }
      .ga-step p {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.7;
        margin: 0;
      }

      /* ── TESTIMONIALS ── */
      .ga-proof-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(242, 238, 228, 0.5);
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
        text-align: center;
      }
      .ga-testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 700px) {
        .ga-testimonials-grid { grid-template-columns: 1fr; }
      }
      .ga-tcard {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
      }
      .ga-tcard-stars {
        color: theme('colors.orange');
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        margin-bottom: 0.875rem;
      }
      .ga-tcard-quote {
        font-family: theme('fontFamily.serif');
        font-style: italic;
        font-size: 0.9375rem;
        color: theme('colors.ink');
        line-height: 1.75;
        flex: 1;
        margin: 0;
      }
      .ga-tcard-divider {
        border-top: 1px solid #e8e3d8;
        margin: 1rem 0;
      }
      .ga-tcard-name {
        font-weight: 600;
        color: theme('colors.ink');
        font-size: 0.875rem;
        margin: 0;
      }
      .ga-tcard-title {
        font-size: 0.75rem;
        color: theme('colors.ink-light');
        margin: 0.125rem 0 0.5rem;
      }
      .ga-tcard-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      .ga-chip {
        font-size: 0.7rem;
        background: theme('colors.cream-dark');
        color: theme('colors.ink-mid');
        padding: 0.2rem 0.625rem;
        border-radius: 999px;
      }

      /* ── ABOUT ── */
      .ga-about {
        background: theme('colors.cream-dark');
        border-top: 1px solid #e8e3d8;
      }
      .ga-about-inner {
        max-width: 720px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 3rem;
        align-items: start;
      }
      @media (max-width: 640px) {
        .ga-about-inner { grid-template-columns: 1fr; gap: 1.75rem; }
      }
      .ga-about-photo {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 0.875rem;
        object-fit: cover;
        border: 1px solid #e8e3d8;
      }
      .ga-about-body h2 {
        font-family: theme('fontFamily.serif');
        font-size: 1.5rem;
        font-weight: 700;
        color: theme('colors.ink');
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .ga-about-body p {
        font-size: 0.9375rem;
        color: theme('colors.ink-mid');
        line-height: 1.8;
        margin-bottom: 0.875rem;
      }
      .ga-about-body p:last-child { margin-bottom: 0; }
      .ga-about-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }
      .ga-about-tag {
        font-size: 0.75rem;
        background: theme('colors.cream');
        border: 1px solid #e8e3d8;
        color: theme('colors.ink-mid');
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      /* ── FAQ ── */
      .ga-faq-list {
        margin-top: 2.5rem;
        border-top: 1px solid #e8e3d8;
      }
      .ga-faq-item {
        padding: 1.375rem 0;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-faq-q {
        font-size: 0.9375rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }
      .ga-faq-a {
        font-size: 0.9rem;
        color: theme('colors.ink-mid');
        line-height: 1.75;
        margin: 0;
      }

      /* ── REPEAT CTA ── */
      .ga-cta-section {
        background: theme('colors.forest');
        text-align: center;
        padding: 5rem 1.5rem;
      }
      .ga-cta-inner {
        max-width: 600px;
        margin: 0 auto;
      }
      .ga-cta-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 1rem;
      }
      .ga-cta-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
      }
      .ga-cta-body {
        font-size: 1.0625rem;
        color: rgba(255,255,255,0.7);
        line-height: 1.75;
        margin-bottom: 2.25rem;
      }
      .ga-cta-body strong { color: #fff; }
      .ga-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.25rem;
      }
      .ga-btn-cta-primary {
        background: theme('colors.orange');
        color: #fff;
        padding: 0.9rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        display: inline-block;
      }
      .ga-btn-cta-primary:hover {
        background: #a8511f;
        transform: translateY(-1px);
      }
      .ga-btn-cta-phone {
        color: rgba(255,255,255,0.75);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-btn-cta-phone:hover { color: #fff; }
      .ga-scarcity {
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.45);
      }

      /* ── BOOKING PLACEHOLDER ── */
      .ga-booking-placeholder {
        background: rgba(255,255,255,0.06);
        border: 1px dashed rgba(255,255,255,0.2);
        border-radius: 0.875rem;
        padding: 2.5rem 2rem;
        margin-top: 2.5rem;
        text-align: center;
        color: rgba(255,255,255,0.5);
        font-size: 0.875rem;
        line-height: 1.6;
      }
      .ga-booking-placeholder strong {
        display: block;
        color: rgba(255,255,255,0.7);
        font-size: 0.9375rem;
        margin-bottom: 0.5rem;
      }
    </style>
  </Fragment>

  <div class="ga-page">

    <!-- ══════════════════════════════════════
         SECTION 1 — ABOVE THE FOLD
    ══════════════════════════════════════ -->
    <section class="ga-hero" id="top">
      <div class="ga-hero-inner">
        <p class="ga-eyebrow">Free · 30 minutes · No obligation</p>
        <h1 class="ga-h1">
          Find out if AI is sending your customers to you —<br class="hidden sm:block" />
          or your <em>competitor.</em>
        </h1>
        <p class="ga-subhead">
          A free 30-minute Marketing Gap Analysis. We run real customer questions through
          ChatGPT, Perplexity, and Google's AI. You'll see exactly where you show up,
          where you don't, and what to fix first.
        </p>
        <div class="ga-cta-group">
          <a href="#book" class="ga-btn-primary">Book my free analysis →</a>
          <a href="tel:+15550000000" class="ga-btn-phone">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.4a16 16 0 0 0 6.29 6.29l1.76-1.76a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Or call (555) 000-0000
          </a>
        </div>
        <p class="ga-trust-strip">
          <span class="ga-trust-dot" aria-hidden="true"></span>
          Trusted by small businesses across the US &nbsp;·&nbsp; 5.0 on Upwork &nbsp;·&nbsp; 100% Job Success
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 2 — WHAT YOU'LL WALK AWAY WITH
    ══════════════════════════════════════ -->
    <section class="ga-section">
      <div class="ga-section-inner">
        <p class="ga-section-label">What you'll walk away with</p>
        <h2 class="ga-section-title">Six findings. Delivered in 30 minutes.</h2>
        <p class="ga-section-body">
          This isn't a vague "strategy session." Every analysis produces six specific artifacts —
          things you can act on the same week.
        </p>
        <div class="ga-deliverables-grid">
          {deliverables.map((d) => (
            <div class="ga-deliverable-card">
              <div class="ga-deliverable-icon" aria-hidden="true">{d.icon}</div>
              <p class="ga-deliverable-title">{d.title}</p>
              <p class="ga-deliverable-desc">{d.desc}</p>
            </div>
          ))}
        </div>
        <div class="ga-walkaway-note">
          <strong>You'll also receive a written summary.</strong> A 1–2 page PDF covering all six findings,
          sent within 24 hours. This is what you'll share with a partner, sleep on, or hand to whoever
          handles your marketing. No PDF means no real deliverable — so you'll always get one.
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 3 — HOW IT WORKS
    ══════════════════════════════════════ -->
    <section class="ga-section ga-how">
      <div class="ga-section-inner">
        <p class="ga-section-label">How it works</p>
        <h2 class="ga-section-title">Three steps. Zero prep required.</h2>
        <p class="ga-section-body">
          You don't need to know anything about AI or SEO before the call. Just show up.
        </p>
        <div class="ga-steps">
          <div class="ga-step">
            <div class="ga-step-num">01</div>
            <h3>Book a 30-minute call</h3>
            <p>Pick a time below. No forms, no pre-call homework. Just your name, email, and business website so I can run your queries before we meet.</p>
          </div>
          <div class="ga-step">
            <div class="ga-step-num">02</div>
            <h3>We run your business through AI live</h3>
            <p>On the call, I'll screen-share and run 5–8 real customer queries through ChatGPT, Perplexity, and Google AI. You watch in real time. No slides, no decks.</p>
          </div>
          <div class="ga-step">
            <div class="ga-step-num">03</div>
            <h3>You get a written gap report</h3>
            <p>Within 24 hours, a 1–2 page PDF lands in your inbox: your six findings, two quick wins, and one clear next step — whether you work with us or not.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 4 — SOCIAL PROOF
    ══════════════════════════════════════ -->
    <section class="ga-section" style="padding-top: 0;">
      <div class="ga-proof-bar">
        <span>&#9733;&#9733;&#9733;&#9733;&#9733;&nbsp; 5.0 on Upwork</span>
        <span>Top Rated &nbsp;·&nbsp; 100% Job Success</span>
        <span>Trusted by businesses across the US</span>
      </div>
      <div class="ga-section-inner" style="padding-top: 3rem;">
        <p class="ga-section-label">What clients say</p>
        <h2 class="ga-section-title">Real results from real businesses.</h2>
        <div class="ga-testimonials-grid">
          {testimonials.map((t) => (
            <div class="ga-tcard">
              <div class="ga-tcard-stars" aria-label="5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <p class="ga-tcard-quote">&ldquo;{t.quote}&rdquo;</p>
              <div class="ga-tcard-divider" aria-hidden="true"></div>
              <p class="ga-tcard-name">{t.name}</p>
              <p class="ga-tcard-title">{t.title}</p>
              <div class="ga-tcard-chips">
