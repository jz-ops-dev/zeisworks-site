            <div class="ga-field">
              <label for="ga-business">Business name <span aria-hidden="true">*</span></label>
              <input type="text" id="ga-business" name="business_name" placeholder="Acme Plumbing Co." required />
            </div>
            <div class="ga-field">
              <label for="ga-website">Business website <span aria-hidden="true">*</span></label>
              <input type="url" id="ga-website" name="website" placeholder="https://yourbusiness.com" required autocomplete="url" />
