---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "What does this cost?",
    a: "Nothing. The analysis is completely free. No obligation to hire me afterward.",
  },
  {
    q: "Do I have to get on a call?",
    a: "No. You fill out the form, I run the analysis, and you get a written report in your inbox within 12 hours.",
  },
  {
    q: "What will I actually receive?",
    a: "A written gap analysis showing how your business ranks in local search, which competitors are outranking you and why, and specific fixes with recommended priorities. If there's a clear path to improvement, I'll include a plan with options.",
  },
  {
    q: "What happens after I get the results?",
    a: "You decide. Execute on your own using the quick wins, have me handle the work, or hop on a call to go deeper. No pressure — the report stands on its own.",
  },
];

const deliverables = [
  {
    title: "Local Search Visibility Score",
    desc: "How your business ranks in Google local search for your category and service area. Benchmarked against your top competitors.",
  },
  {
    title: "Citation & Directory Audit",
    desc: "Which directories and local listings drive rankings — and which ones you're missing or have inconsistent information on.",
  },
  {
    title: "Specific Gaps Identified",
    desc: "Not vague recommendations — concrete problems. Missing profile fields, absent directories, service pages that don't match what customers are searching for.",
  },
  {
    title: "Quick Wins + Growth Plan",
    desc: "Fixes you can make this week yourself. Plus a prioritized plan with options if there's a meaningful gap worth closing.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Free Marketing Gap Analysis",
  provider: {
    "@type": "Organization",
    name: "ZeisWorks",
    url: "https://zeisworks.com",
  },
  description:
    "A free local search gap analysis. Submit your business info, and I run the analysis on your behalf — no call required. You receive a written report showing exactly where you stand in local search, how you compare to competitors, and a plan if there's a gap worth closing.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title="Free Marketing Gap Analysis — See Where You Stand"
  description="Find out why your competitors are outranking you — and what to fix. I'll run a personal analysis of your business and send you a written report. No call required."
  ogTitle="Free Marketing Gap Analysis | zeisWorks"
  ogDescription="A free marketing gap analysis. No call required. I'll personally audit your local search presence, competitors, and marketing gaps — and send you a written report with specific fixes."
  bodyPage="gap-analysis"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
    <style>
      .ga-page { font-size: 1.0625rem; line-height: 1.75; }

      /* ── HERO ── */
      .ga-hero {
        background: var(--cream);
        padding: 5rem 1.5rem 4rem;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-hero-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }
      .ga-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 1.25rem;
      }
      .ga-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: theme('colors.ink');
        margin-bottom: 1.25rem;
      }
      .ga-h1 em {
        color: theme('colors.orange');
        font-style: italic;
      }
      .ga-subhead {
        font-size: 1.125rem;
        color: theme('colors.ink-mid');
        max-width: 600px;
        margin: 0 auto 2.25rem;
        line-height: 1.75;
      }
      .ga-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
      }
      .ga-btn-primary {
        background: theme('colors.navy');
        color: #fff;
        padding: 0.875rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        display: inline-block;
      }
      .ga-btn-primary:hover {
        background: #1e3350;
        transform: translateY(-1px);
      }
      .ga-btn-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: theme('colors.ink-mid');
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-btn-phone:hover { color: theme('colors.ink'); }
      .ga-trust-strip {
        font-size: 0.8125rem;
        color: theme('colors.ink-light');
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }
      .ga-trust-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.25);
        flex-shrink: 0;
      }

      /* ── SECTION BASE ── */
      .ga-section {
        padding: 4.5rem 1.5rem;
      }
      .ga-section-inner {
        max-width: 720px;
        margin: 0 auto;
      }
      .ga-section-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.75rem;
      }
      .ga-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .ga-section-body {
        color: theme('colors.ink-mid');
        max-width: 560px;
        margin-bottom: 2.5rem;
      }

      /* ── HOW IT WORKS ── */
      .ga-how {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .ga-steps { grid-template-columns: 1fr; gap: 1.5rem; }
      }
      .ga-step-num {
        font-family: theme('fontFamily.serif');
        font-size: 3rem;
        font-weight: 700;
        color: #f2ede4;
        -webkit-text-stroke: 1.5px #c8bfaa;
        line-height: 1;
        margin-bottom: 0.5rem;
        letter-spacing: -0.03em;
      }
      .ga-step h3 {
        font-family: theme('fontFamily.serif');
        font-size: 1.0625rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.375rem;
      }
      .ga-step p {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.7;
        margin: 0;
      }

      /* ── DELIVERABLES ── */
      .ga-deliverables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      @media (max-width: 600px) {
        .ga-deliverables-grid { grid-template-columns: 1fr; }
      }
      .ga-deliverable-card {
        background: #f2ede4;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
      }
      .ga-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
        margin-bottom: 0.5rem;
      }
      .ga-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }

      /* ── FAQ ── */
      .ga-faq-list {
        margin-top: 2rem;
        border-top: 1px solid #e8e3d8;
      }
      .ga-faq-item {
        padding: 1.375rem 0;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-faq-q {
        font-size: 0.9375rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }
      .ga-faq-a {
        font-size: 0.9rem;
        color: theme('colors.ink-mid');
        line-height: 1.75;
        margin: 0;
      }

      /* ── FORM SECTION ── */
      .ga-form-section {
        background: theme('colors.forest');
        padding: 5rem 1.5rem;
      }
      .ga-form-inner {
        max-width: 640px;
        margin: 0 auto;
      }
      .ga-form-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 1rem;
        text-align: center;
      }
      .ga-form-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        text-align: center;
      }
      .ga-form-body {
        font-size: 1rem;
        color: rgba(255,255,255,0.65);
        line-height: 1.75;
        margin-bottom: 2.5rem;
        text-align: center;
      }
      .ga-form-body strong { color: #fff; }
      .ga-form {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .ga-field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .ga-field label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        letter-spacing: 0.02em;
      }
      .ga-field label span {
        color: theme('colors.orange');
        margin-left: 2px;
      }
      .ga-field input,
      .ga-field textarea,
      .ga-field select {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        color: #fff;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
        font-family: inherit;
        width: 100%;
        box-sizing: border-box;
      }
      .ga-field input::placeholder,
      .ga-field textarea::placeholder {
        color: rgba(255,255,255,0.3);
      }
      .ga-field input:focus,
      .ga-field textarea:focus,
      .ga-field select:focus {
        border-color: rgba(255,255,255,0.45);
        background: rgba(255,255,255,0.12);
      }
      .ga-field textarea { resize: vertical; min-height: 90px; }
      .ga-field select option { background: #2a3d2a; color: #fff; }
      .ga-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }
      @media (max-width: 520px) {
        .ga-form-row { grid-template-columns: 1fr; }
      }
      .ga-submit-btn {
        background: theme('colors.orange');
        color: #fff;
        border: none;
        padding: 0.9rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        width: 100%;
        font-family: inherit;
        margin-top: 0.5rem;
      }
      .ga-submit-btn:hover {
        background: #a8511f;
        transform: translateY(-1px);
      }
      .ga-form-disclaimer {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.35);
        text-align: center;
        line-height: 1.6;
        margin-top: 0.25rem;
      }
      .ga-phone-alt {
        text-align: center;
        margin-top: 1.75rem;
        font-size: 0.875rem;
        color: rgba(255,255,255,0.45);
      }
      .ga-phone-alt a {
        color: rgba(255,255,255,0.65);
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-phone-alt a:hover { color: #fff; }
    </style>
  </Fragment>

  <div class="ga-page">

    <!-- ══════════════════════════════════════
         HERO
    ══════════════════════════════════════ -->
    <section class="ga-hero" id="top">
      <div class="ga-hero-inner">
        <p class="ga-eyebrow">Free · No call required · Results in 12 hours</p>
        <h1 class="ga-h1">
          Find out why your competitors are showing up first —<br class="hidden sm:block" />
          and what it takes to <em>outrank them.</em>
        </h1>
        <p class="ga-subhead">
          I'll personally audit your local search presence — Google rankings, Business Profile, citations, and competitor gaps — and send you a written report with specific fixes. No call required.
        </p>
        <div class="ga-cta-group">
          <a href="#request" class="ga-btn-primary">Get my free analysis →</a>
          <a href="tel:+172****2447" class="ga-btn-phone">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.4a16 16 0 0 0 6.29 6.29l1.76-1.76a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Prefer to call? (720) 650-2447
          </a>
        </div>
        <p class="ga-trust-strip">
          <span class="ga-trust-dot" aria-hidden="true"></span>
          5.0 on Upwork · 100% Job Success · Trusted by businesses across the US
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         HOW IT WORKS
    ══════════════════════════════════════ -->
    <section class="ga-section ga-how">
      <div class="ga-section-inner">
        <p class="ga-section-label">How it works</p>
        <h2 class="ga-section-title">Submit. Receive. Decide.</h2>
        <p class="ga-section-body">
          No call required. You fill out a short form — I do the work.
        </p>
        <div class="ga-steps">
          <div class="ga-step">
            <div class="ga-step-num">01</div>
            <h3>Submit your business info</h3>
            <p>Business name, website, what you do, and who your customers are. Takes 2 minutes.</p>
          </div>
          <div class="ga-step">
            <div class="ga-step-num">02</div>
            <h3>I run the analysis</h3>
            <p>I audit your local search presence — rankings, Business Profile, citations, reviews, and competitor positioning.</p>
          </div>
          <div class="ga-step">
            <div class="ga-step-num">03</div>
            <h3>You receive the results</h3>
            <p>A written gap analysis lands in your inbox within 12 hours. If there's a path to improvement, I'll include a plan with options.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         WHAT'S IN THE REPORT
    ══════════════════════════════════════ -->
    <section class="ga-section">
      <div class="ga-section-inner">
        <p class="ga-section-label">What's in the report</p>
        <h2 class="ga-section-title">Four findings. Delivered in writing.</h2>
        <p class="ga-section-body">
          Every analysis produces the same four artifacts — things you can act on whether you work with me or not.
        </p>
        <div class="ga-deliverables-grid">
          {deliverables.map((d) => (
            <div class="ga-deliverable-card">
              <p class="ga-deliverable-title">{d.title}</p>
              <p class="ga-deliverable-desc">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FAQ
    ══════════════════════════════════════ -->
    <section class="ga-section">
      <div class="ga-section-inner">
        <p class="ga-section-label">Common questions</p>
        <h2 class="ga-section-title">Straight answers.</h2>
        <dl class="ga-faq-list">
          {faqItems.map(({ q, a }) => (
            <div class="ga-faq-item">
              <dt class="ga-faq-q">{q}</dt>
              <dd class="ga-faq-a">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         REQUEST FORM
    ══════════════════════════════════════ -->
    <section class="ga-form-section" id="request">
      <div class="ga-form-inner">
        <p class="ga-form-label">Free · No call required · Results in 12 hours</p>
        <h2 class="ga-form-title">Request your free analysis.</h2>
        <p class="ga-form-body">
          Fill out the form below. I'll run the analysis and send you the results.
          <strong>No call required to receive your report.</strong>
        </p>

        <form
          class="ga-form"
          name="gap-analysis"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/gap-analysis/thank-you/"
        >
          <input type="hidden" name="form-name" value="gap-analysis" />
          <p style="display:none;">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="ga-form-row">
            <div class="ga-field">
              <label for="ga-name">Your name <span aria-hidden="true">*</span></label>
              <input type="text" id="ga-name" name="name" placeholder="Jane Smith" required autocomplete="name" />
            </div>
            <div class="ga-field">
              <label for="ga-email">Email address <span aria-hidden="true">*</span></label>
              <input type="email" id="ga-email" name="email" placeholder="jane@yourbusiness.com" required autocomplete="email" />
            </div>
          </div>

          <div class="ga-form-row">
            <div class="ga-field">
              <label for="ga-business">Business name <span aria-hidden="true">*</span></label>
              <input type="text" id="ga-business" name="business_name" placeholder="Acme Plumbing Co." required />
            </div>
            <div class="ga-field">
              <label for="ga-website">Business website <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional)</span></label>
              <input type="text" id="ga-website" name="website" placeholder="yourbusiness.com" autocomplete="url" />
            </div>
          </div>

          <div class="ga-field">
            <label for="ga-description">What do you do, and who are your customers? <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional)</span></label>
            <textarea id="ga-description" name="description" placeholder="e.g. Med spa in Boise, ID — skin care and body treatments for women 35–60. Or: Independent vet clinic in Denver, CO competing against Banfield and VCA."></textarea>
          </div>

          <div class="ga-field">
            <label for="ga-how-found">How are customers currently finding you? <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional)</span></label>
            <select id="ga-how-found" name="how_found">
              <option value="" selected>Select the best answer</option>
              <option value="word-of-mouth">Mostly word of mouth / referrals</option>
              <option value="google-search">Google search — but I want more</option>
              <option value="google-maps">Google Maps / local pack</option>
              <option value="social-media">Social media</option>
              <option value="paid-ads">Paid ads (Google, Meta, etc.)</option>
              <option value="not-sure">I'm not sure where leads come from</option>
              <option value="not-enough">They're not — that's the problem</option>
            </select>
          </div>

          <div class="ga-field">
            <label for="ga-concern">What's your biggest marketing concern right now? <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional)</span></label>
            <textarea id="ga-concern" name="concern" placeholder="e.g. Not showing up when people search for my services on Google. Competitors are ranking above me." style="min-height:70px;"></textarea>
          </div>

          <div class="ga-field">
            <label for="ga-phone">Phone number <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional — if you'd like me to be able to call)</span></label>
            <input type="tel" id="ga-phone" name="phone" placeholder="(720) 650-2447" autocomplete="tel" />
          </div>

          <button type="submit" class="ga-submit-btn">Send my analysis request →</button>
          <p class="ga-form-disclaimer">Free. No credit card. No obligation. I'll send your results within 12 hours.</p>
        </form>

        <p class="ga-phone-alt">Prefer to talk first? Call <a href="tel:+172****2447">(720) 650-2447</a></p>
      </div>
    </section>

  </div>
