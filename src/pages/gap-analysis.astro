---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "What does this cost?",
    a: "Nothing. The analysis is completely free. There's no obligation to hire me afterward, and most of what I find, you can act on yourself.",
  },
  {
    q: "Do I have to get on a call?",
    a: "No. You fill out a short form, and I run the analysis on your behalf — no call required. If the results look worth pursuing, you can choose to talk live or just move forward from the report.",
  },
  {
    q: "What do I need to provide?",
    a: "Your business name, website, and a brief description of what you do and who your customers are. That's enough for me to run the analysis.",
  },
  {
    q: "What will I actually receive?",
    a: "A written gap analysis showing how your business ranks in local search, which competitors are outranking you and why, where you have gaps in your online presence, and specific fixes with recommended priorities. If there's a clear path to improvement, I'll include a plan with options.",
  },
  {
    q: "Is this just SEO?",
    a: "It includes SEO, but goes further. This covers your full local search presence — Google Business Profile, local rankings, directory citations, review signals, and how your site compares to competitors. Most businesses have gaps they don't know about.",
  },
  {
    q: "What happens after I get the results?",
    a: "If the analysis shows clear gaps worth closing, I'll include a plan with options. You can execute on your own, have me do it, or hop on a call to go deeper. There's no pressure — the report stands on its own.",
  },
];

const deliverables = [
  {
    icon: "🔍",
    title: "Local Search Visibility Score",
    desc: "How your business ranks in Google local search for your category and service area. Benchmarked against your top 3–5 competitors.",
  },
  {
    icon: "⚔️",
    title: "Competitor Citation Map",
    desc: "Which 3–5 competitors are being cited for your category — and why. You'll see the gap clearly.",
  },
  {
    icon: "🗺️",
    title: "Citation & Directory Audit",
    desc: "The specific directories, review platforms, and local listings that drive rankings. I'll show you which ones you're missing or have inconsistent information on.",
  },
  {
    icon: "⚠️",
    title: "Specific Gaps Identified",
    desc: "Not vague recommendations — concrete problems. Missing profile fields, absent directories, service pages that don't answer what customers are asking.",
  },
  {
    icon: "✅",
    title: "Quick Wins You Can Do Yourself",
    desc: "Fixes you can make this week without hiring anyone. GBP completeness, schema markup, FAQ structure — things that move fast.",
  },
  {
    icon: "🎯",
    title: "A Plan If It's Worth Pursuing",
    desc: "If there's a meaningful gap to close, I'll include a prioritized plan with options — what to do, what it costs, and what the ROI looks like.",
  },
];

const testimonials = [
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: "Alex Zemianek",
    title: "Owner & CEO, JZ Vacation Rentals",
    chips: ["Long-term Partnership", "Exceeded Expectations"],
  },
  {
    quote: "Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team. We know he will be the first person we reach out to for similar projects in the future.",
    name: "Verified Client",
    title: "Upwork · 5.0",
    chips: ["Collaborative", "Clear Communicator", "Reliable"],
  },
  {
    quote: "Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him for any sales or operations work.",
    name: "Ray Updyke",
    title: "Alpaca VC · 254 hrs logged",
    chips: ["Collaborative", "Detail Oriented", "Reliable"],
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Free Marketing Gap Analysis",
  provider: {
    "@type": "Organization",
    name: "ZeisWorks",
    url: "https://zeisworks.com",
  },
  description:
    "A free local search gap analysis. Submit your business info, and I run the analysis on your behalf — no call required. You receive a written report showing exactly where you stand in local search, how you compare to competitors, and a plan if there's a gap worth closing.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title="Free Local Search Gap Analysis"
  description="Find out if your competitors are outranking you in local search — and why. Submit your business info and I'll run the analysis. No call required. You get a written report showing exactly where you stand."
  ogTitle="Free Local Search Gap Analysis | zeisWorks"
  ogDescription="A free local search gap analysis. No call required. Submit your info and receive a written report showing where your business stands in Google, local search, and against your top competitors."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
    <style>
      /* ── Page-level overrides ── */
      .ga-page {
        font-size: 1.0625rem;
        line-height: 1.75;
      }

      /* ── HERO ── */
      .ga-hero {
        background: var(--cream);
        padding: 5rem 1.5rem 4rem;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-hero-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }
      .ga-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 1.25rem;
      }
      .ga-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: theme('colors.ink');
        margin-bottom: 1.25rem;
      }
      .ga-h1 em {
        color: theme('colors.orange');
        font-style: italic;
      }
      .ga-subhead {
        font-size: 1.125rem;
        color: theme('colors.ink-mid');
        max-width: 600px;
        margin: 0 auto 2.25rem;
        line-height: 1.75;
      }
      .ga-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.5rem;
      }
      .ga-btn-primary {
        background: theme('colors.navy');
        color: #fff;
        padding: 0.875rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        display: inline-block;
      }
      .ga-btn-primary:hover {
        background: #1e3350;
        transform: translateY(-1px);
      }
      .ga-btn-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: theme('colors.ink-mid');
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-btn-phone:hover { color: theme('colors.ink'); }
      .ga-trust-strip {
        font-size: 0.8125rem;
        color: theme('colors.ink-light');
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }
      .ga-trust-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4caf50;
        box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.25);
        flex-shrink: 0;
      }

      /* ── HOW IT WORKS ── */
      .ga-section {
        padding: 4.5rem 1.5rem;
      }
      .ga-section-inner {
        max-width: 720px;
        margin: 0 auto;
      }
      .ga-section-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.75rem;
      }
      .ga-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .ga-section-body {
        color: theme('colors.ink-mid');
        max-width: 560px;
        margin-bottom: 2.5rem;
      }

      /* ── STEPS ── */
      .ga-how {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .ga-steps { grid-template-columns: 1fr; gap: 1.5rem; }
      }
      .ga-step-num {
        font-family: theme('fontFamily.serif');
        font-size: 3rem;
        font-weight: 700;
        color: #f2ede4;
        -webkit-text-stroke: 1.5px #c8bfaa;
        line-height: 1;
        margin-bottom: 0.5rem;
        letter-spacing: -0.03em;
      }
      .ga-step h3 {
        font-family: theme('fontFamily.serif');
        font-size: 1.0625rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.375rem;
      }
      .ga-step p {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.7;
        margin: 0;
      }
      .ga-step-note {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: theme('colors.cream');
        border: 1px solid #e8e3d8;
        border-left: 3px solid theme('colors.orange');
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
      }
      .ga-step-note strong { color: theme('colors.ink'); }

      /* ── DELIVERABLES ── */
      .ga-deliverables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      @media (max-width: 600px) {
        .ga-deliverables-grid { grid-template-columns: 1fr; }
      }
      .ga-deliverable-card {
        background: #f2ede4;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .ga-deliverable-icon {
        font-size: 1.375rem;
        line-height: 1;
        margin-bottom: 0.25rem;
      }
      .ga-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
      }
      .ga-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }

      /* ── TESTIMONIALS ── */
      .ga-proof-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(242, 238, 228, 0.5);
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
        text-align: center;
      }
      .ga-testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 700px) {
        .ga-testimonials-grid { grid-template-columns: 1fr; }
      }
      .ga-tcard {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
      }
      .ga-tcard-stars {
        color: theme('colors.orange');
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        margin-bottom: 0.875rem;
      }
      .ga-tcard-quote {
        font-family: theme('fontFamily.serif');
        font-style: italic;
        font-size: 0.9375rem;
        color: theme('colors.ink');
        line-height: 1.75;
        flex: 1;
        margin: 0;
      }
      .ga-tcard-divider {
        border-top: 1px solid #e8e3d8;
        margin: 1rem 0;
      }
      .ga-tcard-name {
        font-weight: 600;
        color: theme('colors.ink');
        font-size: 0.875rem;
        margin: 0;
      }
      .ga-tcard-title {
        font-size: 0.75rem;
        color: theme('colors.ink-light');
        margin: 0.125rem 0 0.5rem;
      }
      .ga-tcard-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      .ga-chip {
        font-size: 0.7rem;
        background: #f2ede4;
        color: theme('colors.ink-mid');
        padding: 0.2rem 0.625rem;
        border-radius: 999px;
      }

      /* ── ABOUT ── */
      .ga-about {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
      }
      .ga-about-inner {
        max-width: 720px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 3rem;
        align-items: start;
      }
      @media (max-width: 640px) {
        .ga-about-inner { grid-template-columns: 1fr; gap: 1.75rem; }
      }
      .ga-about-photo {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 0.875rem;
        object-fit: cover;
        border: 1px solid #e8e3d8;
      }
      .ga-about-body h2 {
        font-family: theme('fontFamily.serif');
        font-size: 1.5rem;
        font-weight: 700;
        color: theme('colors.ink');
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .ga-about-body p {
        font-size: 0.9375rem;
        color: theme('colors.ink-mid');
        line-height: 1.8;
        margin-bottom: 0.875rem;
      }
      .ga-about-body p:last-child { margin-bottom: 0; }
      .ga-about-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }
      .ga-about-tag {
        font-size: 0.75rem;
        background: theme('colors.cream');
        border: 1px solid #e8e3d8;
        color: theme('colors.ink-mid');
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      /* ── FAQ ── */
      .ga-faq-list {
        margin-top: 2.5rem;
        border-top: 1px solid #e8e3d8;
      }
      .ga-faq-item {
        padding: 1.375rem 0;
        border-bottom: 1px solid #e8e3d8;
      }
      .ga-faq-q {
        font-size: 0.9375rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }
      .ga-faq-a {
        font-size: 0.9rem;
        color: theme('colors.ink-mid');
        line-height: 1.75;
        margin: 0;
      }

      /* ── FORM SECTION ── */
      .ga-form-section {
        background: theme('colors.forest');
        padding: 5rem 1.5rem;
      }
      .ga-form-inner {
        max-width: 640px;
        margin: 0 auto;
      }
      .ga-form-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 1rem;
        text-align: center;
      }
      .ga-form-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        text-align: center;
      }
      .ga-form-body {
        font-size: 1rem;
        color: rgba(255,255,255,0.65);
        line-height: 1.75;
        margin-bottom: 2.5rem;
        text-align: center;
      }
      .ga-form-body strong { color: #fff; }
      .ga-form {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .ga-field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .ga-field label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        letter-spacing: 0.02em;
      }
      .ga-field label span {
        color: theme('colors.orange');
        margin-left: 2px;
      }
      .ga-field input,
      .ga-field textarea,
      .ga-field select {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        color: #fff;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
        font-family: inherit;
        width: 100%;
        box-sizing: border-box;
      }
      .ga-field input::placeholder,
      .ga-field textarea::placeholder {
        color: rgba(255,255,255,0.3);
      }
      .ga-field input:focus,
      .ga-field textarea:focus,
      .ga-field select:focus {
        border-color: rgba(255,255,255,0.45);
        background: rgba(255,255,255,0.12);
      }
      .ga-field textarea { resize: vertical; min-height: 90px; }
      .ga-field select option { background: #2a3d2a; color: #fff; }
      .ga-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }
      @media (max-width: 520px) {
        .ga-form-row { grid-template-columns: 1fr; }
      }
      .ga-submit-btn {
        background: theme('colors.orange');
        color: #fff;
        border: none;
        padding: 0.9rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        width: 100%;
        font-family: inherit;
        margin-top: 0.5rem;
      }
      .ga-submit-btn:hover {
        background: #a8511f;
        transform: translateY(-1px);
      }
      .ga-form-disclaimer {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.35);
        text-align: center;
        line-height: 1.6;
        margin-top: 0.25rem;
      }
      .ga-phone-alt {
        text-align: center;
        margin-top: 1.75rem;
        font-size: 0.875rem;
        color: rgba(255,255,255,0.45);
      }
      .ga-phone-alt a {
        color: rgba(255,255,255,0.65);
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .ga-phone-alt a:hover { color: #fff; }
      .ga-scarcity {
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.35);
        text-align: center;
        margin-top: 1rem;
      }

      /* ── SAMPLE OUTPUT TEASER ── */
      .ga-sample {
        border-top: 1px solid #e8e3d8;
      }
      .ga-sample-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .ga-sample-cards { grid-template-columns: 1fr; }
      }
      .ga-sample-card {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
      }
      .ga-sample-card-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.5rem;
      }
      .ga-sample-card h3 {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .ga-sample-card p {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }
    </style>
  </Fragment>

  <div class="ga-page">

    <!-- ══════════════════════════════════════
         SECTION 1 — HERO
    ══════════════════════════════════════ -->
    <section class="ga-hero" id="top">
      <div class="ga-hero-inner">
        <p class="ga-eyebrow">Free · No call required · Results in 48 hours</p>
        <h1 class="ga-h1">
          Find out why your competitors are showing up first —<br class="hidden sm:block" />
          and what it takes to <em>outrank them.</em>
        </h1>
        <p class="ga-subhead">
          Submit your business info. I run a full local search analysis on your behalf — checking
          Google rankings, your Business Profile, citations, and competitor gaps — and send you a
          written report showing exactly where you stand and what to fix first. No call required.
        </p>
        <div class="ga-cta-group">
          <a href="#request" class="ga-btn-primary">Get my free analysis →</a>
          <a href="tel:+15550000000" class="ga-btn-phone">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.4a16 16 0 0 0 6.29 6.29l1.76-1.76a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Prefer to call? (555) 000-0000
          </a>
        </div>
        <p class="ga-trust-strip">
          <span class="ga-trust-dot" aria-hidden="true"></span>
          Trusted by small businesses across the US &nbsp;·&nbsp; 5.0 on Upwork &nbsp;·&nbsp; 100% Job Success
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 2 — HOW IT WORKS
    ══════════════════════════════════════ -->
    <section class="ga-section ga-how">
      <div class="ga-section-inner">
        <p class="ga-section-label">How it works</p>
        <h2 class="ga-section-title">Submit. Receive. Decide.</h2>
        <p class="ga-section-body">
          No call required to get the analysis. You fill out a short form — I do the work.
        </p>
        <div class="ga-steps">
          <div class="ga-step">
            <div class="ga-step-num">01</div>
            <h3>Submit your business info</h3>
