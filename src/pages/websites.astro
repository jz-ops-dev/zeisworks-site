<!-- ══════════════════════════════════════
     APPLICATION FORM
══════════════════════════════════════ -->
<section class="web-form-section" id="apply">
  <div class="web-form-inner">
    <p class="web-form-label">Apply for your website</p>
    <h2 class="web-form-title">Get started in 2 minutes.</h2>
    <p class="web-form-body">
      Fill out the form below. I review every application personally.<br>
      If your business is a good fit, I'll be in touch within 24 hours.
    </p>

    <form
      class="web-form"
      name="website-application"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you/"
    >
      <input type="hidden" name="form-name" value="website-application" />
      <p style="display:none;"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="web-form-row">
        <div class="web-field">
          <label for="wa-name">Your name <span aria-hidden="true">*</span></label>
          <input type="text" id="wa-name" name="name" placeholder="Jane Smith" required autocomplete="name" />
        </div>
        <div class="web-field">
          <label for="wa-email">Email address <span aria-hidden="true">*</span></label>
          <input type="email" id="wa-email" name="email" placeholder="jane@yourbusiness.com" required autocomplete="email" />
        </div>
      </div>

      <div class="web-field">
        <label for="wa-business">Business name <span aria-hidden="true">*</span></label>
        <input type="text" id="wa-business" name="business_name" placeholder="Acme Plumbing Co." required />
      </div>

      <div class="web-field">
        <label for="wa-description">What does your business do? <span aria-hidden="true">*</span></label>
        <textarea id="wa-description" name="description" placeholder="e.g. Mobile auto detailing in St. Louis. We come to the customer's location and detail their car." required></textarea>
      </div>

      <div class="web-field">
        <label for="wa-current-site">Do you have a current website?</label>
        <select id="wa-current-site" name="current_site">
          <option value="">Select the best answer</option>
          <option value="no">No website at all</option>
          <option value="outdated">Yes, but it's outdated or doesn't work well</option>
          <option value="redesign">Yes, I want a redesign</option>
          <option value="social-only">No website — just a Facebook/Instagram page</option>
        </select>
      </div>

      <div class="web-field">
        <label for="wa-hear">How did you hear about us? <span style="color: rgba(255,255,255,0.4); font-weight:400;">(optional)</span></label>
        <input type="text" id="wa-hear" name="hear" placeholder="Google search, referral, etc." />
      </div>

      <button type="submit" class="web-submit-btn">Submit my application →</button>
      <p class="web-form-disclaimer">Free to apply. No commitment. I'll review your application and respond within 24 hours.</p>
    </form>

    <p class="web-form-note">Questions? Reach Jack directly: <a href="mailto:hello@zeisworks.com" style="color: rgba(255,255,255,0.65);">hello@zeisworks.com</a></p>
  </div>
</section>

