---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="$100 Website Builds — Professional Sites for Service Businesses"
  description="Get a professional, mobile-optimized website for your service business — $100 one-time, delivered in 5 days. No monthly fees. Apply in 2 minutes."
  ogTitle="$100 Website Builds | zeisWorks"
  ogDescription="Professional websites for service businesses. $100 one-time. Mobile-optimized, SEO-ready, delivered in 5 days. No monthly fees."
>

<style>
  /* ── HERO ── */
  .web-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 2rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .web-hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 1.25rem;
  }
  .web-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .web-hero h1 em { color: var(--orange); font-style: italic; }
  .web-hero-sub {
    font-size: 1.0625rem;
    color: var(--ink-mid);
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 480px;
  }
  .web-hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .web-hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-light);
  }
  .web-hero-trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .web-hero-trust-dot {
    width: 6px; height: 6px; min-width: 6px;
    background: #4caf50;
    border-radius: 50%;
  }
  .web-hero-visual {
    background: var(--forest);
    border-radius: 18px;
    padding: 2.5rem;
    text-align: center;
  }
  .web-hero-price {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .web-hero-price-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    margin-top: 0.5rem;
    margin-bottom: 2rem;
  }
  .web-hero-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: left;
  }
  .web-hero-feature {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.85);
  }
  .web-hero-feature svg {
    width: 16px; height: 16px;
    stroke: var(--forest-light);
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  /* ── SECTION BASE ── */
  .section { padding: 5rem 2rem; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 1rem;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .section-body {
    font-size: 1rem;
    color: var(--ink-mid);
    max-width: 600px;
    line-height: 1.8;
  }

  /* ── DEMO SITES ── */
  .demos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .demo-card {
    background: var(--cream);
    border: 1px solid #E8E3D8;
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.15s;
  }
  .demo-card:hover {
    border-color: var(--terra);
    transform: translateY(-2px);
  }
  .demo-screenshot {
    aspect-ratio: 16 / 10;
    background: var(--cream-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #E8E3D8;
    overflow: hidden;
  }
  .demo-screenshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .demo-screenshot-placeholder {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .demo-info {
    padding: 1.25rem;
  }
  .demo-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .demo-industry {
    font-size: 0.75rem;
    color: var(--ink-light);
    margin-bottom: 0.5rem;
  }
  .demo-desc {
    font-size: 0.8125rem;
    color: var(--ink-mid);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .demo-link {
    font-size: 0.8125rem;
    color: var(--terra);
    text-decoration: none;
    font-weight: 500;
  }
  .demo-link:hover { text-decoration: underline; }

  /* ── WHY ── */
  .why { background: var(--forest); }
  .why .section-label { color: var(--forest-light); }
  .why .section-title { color: #fff; }
  .why .section-body { color: rgba(255,255,255,0.7); }
  .why-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
    text-align: center;
  }
  .why-stat-value {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .why-stat-label {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    margin-top: 0.5rem;
  }
  .why-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .why-point {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 18px;
    padding: 1.5rem;
  }
  .why-point h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .why-point p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    margin: 0;
  }
  .why-cta { margin-top: 2.5rem; text-align: center; }
  .btn-on-dark {
    display: inline-block;
    background: #fff;
    color: var(--ink);
    padding: 0.85rem 1.75rem;
    border-radius: 99px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.15s, background 0.15s;
  }
  .btn-on-dark:hover { background: var(--cream); transform: translateY(-1px); }

  /* ── WHAT YOU GET ── */
  .includes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .include-card {
    background: var(--cream-dark);
    border: 1px solid #E8E3D8;
    border-radius: 18px;
    padding: 1.5rem;
  }
  .include-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .include-card h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.375rem;
  }
  .include-card p {
    font-size: 0.875rem;
    color: var(--ink-mid);
    line-height: 1.65;
    margin: 0;
  }
  .includes-price {
    margin-top: 2.5rem;
    text-align: center;
    background: var(--forest);
    border-radius: 18px;
    padding: 2rem;
  }
  .includes-price-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 0.5rem;
  }
  .includes-price-value {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .includes-price-sub {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.6);
    margin-top: 0.5rem;
  }
  .includes-price-note {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.45);
    margin-top: 0.75rem;
  }

  /* ── HOW ── */
  .how { background: var(--cream-dark); }
  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .how-step-num {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 600;
    color: var(--cream);
    line-height: 1;
    margin-bottom: -0.5rem;
    letter-spacing: -0.03em;
    -webkit-text-stroke: 1.5px var(--forest-light);
  }
  .how-step h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .how-step p {
    font-size: 0.9375rem;
    color: var(--ink-mid);
    line-height: 1.7;
    margin: 0;
  }

  /* ── PROOF ── */
  .web-proof .proof-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.5rem;
    background: rgba(242, 238, 228, 0.5);
    border-top: 1px solid #E8E3D8;
    border-bottom: 1px solid #E8E3D8;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-mid);
    text-align: center;
  }
  .web-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .web-tcard {
    background: var(--cream);
    border: 1px solid #E8E3D8;
    border-radius: 18px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .web-tcard-stars {
    color: var(--orange);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .web-tcard-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.75;
    flex: 1;
    margin: 0;
  }
  .web-tcard-divider {
    border-top: 1px solid #E8E3D8;
    margin: 1rem 0;
  }
  .web-tcard-name {
    font-weight: 600;
    color: var(--ink);
    font-size: 0.875rem;
    margin: 0;
  }
  .web-tcard-title {
    font-size: 0.75rem;
    color: var(--ink-light);
    margin: 0.125rem 0 0;
  }

  /* ── FORM ── */
  .web-form-section {
    background: var(--forest);
    padding: 5rem 2rem;
  }
  .web-form-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .web-form-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .web-form-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    text-align: center;
  }
  .web-form-body {
    font-size: 1rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.75;
    margin-bottom: 2.5rem;
    text-align: center;
  }
  .web-form {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .web-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .web-field label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.02em;
  }
  .web-field label span { color: var(--orange); margin-left: 2px; }
  .web-field input,
  .web-field textarea,
  .web-field select {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: #fff;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
  }
  .web-field input::placeholder,
  .web-field textarea::placeholder {
    color: rgba(255,255,255,0.3);
  }
  .web-field input:focus,
  .web-field textarea:focus,
  .web-field select:focus {
    border-color: rgba(255,255,255,0.45);
    background: rgba(255,255,255,0.12);
  }
  .web-field textarea { resize: vertical; min-height: 80px; }
  .web-field select option { background: #1e2e1e; color: #fff; }
  .web-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .web-submit-btn {
    background: var(--orange);
    color: #fff;
    border: none;
    padding: 0.9rem 2rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    width: 100%;
    font-family: inherit;
    margin-top: 0.5rem;
  }
  .web-submit-btn:hover { background: #a8511f; transform: translateY(-1px); }
  .web-form-disclaimer {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
    text-align: center;
    line-height: 1.6;
    margin-top: 0.25rem;
  }
  .web-form-note {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.45);
    text-align: center;
    margin-top: 1.5rem;
  }

  /* ── FAQ ── */
  .web-faq-list {
    margin-top: 2.5rem;
    border-top: 1px solid #E8E3D8;
  }
  .web-faq-item {
    padding: 1.375rem 0;
    border-bottom: 1px solid #E8E3D8;
  }
  .web-faq-q {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }
  .web-faq-a {
    font-size: 0.9rem;
    color: var(--ink-mid);
    line-height: 1.75;
    margin: 0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .web-hero { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 1.5rem 2.5rem; }
    .demos-grid { grid-template-columns: 1fr; }
    .why-stats { grid-template-columns: 1fr; gap: 1.5rem; }
    .why-points { grid-template-columns: 1fr; }
    .includes-grid { grid-template-columns: 1fr; }
    .how-steps { grid-template-columns: 1fr; }
    .web-testimonials-grid { grid-template-columns: 1fr; }
    .web-form-row { grid-template-columns: 1fr; }
  }
</style>

<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<section class="web-hero">
  <div>
    <p class="web-hero-eyebrow">Websites for service businesses</p>
    <h1>
      A professional website<br>
      <em>for $100.</em> Done in 5 days.
    </h1>
    <p class="web-hero-sub">
      Built for service businesses that need to look legit online — without the $5,000 agency price tag. Mobile-optimized, SEO-ready, and designed to get you more calls.
    </p>
    <div class="web-hero-actions">
      <a href="#apply" class="btn-primary" style="background: var(--orange);">Apply for your website →</a>
    </div>
    <div class="web-hero-trust">
      <span class="web-hero-trust-item"><span class="web-hero-trust-dot" aria-hidden="true"></span> 5.0 on Upwork</span>
      <span class="web-hero-trust-item"><span class="web-hero-trust-dot" aria-hidden="true"></span> 100+ sites built</span>
      <span class="web-hero-trust-item"><span class="web-hero-trust-dot" aria-hidden="true"></span> 5-day delivery</span>
    </div>
  </div>
  <div>
    <div class="web-hero-visual">
      <div class="web-hero-price">$100</div>
      <div class="web-hero-price-sub">one-time payment</div>
      <div class="web-hero-features">
        <div class="web-hero-feature">
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          Custom design (not a template)
        </div>
        <div class="web-hero-feature">
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          Mobile-optimized
        </div>
        <div class="web-hero-feature">
          <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
