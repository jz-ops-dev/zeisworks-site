---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Here's your checklist | zeisWorks"
  description="Your Local Search Visibility Checklist is ready. Download it below."
  ogTitle="Your checklist is ready | zeisWorks"
  ogDescription="Download your 25-point Local Search Visibility Checklist."
>

<style>
  .ty-wrap {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background: var(--forest);
  }
  .ty-inner {
    max-width: 520px;
    text-align: center;
  }
  .ty-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  .ty-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-light, #7db89a);
    margin-bottom: 1rem;
  }
  .ty-h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .ty-h1 em { font-style: italic; color: var(--terra-light, #e8a87c); }
  .ty-body {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .ty-btn-download {
    display: inline-block;
    background: var(--terra);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    margin-bottom: 1.5rem;
  }
  .ty-btn-download:hover { background: var(--terra-dark, #c0622a); transform: translateY(-1px); }
  .ty-divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 2rem 0;
  }
  .ty-next-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 0.75rem;
  }
  .ty-next-text {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .ty-btn-analysis {
    display: inline-block;
    background: transparent;
    color: #fff;
    padding: 0.75rem 1.75rem;
    border-radius: 0.625rem;
    border: 1px solid rgba(255,255,255,0.3);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .ty-btn-analysis:hover { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.05); }
</style>

<div class="ty-wrap">
  <div class="ty-inner">
    <div class="ty-icon">✅</div>
    <p class="ty-eyebrow">Your checklist is ready</p>
    <h1 class="ty-h1">Here's the <em>25-point</em><br>Local Search Checklist</h1>
    <p class="ty-body">
      Click below to download your PDF. Work through it in 20 minutes and you'll know exactly where your gaps are.
    </p>
    <a href="/local-search-checklist.pdf" download="local-search-visibility-checklist.pdf" class="ty-btn-download">
      Download the checklist (PDF) →
    </a>

    <hr class="ty-divider" />

    <p class="ty-next-label">Want to know how you actually score?</p>
    <p class="ty-next-text">
      The checklist tells you what to look for. The free gap analysis tells you exactly where you stand — with a written report on your rankings, GBP gaps, and how you compare to your top competitors. Delivered within 12 hours.
    </p>
    <button type="button" data-modal="gap-analysis" class="ty-btn-analysis" style="cursor:pointer;">Get my free gap analysis →</button>
  </div>
</div>

</BaseLayout>
