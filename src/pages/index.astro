---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';

const allGuides = await getCollection('guides');
const recentGuides = allGuides
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="ZeisWorks"
  description="Operations and Salesforce consulting for businesses that already work. Jack Zeis, Golden CO."
>
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-ink-light mb-6">
      ZeisWorks
    </p>
    <h1 class="font-serif text-5xl sm:text-6xl font-bold leading-tight mb-8">
      Operations that<br />
      <em class="italic">actually work.</em>
    </h1>
    <p class="text-lg text-ink-mid leading-relaxed max-w-xl mb-10">
      Jack Zeis helps small and mid-size businesses fix the operations problems that have
      been slowing them down for months. Salesforce, process gaps, reporting that requires
      Excel — send it.
    </p>
    <a
      href="/#contact"
      class="inline-block bg-navy text-cream px-6 py-3 rounded-lg hover:bg-navy/90 transition-colors font-medium"
    >
      Free diagnosis →
    </a>
  </section>

  {
    recentGuides.length > 0 && (
      <section class="max-w-3xl mx-auto px-6 py-16 border-t border-cream-dark">
        <div class="flex items-center justify-between mb-10">
          <h2 class="font-serif text-2xl font-bold">Recent guides</h2>
          <a
            href="/guides/"
            class="text-sm text-ink-mid hover:text-ink transition-colors"
          >
            All guides →
          </a>
        </div>
        <div class="grid gap-10">
          {recentGuides.map((guide) => (
            <GuideCard
              title={guide.data.title}
              description={guide.data.description}
              publishDate={guide.data.publishDate}
              readingTime={guide.data.readingTime}
              slug={guide.id}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
