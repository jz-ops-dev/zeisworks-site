---
import LandingLayout from '../layouts/LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import VideoHero from '../components/VideoHero.astro';

// ── Animation A (hero): scattered knowledge fragments that settle into a
// clean stack of plain-text files. Authored positions (%/deg) and a fly-out
// vector per chip so each fragment drifts toward the stack and fades. ──
const heroChips = [
  { label: 'spreadsheet cell', top: 4,  left: 6,  r: -8,  tx: 60,  ty: 40 },
  { label: 'chat bubble',      top: 2,  left: 58, r: 7,   tx: -40, ty: 60 },
  { label: 'CRM record',       top: 20, left: 30, r: -4,  tx: 10,  ty: 30 },
  { label: 'sticky note',      top: 16, left: 74, r: 10,  tx: -70, ty: 40 },
  { label: 'email',            top: 34, left: 4,  r: 5,   tx: 70,  ty: 10 },
  { label: 'person',           top: 30, left: 50, r: -9,  tx: -10, ty: 20 },
  { label: 'runbook',          top: 46, left: 22, r: 6,   tx: 30,  ty: -10 },
  { label: 'dashboard tile',   top: 44, left: 66, r: -7,  tx: -50, ty: 0 },
  { label: 'metric',           top: 60, left: 8,  r: -5,  tx: 60,  ty: -30 },
  { label: 'process step',     top: 64, left: 44, r: 8,   tx: 0,   ty: -40 },
  { label: 'inbox thread',     top: 58, left: 72, r: -10, tx: -60, ty: -20 },
  { label: 'note',             top: 78, left: 32, r: 4,   tx: 20,  ty: -60 },
];

// Animation A resting state: the scattered fragments assemble into a short
// "written down" document. Plain-language business rules, not file names, so
// the effect reads as chaos becoming clear words (per Jack's request).
const heroDocTitle = 'Your business, written down';
const heroDocLines = [
  'A customer is anyone who bought in the last 12 months.',
  'We price by the project, not the hour.',
  'Every lead gets a reply within one business day.',
];

// ── The shift: two cards (the principle + the method). Source URLs from
// dev prompt section 8. OKF was dropped in the v2 spec. ──
const SRC = {
  karpathy: { href: '#', confirm: true },
  icm: { href: 'https://arxiv.org/abs/2603.16021', confirm: false },
};

const shiftCards = [
  {
    tag: 'The principle',
    title: 'The LLM wiki',
    body: 'A leading AI researcher, Andrej Karpathy, showed that keeping your knowledge in plain, readable files the AI reads directly just works. The idea spread fast.',
    src: SRC.karpathy,
  },
  {
    tag: 'The method',
    title: 'Interpretable Context Methodology',
    body: 'Researchers turned that idea into a method: organize the files so the AI always reads the right ones for the task, and you can trace every answer back to a file.',
    src: SRC.icm,
  },
];

const steps = [
  { n: '01', title: 'Audit', body: 'We look at how your business actually runs and where the knowledge lives today.' },
  { n: '02', title: 'Write it down', body: 'We write it down as clean, organized files. The things that rarely change in one place, the day-to-day work in another.' },
  { n: '03', title: 'Build', body: 'We add the AI assistants and automations on top, tested on your real cases, with a person signing off before anything goes live.' },
  { n: '04', title: 'Hand off', body: 'You keep the whole thing. Easy to read, easy to edit, and yours to take anywhere. We can stay on to help or step back.' },
];

const layers = [
  { name: 'identity', desc: 'who you are' },
  { name: 'routing', desc: 'what to read when' },
  { name: 'reference', desc: 'stable knowledge' },
  { name: 'working', desc: 'live outputs' },
];

const modelChips = ['a current model', 'the next one', "whatever's best"];

// ── The three classical appeals, each mapped to what ICM makes the AI
// actually do. Drives Animation E (three appeals converge into one method). ──
const appeals = [
  { greek: 'Ethos', gloss: 'Credibility — authority that’s sourced, not asserted.', maps: 'Identity + traceability' },
  { greek: 'Pathos', gloss: 'The felt experience — confidence that’s earned, not performed.', maps: 'Working outputs' },
  { greek: 'Logos', gloss: 'Reason and evidence — logic you can inspect, not hidden.', maps: 'Routing + reference' },
];

// ── Interactive routing layer: each rule in routing.md opens the file the AI
// actually reads for that kind of question. File contents are illustrative
// placeholders, ready to swap for a real client's files. ──
const routes = [
  {
    key: 'pricing',
    path: 'reference/pricing.md',
    lines: [
      '# Pricing',
      'We price by the project, not the hour.',
      'A quote holds for 30 days.',
      "Discounts over 10% need a manager's ok.",
    ],
  },
  {
    key: 'refund',
    path: 'reference/refund-policy.md',
    lines: [
      '# Refund policy',
      'window: 30 days from delivery',
      'exceptions: final-sale, custom orders',
      'after 30 days: store credit only',
    ],
  },
  {
    key: 'tone & voice',
    path: 'identity.md',
    lines: [
      '# Tone & voice',
      'Plain, warm, direct. No hype.',
      'Say "we", not "the company".',
      "Never promise what we can't ship.",
    ],
  },
  {
    key: 'escalation',
    path: 'working/handoffs.md',
    lines: [
      '# Escalation',
      'Loop in a human for money or complaints.',
      'Tag the owner within one business day.',
      'Never guess on legal or refunds.',
    ],
  },
];
---

<LandingLayout
  title="ZeisWorks · VIK — Visualized Institutional Knowledge"
  description="Institutional knowledge lives in people's heads and walks out the door when they do. ZeisWorks builds your VIK — Visualized Institutional Knowledge: a living system that holds how your business runs and keeps working when your people move on."
  ogImage="/og.png"
>
  <span id="top" aria-hidden="true"></span>

  <!-- ═══════════════════ HERO (VIK video) ═══════════════════ -->
  <VideoHero>
    <div class="max-w-[640px]">
      <p class="zw-eyebrow mb-4" style="color: var(--zw-rust-soft);">Visualized Institutional Knowledge</p>
      <h1
        class="font-serif font-semibold text-white text-balance"
        style="font-size: clamp(2.05rem, 6vw, 3.45rem); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 22px;"
      >
        Your institutional knowledge shouldn't <em style="color: var(--zw-rust-soft);">walk out the door.</em>
      </h1>
      <p class="text-white/85 mb-8" style="font-size: clamp(1.05rem, 1.9vw, 1.3rem); line-height: 1.55; max-width: 54ch;">
        We build your <strong class="text-white font-semibold">VIK</strong> &mdash; Visualized
        Institutional Knowledge: a living system that holds how your business actually runs, so it
        stays when your people don't.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <AuditCta
          location="hero"
          label="Book a call"
          class="inline-flex items-center justify-center gap-2 bg-zw-teal text-white font-semibold px-7 py-3.5 rounded-full hover:bg-zw-rust transition-colors"
        />
        <a
          href="#vik"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-medium text-white border border-white/45 hover:bg-white/10 transition-colors"
        >
          What's a VIK?
        </a>
      </div>
    </div>
  </VideoHero>

  <!-- ═══════════════════ VIK — WHAT YOU OWN ═══════════════════ -->
  <section id="vik" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8 max-w-[820px]">
      <p class="zw-eyebrow mb-4 zw-reveal">What you own</p>
      <h2 class="zw-h2 mb-6 zw-reveal">VIK &mdash; Visualized Institutional Knowledge.</h2>
      <p class="text-zw-muted max-w-[640px] mb-8 zw-reveal text-pretty">
        Your VIK is the working system you keep when the engagement ends &mdash; not a slide, not a
        diagram. It holds how your business actually runs and does work with it: it researches,
        drafts, and answers, all from knowledge you can read and edit.
      </p>
      <div class="zw-vik-plate zw-reveal">
        <span class="zw-vik-tag zw-mono">VIK</span>
        <p class="zw-vik-thesis">
          Tools depreciate. Context compounds. ICM is how we compound it.
          <strong>VIK is what you own when we're done.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ THE PROBLEM ═══════════════════ -->
  <section id="the-problem" class="zw-anchor zw-section border-t border-zw-border">
    <div class="zw-wrap px-5 sm:px-8 max-w-[760px]">
      <p class="zw-eyebrow mb-4 zw-reveal">The problem</p>
      <h2 class="zw-h2 mb-7 zw-reveal">Turning AI on is easy. Trusting it is the hard part.</h2>
      <div class="space-y-5 text-zw-muted zw-reveal">
        <p>
          Anyone can switch on an AI tool today. Getting it to answer correctly about your business
          is the real work. When the AI can't see how you actually define a customer, price a job,
          or run a process, it guesses. And it guesses wrong in ways that are expensive to catch.
        </p>
        <p>
          The worst part isn't the wrong answer. It's that you can't tell why it happened, so you
          can't fix it. One bad answer and people quietly stop trusting the tool.
        </p>
        <p class="text-zw-ink font-medium">
          The problem was never the AI. It's that what it needed to know was never written down
          anywhere it could read.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ THE SHIFT ═══════════════════ -->
  <section id="the-shift" class="zw-anchor zw-section bg-white/40 border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">Why now</p>
      <h2 class="zw-h2 mb-6 max-w-[820px] zw-reveal">The fix is a pattern the industry is converging on.</h2>
      <p class="text-zw-muted max-w-[760px] mb-12 zw-reveal">
        Instead of paying to build a separate AI tool for every task, the smartest teams now do
        something simpler. They write down how the business works in plain, readable files, the
        same files the AI reads to answer. A person can check them, the AI follows them, and when
        something's off you fix the file, not the whole system.
      </p>

      <div class="grid md:grid-cols-2 gap-5 max-w-[820px]">
        {shiftCards.map((card) => (
          <article class="zw-card zw-reveal flex flex-col">
            <p class="zw-eyebrow text-[0.7rem] mb-3">{card.tag}</p>
            <h3 class="zw-h3 mb-3">{card.title}</h3>
            <p class="text-sm text-zw-muted leading-relaxed flex-1">{card.body}</p>
            <p class="mt-4">
              <a
                href={card.src.href}
                target="_blank"
                rel="noopener"
                class="text-sm font-medium text-zw-teal hover:underline"
              >[source]{card.src.confirm && <sup class="zw-confirm-inline">CONFIRM</sup>}</a>
            </p>
          </article>
        ))}
      </div>

      <!-- Animation C: plain text, read by both -->
      <div class="mt-12 zw-reveal">
        <div data-anim="bothread" class="zw-bothread mx-auto max-w-[640px]">
          <div class="zw-bothread-labels">
            <span class="zw-bothread-label zw-bothread-label--l">your team reads this</span>
            <span class="zw-bothread-label zw-bothread-label--r">your AI reads this</span>
          </div>
          <div class="zw-knowledge zw-mono" role="img" aria-label="A plain-text knowledge file that both a person and an AI can read.">
            <div class="zw-knowledge-bar">
              <span class="zw-dot"></span><span class="zw-dot"></span><span class="zw-dot"></span>
              <span class="ml-3 text-[0.72rem] text-zw-muted">knowledge.md</span>
            </div>
            <pre class="zw-knowledge-body"><span class="zw-kline"># Refund policy</span>
<span class="zw-kline">window: 30 days from delivery</span>
<span class="zw-kline">exceptions: final-sale, custom orders</span></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ THE THREE APPEALS → ICM ═══════════════════ -->
  <section id="icm-appeals" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">The method, in three appeals</p>
      <h2 class="zw-h2 mb-6 max-w-[820px] zw-reveal">Three ways to be believed. One method that earns all three.</h2>
      <p class="text-zw-muted max-w-[760px] mb-12 zw-reveal">
        Rhetoric has persuaded people for two thousand years with three appeals. Our Interpretable
        Context Methodology turns each one into something the AI actually does — so trust is built
        into the structure, not performed on top of it.
      </p>

      <!-- Animation E: the three appeals converge into one method (ICM) -->
      <div data-anim="appeals" class="zw-appeals" aria-label="Ethos, pathos, and logos each map to a part of the Interpretable Context Methodology.">
        <div class="zw-appeals-grid">
          {appeals.map((a, i) => (
            <div class="zw-appeal" style={`--i:${i};`}>
              <p class="zw-appeal-greek">{a.greek}</p>
              <p class="zw-appeal-gloss">{a.gloss}</p>
              <span class="zw-appeal-trace" aria-hidden="true"></span>
              <p class="zw-appeal-maps zw-mono">{a.maps}</p>
              <span class="zw-appeal-connector" aria-hidden="true"></span>
            </div>
          ))}
        </div>
        <div class="zw-appeals-icm">
          <span class="zw-appeals-icm-tag zw-mono">ICM</span>
          <span class="zw-appeals-icm-text">
            Interpretable Context Methodology — every answer traces back to a file you can read and edit.
          </span>
        </div>

        <p class="zw-appeals-sample-lead">Pick a question to open the file the AI reads:</p>
        <div class="zw-router" data-router>
          <!-- The routing layer: each rule is a tab that opens its target file. -->
          <figure class="zw-knowledge zw-mono zw-router-index">
            <div class="zw-knowledge-bar">
              <span class="zw-dot"></span><span class="zw-dot"></span><span class="zw-dot"></span>
              <span class="ml-3 text-[0.72rem] text-zw-muted">routing.md</span>
              <span class="zw-sample-tag">production layer</span>
            </div>
            <div class="zw-router-list" role="tablist" aria-label="Routing rules: choose a question type to open the file the AI reads">
              <p class="zw-router-comment"># the AI reads the right file for each question</p>
              {routes.map((r, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`zw-route-${i}`}
                  class="zw-route"
                  aria-controls={`zw-file-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                  data-i={i}
                >
                  <span class="zw-route-key">{r.key}</span>
                  <span class="zw-route-arrow" aria-hidden="true">→</span>
                  <span class="zw-route-path">{r.path}</span>
                </button>
              ))}
            </div>
          </figure>

          <!-- The opened file: contents the AI reads for that question. -->
          <div class="zw-router-files">
            {routes.map((r, i) => (
              <figure
                class="zw-knowledge zw-mono zw-router-file"
                id={`zw-file-${i}`}
                role="tabpanel"
                aria-labelledby={`zw-route-${i}`}
                tabindex="0"
                hidden={i !== 0}
              >
                <div class="zw-knowledge-bar">
                  <span class="zw-dot"></span><span class="zw-dot"></span><span class="zw-dot"></span>
                  <span class="ml-3 text-[0.72rem] text-zw-muted">{r.path}</span>
                  <span class="zw-sample-tag">the AI reads this</span>
                </div>
                <pre class="zw-knowledge-body">{r.lines.map((ln) => (<span class="zw-kline">{ln}</span>))}</pre>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var router = document.querySelector('[data-router]');
      if (!router) return;
      var tabs = Array.prototype.slice.call(router.querySelectorAll('[role="tab"]'));
      var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute('aria-controls')); });
      function select(idx, focus) {
        tabs.forEach(function (t, i) {
          var on = i === idx;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          if (panels[i]) panels[i].hidden = !on;
        });
        if (focus && tabs[idx]) tabs[idx].focus();
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () { select(i); });
        t.addEventListener('keydown', function (e) {
          var n;
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          else return;
          e.preventDefault();
          select(n, true);
        });
      });
    })();
  </script>

  <!-- ═══════════════════ WHAT WE BUILD ═══════════════════ -->
  <section id="what-we-build" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal" style="color:#F0A184;">What we build</p>
      <h2 class="zw-h2 mb-12 max-w-[860px] zw-reveal text-zw-cream">We get your knowledge in order first, then build the tools that use it.</h2>

      <!-- Two main offers carry the visual weight. -->
      <div class="grid md:grid-cols-2 gap-5">
        <article class="zw-card-dark zw-reveal">
          <h3 class="zw-h3 mb-3 text-white">Your business, written down</h3>
          <p class="text-[0.95rem] leading-relaxed text-zw-cream/75">
            We write down how your business actually works: how you define things, price things, and
            run things, all in plain files your team and your AI can both read. One place that holds
            the real answers, instead of knowledge scattered across dashboards, inboxes, and
            people's heads.
          </p>
        </article>
        <article class="zw-card-dark zw-reveal">
          <h3 class="zw-h3 mb-3 text-white">The tools that run on it</h3>
          <p class="text-[0.95rem] leading-relaxed text-zw-cream/75">
            Once your knowledge is in place, we build the AI assistants and automations that use it.
            Sales and customer work, finding new customers, reporting, and the busywork in between.
            Each one is tested on your real cases, with a person reviewing the work before anything
            goes live where it counts.
          </p>
        </article>
      </div>

      <p class="mt-8 text-sm text-zw-cream/60 max-w-[760px] zw-reveal">
        Everything we build is yours to keep. It's all in plain writing you can read and edit, with
        nothing locking you in. Switch tools or AI providers next year without starting over.
      </p>
    </div>
  </section>

  <!-- ═══════════════════ HOW IT WORKS ═══════════════════ -->
  <section id="how-it-works" class="zw-anchor zw-section border-b border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">How it works</p>
      <h2 class="zw-h2 mb-12 max-w-[760px] zw-reveal">Four steps. Plain language the whole way.</h2>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16 items-start">
        <!-- Steps -->
        <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-y-8 gap-x-6">
          {steps.map((s) => (
            <li class="zw-reveal flex gap-4">
              <span class="zw-mono text-zw-teal text-sm font-medium pt-1 shrink-0">{s.n}</span>
              <div>
                <h3 class="zw-h3 mb-1.5">{s.title}</h3>
                <p class="text-sm text-zw-muted leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <!-- Animation B: layered context loading -->
        <div class="zw-reveal lg:sticky lg:top-24" aria-hidden="true">
          <div data-anim="layers" class="zw-layers">
            {layers.map((l, i) => (
              <div class={`zw-layer${i === layers.length - 1 ? ' zw-layer-last' : ''}`} style={`--i:${i};`}>
                <span class="zw-scan"></span>
                <span class="zw-mono text-sm font-medium">{l.name}</span>
                <span class="text-xs text-zw-muted">{l.desc}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs text-zw-muted text-center zw-mono">the right files at the right step</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ WHY IT LASTS ═══════════════════ -->
  <section id="why-it-lasts" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center">
        <div class="max-w-[620px]">
          <p class="zw-eyebrow mb-4 zw-reveal">Built to last</p>
          <h2 class="zw-h2 mb-6 zw-reveal">AI changes every few months. What you've written down doesn't have to.</h2>
          <p class="text-zw-muted zw-reveal">
            Because your knowledge lives in plain files and not buried inside one AI tool, you don't
            rebuild every time something new comes out. The same files work with whatever AI is best
            next year, and they cost less to run, since the AI only reads what it needs. That's the
            difference between renting a tool and owning something that keeps working.
          </p>
        </div>

        <!-- Animation D: model swap -->
        <div class="zw-reveal" aria-hidden="true">
          <div data-anim="model-swap" class="zw-swap mx-auto max-w-[360px]">
            <div class="zw-swap-slot">
              {modelChips.map((m, i) => (
                <span class={`zw-model-chip zw-mono${i === 0 ? ' zw-chip-on' : ''}`}>{m}</span>
              ))}
            </div>
            <span class="zw-swap-connector"></span>
            <div class="zw-swap-layer">
              <svg width="16" height="18" viewBox="0 0 14 16" fill="none" aria-hidden="true" class="text-zw-teal">
                <path d="M2 1h6l4 4v10H2V1z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M8 1v4h4" stroke="currentColor" stroke-width="1.2"/>
              </svg>
              <span class="zw-mono text-sm font-medium">your business, written down</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PROOF (CONFIRM) ═══════════════════ -->
  <section id="proof" class="zw-anchor zw-section bg-white/40 border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">Proof</p>
      <h2 class="zw-h2 mb-3 zw-reveal">
        <span class="zw-confirm">CONFIRM</span> heading
      </h2>
      <p class="text-sm text-zw-muted mb-10 max-w-[680px] zw-reveal">
        Placeholder for Jack: supply two or three real client outcomes (Zeis Group, Lift-STL, or
        M&amp;Q as appropriate). No invented names, quotes, or numbers.
      </p>
      <div class="grid md:grid-cols-3 gap-5">
        {[0, 1, 2].map(() => (
          <article class="zw-card zw-reveal border-dashed">
            <p class="zw-eyebrow text-[0.7rem] mb-3"><span class="zw-confirm">CONFIRM</span> client</p>
            <p class="text-sm text-zw-muted leading-relaxed mb-3">One-line problem goes here.</p>
            <p class="text-sm font-medium text-zw-ink">One-line outcome goes here.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ START / PRICING + CTA ═══════════════════ -->
  <section id="start" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8 max-w-[760px] text-center">
      <p class="zw-eyebrow mb-4 zw-reveal" style="color:#F0A184;">Get started</p>
