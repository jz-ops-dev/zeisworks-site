---
import LandingLayout from '../layouts/LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import FileExplorer from '../components/FileExplorer.astro';
import OfferLadder from '../components/OfferLadder.astro';
import Testimonials from '../components/Testimonials.astro';


// ── The shift: two cards (the principle + the method). Source URLs from
// dev prompt section 8. OKF was dropped in the v2 spec. ──
// Karpathy source link removed until the canonical URL is confirmed (CO-001
// D2) — a missing link reads better than a dead one.
const SRC = {
  karpathy: { href: null },
  icm: { href: 'https://arxiv.org/abs/2603.16021' },
};

const shiftCards = [
  {
    tag: 'The principle',
    title: 'The LLM wiki',
    body: 'A leading AI researcher, Andrej Karpathy, showed that keeping your knowledge in plain, readable files the AI reads directly just works. The idea spread fast.',
    src: SRC.karpathy,
  },
  {
    tag: 'The method',
    title: 'Interpretable Context Methodology',
    body: 'Researchers turned that idea into a method: organize the files so the AI always reads the right ones for the task, and you can trace every answer back to a file.',
    src: SRC.icm,
  },
];

const steps = [
  { n: '01', title: 'Map', body: 'We look at how your business actually runs and where the knowledge lives today.' },
  { n: '02', title: 'Write it down', body: 'We write it down as clean, organized files. The things that rarely change in one place, the day-to-day work in another.' },
  { n: '03', title: 'Build', body: 'We add the AI assistants and automations on top, tested on your real cases, with a person signing off before anything goes live.' },
  { n: '04', title: 'Hand off', body: 'You keep the whole thing. Easy to read, easy to edit, and yours to take anywhere. We can stay on to help or step back.' },
];

const layers = [
  { name: 'identity', desc: 'who you are' },
  { name: 'routing', desc: 'what to read when' },
  { name: 'reference', desc: 'stable knowledge' },
  { name: 'working', desc: 'live outputs' },
];

const modelChips = ['a current model', 'the next one', "whatever's best"];

// ── Interactive routing layer: each rule in routing.md opens the file the AI
// actually reads for that kind of question. File contents are illustrative
// placeholders, ready to swap for a real client's files. ──
const routes = [
  {
    key: 'pricing',
    path: 'reference/pricing.md',
    lines: [
      '# Pricing',
      'We price by the project, not the hour.',
      'A quote holds for 30 days.',
      "Discounts over 10% need a manager's ok.",
    ],
  },
  {
    key: 'refund',
    path: 'reference/refund-policy.md',
    lines: [
      '# Refund policy',
      'window: 30 days from delivery',
      'exceptions: final-sale, custom orders',
      'after 30 days: store credit only',
    ],
  },
  {
    key: 'tone & voice',
    path: 'identity.md',
    lines: [
      '# Tone & voice',
      'Plain, warm, direct. No hype.',
      'Say "we", not "the company".',
      "Never promise what we can't ship.",
    ],
  },
  {
    key: 'escalation',
    path: 'working/handoffs.md',
    lines: [
      '# Escalation',
      'Loop in a human for money or complaints.',
      'Tag the owner within one business day.',
      'Never guess on legal or refunds.',
    ],
  },
];
---

<LandingLayout
  title="ZeisWorks · AI that answers like it works at your firm"
  description="Your firm runs on what your people know — and your AI has never read a word of it. ZeisWorks writes how your firm actually works into plain files your team and your AI both read, so the guessing stops and the knowledge stays when people leave."
  ogImage="/og.png"
>
  <span id="top" aria-hidden="true"></span>

  <!-- ═══════════════════ HERO (split: copy + VIK video) ═══════════════════ -->
  <!-- overflow-x: clip contains the decorative glow's horizontal bleed
       (it caused a 1px document overflow at narrow widths) without
       clipping vertically or creating a scroll container. -->
  <section class="zw-hero-split bg-zw-cream border-b border-zw-border" style="overflow-x: clip;">
    <div class="zw-wrap px-5 sm:px-8 zw-hero-grid">
      <div>
        <p class="zw-eyebrow mb-4 zw-reveal" style="color: var(--zw-rust);">For firms that run on expertise</p>
        <h1 class="zw-h1 text-zw-ink mb-6 zw-reveal">
          Your firm runs on what your people know.
          <em style="color: var(--zw-teal);">Your AI has never read a word of it.</em>
        </h1>
        <p class="zw-lede mb-8 zw-reveal" style="max-width: 52ch;">
          So it guesses. Wrong numbers, generic drafts, confident answers nobody trusts. We write
          how your firm actually works into plain files your team and your AI both read. The
          guessing stops, and the knowledge stays when people leave.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 zw-reveal">
          <AuditCta
            location="hero"
            label="Book a free intro call"
            class="inline-flex items-center justify-center gap-2 bg-zw-teal text-white font-semibold px-7 py-3.5 rounded-full hover:bg-zw-rust transition-colors"
          />
          <a
            href="#demo"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-medium text-zw-ink border border-zw-ink/15 hover:bg-zw-ink/[0.04] transition-colors"
          >
            See it working
          </a>
        </div>
      </div>
      <div class="zw-hero-media zw-reveal">
        <div class="zw-hero-glow" data-parallax="0.1" aria-hidden="true"></div>
        <div class="zw-hero-frame">
          <!-- Static poster underneath the video covers every failure state:
               JS disabled, reduced motion, and blocked autoplay. -->
          <picture class="zw-hero-poster" aria-hidden="true">
            <source srcset="/intro-poster.webp" type="image/webp" />
            <img src="/intro-poster.jpg" alt="" loading="eager" decoding="async" />
          </picture>
          <video class="zw-hero-video" muted loop playsinline preload="metadata" poster="/intro-poster.webp" aria-hidden="true">
            <source src="/intro.webm" type="video/webm" />
            <source src="/intro.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.zw-hero-video').forEach(function (v) {
        v.addEventListener('playing', function () { v.classList.add('is-playing'); }, { once: true });
        var p = v.play();
        if (p && typeof p.catch === 'function') p.catch(function () {});
      });
    })();
  </script>

  <!-- ═══════════════════ ANTI-POSITIONING STRIP ═══════════════════ -->
  <section class="zw-strip bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8 text-center">
      <p class="zw-strip-line zw-reveal">
        We don't sell chatbots. We make the AI you already pay for answer like it works at
        your firm.
      </p>
    </div>
  </section>

  <!-- ═══════════════════ THE PROBLEM ═══════════════════ -->
  <section id="the-problem" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
      <p class="zw-eyebrow mb-4 zw-reveal">The problem</p>
      <h2 class="zw-h2 mb-8 zw-reveal">Turning AI on is easy. Trusting it is the hard part.</h2>
      <div class="space-y-6 text-zw-muted zw-reveal">
        <p>
          Anyone can switch on an AI tool today. Getting it to answer correctly about your business
          is the real work. When the AI can't see how you actually define a customer, price a job,
          or run a process, it guesses. And it guesses wrong in ways that are expensive to catch.
        </p>
        <p>
          The worst part isn't the wrong answer. It's that you can't tell why it happened, so you
          can't fix it. One bad answer and people quietly stop trusting the tool.
        </p>
        <p class="text-zw-ink font-medium">
          The problem was never the AI. It's that what it needed to know was never written down
          anywhere it could read.
        </p>
        <p>
          The fix is simpler than another tool: write down how the business works in plain,
          readable files &mdash; the same files the AI reads to answer. A person can check them,
          the AI follows them, and when something's off you fix the file, not the whole system.
        </p>
      </div>
    </div></div>
  </section>

  <!-- ═══════════════════ WHO IT'S FOR ═══════════════════ -->
  <section id="who" class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">Who it's for</p>
      <h2 class="zw-h2 mb-8 zw-reveal">Built for firms where knowledge is the product.</h2>
      <div class="grid md:grid-cols-2 gap-5">
        <a href="/for/consulting-firms/" class="zw-card zw-card-link zw-reveal flex flex-col">
          <h3 class="zw-h3 mb-3">Consulting and advisory firms</h3>
          <p class="text-sm text-zw-muted leading-relaxed flex-1">
            Your methodology is the product. We write it into plain files your team and your AI
            both read, so proposals, answers, and onboarding come from your playbook instead of
            guesses.
          </p>
          <p class="mt-4 text-sm font-medium text-zw-teal">ZeisWorks for consulting firms →</p>
        </a>
        <a href="/for/agencies/" class="zw-card zw-card-link zw-reveal flex flex-col">
          <h3 class="zw-h3 mb-3">Agencies and studios</h3>
          <p class="text-sm text-zw-muted leading-relaxed flex-1">
            Client context lives in Slack scrollback and account leads' heads. We write it into
            plain files, so AI drafts sound like the client and handoffs survive turnover.
          </p>
          <p class="mt-4 text-sm font-medium text-zw-teal">ZeisWorks for agencies →</p>
        </a>
      </div>
      <p class="mt-8 text-sm text-zw-muted zw-reveal">
        Another kind of professional services firm? The method is the same &mdash;
        <a href="/start" class="font-medium text-zw-teal hover:underline">start here</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════ DEMO (centerpiece) ═══════════════════ -->
  <section id="demo" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">See it working</p>
      <h2 class="zw-h2 mb-8 max-w-[820px] zw-reveal text-zw-cream">
        Every answer traces back to a file you can read and edit. Try it.
      </h2>

      <FileExplorer routes={routes} instanceId="home" theme="dark" />
      <!-- CO-002 item D mounts the live query box + suggested questions in
           FileExplorer's named "query" slot; this section needs no rework. -->

      <!-- Where this comes from: the two sources behind the method. -->
      <div class="grid md:grid-cols-2 gap-5 max-w-[840px] mt-14">
        {shiftCards.map((card) => (
          <article class="zw-card-dark zw-card-dark-compact zw-reveal flex flex-col">
            <p class="zw-eyebrow zw-eyebrow-dark text-[0.7rem] mb-3">{card.tag}</p>
            <h3 class="zw-h3 mb-3 text-white">{card.title}</h3>
            <p class="text-sm leading-relaxed text-zw-cream/75 flex-1">{card.body}</p>
            {card.src.href && (
              <p class="mt-4">
                <a
                  href={card.src.href}
                  target="_blank"
                  rel="noopener"
                  class="text-sm font-medium hover:underline"
                  style="color: var(--zw-rust-soft);"
                >[source]</a>
              </p>
            )}
          </article>
        ))}
      </div>

      <!-- Mid-page conversion moment: right after the demo earns belief. -->
      <div class="mt-14 flex flex-col sm:flex-row sm:items-center gap-5 zw-reveal">
        <p class="text-zw-cream/85 font-medium m-0">Want this running on your files?</p>
        <AuditCta
          location="mid"
          label="Book a free intro call"
          class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-7 py-3.5 rounded-full hover:bg-white transition-colors self-start"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ VIK — WHAT YOU OWN ═══════════════════ -->
  <section id="vik" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="zw-eyebrow mb-4 zw-reveal">What you own</p>
          <h2 class="zw-h2 mb-8 zw-reveal">VIK &mdash; Visualized Institutional Knowledge.</h2>
          <p class="text-zw-muted max-w-[640px] mb-8 zw-reveal text-pretty">
            Your VIK is the working system you keep when the engagement ends &mdash; not a slide, not a
            diagram. It holds how your business actually runs and does work with it: it researches,
            drafts, and answers, all from knowledge you can read and edit.
          </p>
          <div class="zw-vik-plate zw-reveal">
            <span class="zw-vik-tag zw-mono">VIK</span>
            <p class="zw-vik-thesis">
              Tools depreciate. Context compounds. ICM is how we compound it.
              <strong>VIK is what you own when we're done.</strong>
            </p>
          </div>
        </div>

        <!-- Animation C: plain text, read by both -->
        <div class="zw-reveal">
          <div data-anim="bothread" class="zw-bothread mx-auto max-w-[640px]">
            <div class="zw-bothread-labels">
              <span class="zw-bothread-label zw-bothread-label--l">your team reads this</span>
              <span class="zw-bothread-label zw-bothread-label--r">your AI reads this</span>
            </div>
            <div class="zw-knowledge zw-mono" role="img" aria-label="A plain-text knowledge file that both a person and an AI can read.">
              <div class="zw-knowledge-bar">
                <span class="zw-dot"></span><span class="zw-dot"></span><span class="zw-dot"></span>
                <span class="ml-3 text-[0.72rem] text-zw-muted">knowledge.md</span>
              </div>
              <pre class="zw-knowledge-body"><span class="zw-kline"># Refund policy</span>
<span class="zw-kline">window: 30 days from delivery</span>
<span class="zw-kline">exceptions: final-sale, custom orders</span></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- What we build on it: the two offers, folded in from the old standalone section. -->
      <div class="grid md:grid-cols-2 gap-5 mt-14">
        <article class="zw-card zw-reveal">
          <h3 class="zw-h3 mb-3">Your business, written down</h3>
          <p class="text-sm text-zw-muted leading-relaxed">
            We write down how your business actually works: how you define things, price things, and
            run things, all in plain files your team and your AI can both read. One place that holds
            the real answers, instead of knowledge scattered across dashboards, inboxes, and
            people's heads.
          </p>
        </article>
        <article class="zw-card zw-reveal">
          <h3 class="zw-h3 mb-3">The tools that run on it</h3>
          <p class="text-sm text-zw-muted leading-relaxed">
            Once your knowledge is in place, we build the AI assistants and automations that use it.
            Sales and customer work, finding new customers, reporting, and the busywork in between.
            Each one is tested on your real cases, with a person reviewing the work before anything
            goes live where it counts.
          </p>
        </article>
      </div>
      <p class="mt-8 text-sm text-zw-muted max-w-[760px] zw-reveal">
        Everything we build is yours to keep. It's all in plain writing you can read and edit, with
        nothing locking you in. Switch tools or AI providers next year without starting over.
      </p>
    </div>
  </section>

  <!-- ═══════════════════ HOW IT WORKS ═══════════════════ -->
  <section id="how-it-works" class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">How it works</p>
      <h2 class="zw-h2 mb-8 max-w-[760px] zw-reveal">Four steps. Plain language the whole way.</h2>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16 items-start">
        <!-- Steps -->
        <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-y-8 gap-x-6">
          {steps.map((s) => (
            <li class="zw-reveal flex gap-4">
              <span class="zw-mono text-zw-teal text-sm font-medium pt-1 shrink-0">{s.n}</span>
              <div>
                <h3 class="zw-h3 mb-1.5">{s.title}</h3>
                <p class="text-sm text-zw-muted leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <!-- Animation B: layered context loading -->
        <div class="zw-reveal lg:sticky lg:top-24" aria-hidden="true">
          <div data-anim="layers" class="zw-layers">
            {layers.map((l, i) => (
              <div class={`zw-layer${i === layers.length - 1 ? ' zw-layer-last' : ''}`} style={`--i:${i};`}>
                <span class="zw-scan"></span>
                <span class="zw-mono text-sm font-medium">{l.name}</span>
                <span class="text-xs text-zw-muted">{l.desc}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs text-zw-muted text-center zw-mono">the right files at the right step</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ WHY IT LASTS ═══════════════════ -->
  <section id="why-it-lasts" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center">
        <div class="max-w-[620px]">
          <p class="zw-eyebrow mb-4 zw-reveal">Built to last</p>
          <h2 class="zw-h2 mb-8 zw-reveal">AI changes every few months. What you've written down doesn't have to.</h2>
          <p class="text-zw-muted zw-reveal">
            Because your knowledge lives in plain files and not buried inside one AI tool, you don't
            rebuild every time something new comes out. The same files work with whatever AI is best
            next year, and they cost less to run, since the AI only reads what it needs. That's the
            difference between renting a tool and owning something that keeps working.
          </p>
        </div>

        <!-- Animation D: model swap -->
        <div class="zw-reveal" aria-hidden="true">
          <div data-anim="model-swap" class="zw-swap mx-auto max-w-[360px]">
            <div class="zw-swap-slot">
              {modelChips.map((m, i) => (
                <span class={`zw-model-chip zw-mono${i === 0 ? ' zw-chip-on' : ''}`}>{m}</span>
              ))}
            </div>
            <span class="zw-swap-connector"></span>
            <div class="zw-swap-layer">
              <svg width="16" height="18" viewBox="0 0 14 16" fill="none" aria-hidden="true" class="text-zw-teal">
                <path d="M2 1h6l4 4v10H2V1z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M8 1v4h4" stroke="currentColor" stroke-width="1.2"/>
              </svg>
              <span class="zw-mono text-sm font-medium">your business, written down</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PROOF ═══════════════════ -->
  <section id="proof" class="zw-anchor zw-section bg-white border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">What clients say</p>
      <h2 class="zw-h2 mb-8 zw-reveal">Real reviews from real work.</h2>
      <Testimonials tone="on-cream" />
      <p class="mt-8 text-sm text-zw-muted zw-reveal">
        <a href="/results/" class="font-medium text-zw-teal hover:underline">More proof →</a>
      </p>
    </div>
  </section>

  <!-- ═══════════════════ PRICING / OFFER LADDER ═══════════════════ -->
  <section id="pricing" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">How to start</p>
      <h2 class="zw-h2 mb-8 max-w-[760px] zw-reveal">Start small. Keep everything.</h2>
      <OfferLadder variant="full" />
    </div>
  </section>

  <!-- ═══════════════════ START / CTA ═══════════════════ -->
  <section id="start" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure mx-auto text-center">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">Get started</p>
      <h2 class="zw-h2 mb-6 text-zw-cream zw-reveal">Start with a free intro call.</h2>
      <p class="text-zw-cream/75 mb-9 zw-reveal">
        Fifteen minutes on where your knowledge is stuck and whether a VIK would fix it. No deck,
        no pitch. If we're not the right fit, we'll tell you on the call.
      </p>
      <AuditCta
        location="footer"
        label="Book a free intro call"
        class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors zw-reveal"
      />
    </div></div>
  </section>
</LandingLayout>

<style is:global>
  /* .zw-anchor, .zw-card*, .zw-strip*, and the measure/lede/eyebrow-dark
     utilities live in LandingLayout's global block, next to .zw-wrap. */

  /* Card-as-link (who-it's-for): whole card clickable, quiet hover. */
  .zw-card-link {
    text-decoration: none;
    transition: border-color 0.18s var(--zw-ease), transform 0.18s var(--zw-ease);
  }
  .zw-card-link:hover {
    border-color: rgba(224, 69, 48, 0.45);
    transform: translateY(-2px);
  }

  /* VIK "what you own" plate — mirrors the ICM plate to read as two layers. */
  .zw-vik-plate {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    max-width: 640px;
    border: 2px solid var(--zw-teal);
    background: rgba(224, 69, 48, 0.05);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .zw-vik-tag {
    flex: none;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--zw-teal);
    border: 1px solid rgba(224, 69, 48, 0.45);
    border-radius: 6px;
    padding: 3px 7px;
  }
  .zw-vik-thesis { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--zw-muted); }
  .zw-vik-thesis strong { color: var(--zw-ink); font-weight: 600; }

  /* ───────── Animation B: layered context loading ───────── */
  .zw-layers { display: flex; flex-direction: column; gap: 0.6rem; }
  .zw-layer {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-left: 3px solid transparent;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    opacity: 0.55;
  }
  .zw-layer-last {
    opacity: 0.8;
    border-left-color: rgba(224, 69, 48, 0.45);
    background: rgba(224, 69, 48, 0.04);
  }
  .zw-scan { display: none; }
  html.zw-anim [data-anim="layers"] .zw-layer { opacity: 0.5; }
  html.zw-anim [data-anim="layers"] .zw-layer-last { opacity: 0.55; }
  html.zw-anim [data-anim="layers"].zw-play .zw-layer {
    animation: zwLayerOn 1.1s var(--zw-ease) calc(var(--i) * 0.45s) both;
  }
  html.zw-anim [data-anim="layers"].zw-play .zw-layer-last {
    animation: zwLayerOn 1.1s var(--zw-ease) calc(var(--i) * 0.45s) both,
               zwLayerLast 0.1s linear calc(var(--i) * 0.45s + 1.1s) forwards;
  }
  @keyframes zwLayerOn {
    0%, 100% { opacity: 0.5; border-left-color: transparent; background: var(--zw-card); }
