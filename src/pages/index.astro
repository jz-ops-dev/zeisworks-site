---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { COMPACT_FAQ, AUDIT_STEPS } from '../data/faq';

const fixes = [
  {
    title: 'Get found first.',
    body: 'Show up in the map pack and search results when someone nearby needs you today.',
    icon: 'M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  },
  {
    title: 'Win the comparison.',
    body: 'More reviews, better reviews, and a website that turns visitors into calls.',
    icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
  },
  {
    title: 'Answer every call.',
    body: 'Missed calls are lost jobs. We make sure every lead gets a response in minutes, not hours.',
    icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z',
  },
  {
    title: 'Ads that pay for themselves.',
    body: 'Search and social campaigns tracked to the actual job, not just the click.',
    icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12z M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
  {
    title: 'Know your numbers.',
    body: 'Every call, form, and source tracked. You see exactly what your marketing returns.',
    icon: 'M3 3v18h18 M7 16v-5 M12 16V8 M17 16v-8',
  },
  {
    title: 'A plan that adapts.',
    body: 'Monthly optimization based on what is working. If results lag, the plan changes.',
    icon: 'M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
  },
];

// Real Upwork reviews, carried over from the previous site. Swap for the
// Zeis Group / Lift-STL quotes (handoff open item 5) when they land.
const testimonials = [
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: 'Alex Zemianek',
    title: 'Owner & CEO, JZ Vacation Rentals',
  },
  {
    quote: 'Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team.',
    name: 'Verified Client',
    title: 'Upwork · 5.0',
  },
  {
    quote: 'Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him.',
    name: 'Ray Updyke',
    title: 'Alpaca VC · 254 hrs logged',
  },
];

// OPEN ITEM (handoff section 3, homepage section 4): real anonymized
// gap-analysis findings from Jack. Renders only once at least one real
// finding exists. Do not fabricate numbers.
const proofFindings: { label: string; finding: string }[] = [];
---

<BaseLayout
  title="Free 5-Minute Revenue Audit for Local Service Businesses | ZeisWorks"
  description="Find out exactly where your business is losing leads. Free gap analysis and 12-month revenue plan in 5 minutes. No call required, no contracts."
  businessSchema={true}
>
  <!-- ═══════════ HERO ═══════════ -->
  <section class="relative bg-navy-deep overflow-hidden">
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 85% 65% at 50% -10%, rgba(30,58,138,0.65) 0%, transparent 70%), radial-gradient(ellipse 50% 40% at 85% 100%, rgba(234,88,12,0.10) 0%, transparent 70%);"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-3xl mx-auto px-6 pt-16 sm:pt-24 pb-16 text-center">
      <p class="inline-block text-xs font-semibold uppercase tracking-widest text-blue-200 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 mb-6">
        For local service businesses doing $500K to $5M
      </p>
      <h1 class="font-serif text-4xl sm:text-[3.4rem] font-semibold leading-[1.12] tracking-tight text-white mb-6">
        Find out exactly where your business is losing leads.
      </h1>
      <p class="text-lg text-white/70 leading-relaxed max-w-2xl mx-auto mb-9">
        Run a free 5-minute revenue audit. You get a gap analysis of your marketing and a 12-month plan to fix it. No call required. No contracts.
      </p>
      <AuditCta
        location="hero"
        class="inline-block bg-orange text-white font-semibold text-lg px-9 py-4 rounded-lg hover:bg-orange-bright transition-colors shadow-lg shadow-orange/30"
      />
      <p class="mt-4 text-sm text-white/50">Free. 5 minutes. Keep the plan even if we never talk.</p>

      <!-- Demo clip: designed poster frame, click to play -->
      <div class="mt-12 relative aspect-video rounded-2xl overflow-hidden border border-white/15 bg-ink shadow-2xl" id="zw-demo-video">
        <button
          id="zw-demo-play"
          type="button"
          class="absolute inset-0 w-full h-full group cursor-pointer text-left"
          aria-label="Play a short clip of the audit running on a demo company"
        >
          <!-- Styled mock of the audit output -->
          <span class="absolute inset-0 flex flex-col justify-center px-7 sm:px-12 gap-3 sm:gap-4" aria-hidden="true">
            <span class="flex items-center gap-2 mb-1 sm:mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-orange-bright"></span>
              <span class="font-mono text-[0.65rem] sm:text-xs uppercase tracking-[0.18em] text-white/50">Revenue audit &middot; gap analysis</span>
            </span>
            <span class="block">
              <span class="flex justify-between text-[0.7rem] sm:text-sm text-white/70 mb-1.5"><span>Search visibility</span><span class="text-orange-bright font-semibold">gap found</span></span>
              <span class="block h-2 sm:h-2.5 rounded-full bg-white/10"><span class="block h-full w-[34%] rounded-full bg-orange-bright"></span></span>
            </span>
            <span class="block">
              <span class="flex justify-between text-[0.7rem] sm:text-sm text-white/70 mb-1.5"><span>Reviews vs competitors</span><span class="text-orange-bright font-semibold">gap found</span></span>
              <span class="block h-2 sm:h-2.5 rounded-full bg-white/10"><span class="block h-full w-[52%] rounded-full bg-orange-bright"></span></span>
            </span>
            <span class="block">
              <span class="flex justify-between text-[0.7rem] sm:text-sm text-white/70 mb-1.5"><span>Response speed</span><span class="text-blue-300 font-semibold">strong</span></span>
              <span class="block h-2 sm:h-2.5 rounded-full bg-white/10"><span class="block h-full w-[81%] rounded-full bg-blue-400"></span></span>
            </span>
          </span>
          <span class="absolute inset-0 flex items-center justify-center bg-navy-deep/40 group-hover:bg-navy-deep/25 transition-colors">
            <span class="flex items-center justify-center w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-full bg-white shadow-xl group-hover:scale-105 transition-transform duration-200">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-orange ml-1" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </span>
        </button>
      </div>
      <p class="mt-3 text-xs text-white/40">The audit running on a demo company. 3 minutes, not required.</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('zw-demo-play');
      var wrap = document.getElementById('zw-demo-video');
      if (!btn || !wrap) return;
      btn.addEventListener('click', function () {
        var iframe = document.createElement('iframe');
        iframe.src = 'https://drive.google.com/file/d/13c0IGxcmy-nyjlWozb2RVvbSIUMAF-iv/preview';
        iframe.title = 'The revenue audit running on a demo company';
        iframe.allow = 'autoplay';
        iframe.className = 'absolute inset-0 w-full h-full border-0';
        wrap.replaceChild(iframe, btn);
      });
    })();
  </script>

  <!-- ═══════════ PROOF BAR ═══════════ -->
  <div class="border-b border-cream-dark bg-white">
    <div class="max-w-5xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-1.5 text-sm font-medium text-ink-mid text-center">
      <span class="flex items-center gap-1.5">
        <span class="text-orange-bright tracking-tight" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        5.0 on Upwork
      </span>
      <span>Top Rated &middot; 100% Job Success</span>
      <span>Trusted by businesses across the US</span>
    </div>
  </div>

  <!-- ═══════════ HOW IT WORKS ═══════════ -->
  <section id="how-it-works" class="scroll-mt-20">
    <div class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">How it works</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-12">
        Three steps. Five minutes. Real numbers.
      </h2>
      <div class="space-y-0">
        {AUDIT_STEPS.map((step, i) => (
          <div class="relative flex gap-6 items-start pb-10 last:pb-0">
            {i < AUDIT_STEPS.length - 1 && (
              <span class="absolute left-[1.18rem] top-12 bottom-0 w-px bg-cream-dark" aria-hidden="true"></span>
            )}
            <span class="relative flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-navy text-white font-serif font-semibold text-lg shadow-sm">{i + 1}</span>
            <div class="pt-1">
              <h3 class="font-serif text-xl font-semibold text-ink mb-1.5">{step.title}</h3>
              <p class="text-ink-mid leading-relaxed text-[0.9375rem]">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-12 pl-0 sm:pl-16">
        <AuditCta
          location="mid"
          class="inline-block bg-orange text-white font-semibold text-base px-7 py-3.5 rounded-lg hover:bg-orange-bright transition-colors shadow-md shadow-orange/20"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════ WHAT WE FIX ═══════════ -->
  <section class="bg-white border-y border-cream-dark">
    <div class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">What we fix</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-3">
        We don't sell marketing. We close gaps.
      </h2>
      <p class="text-ink-mid mb-12 max-w-2xl">
        Every plan is built from your audit. These are the levers we pull most often.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {fixes.map((fix) => (
          <div class="bg-cream border border-cream-dark rounded-2xl p-7 hover:border-navy/30 hover:shadow-md transition-all duration-200">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-navy/5 mb-5">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-navy"
                aria-hidden="true"
              >
                <path d={fix.icon} />
              </svg>
            </span>
            <h3 class="font-serif text-lg font-semibold text-ink mb-1.5">{fix.title}</h3>
            <p class="text-sm text-ink-mid leading-relaxed">{fix.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ PROOF (renders only once real audit examples exist) ═══════════ -->
  {proofFindings.length > 0 && (
    <section class="border-b border-cream-dark">
      <div class="max-w-5xl mx-auto px-6 py-16 sm:py-20">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-10">
          The audit finds money. Here's what it looks like.
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {proofFindings.map((p) => (
            <div class="bg-white border border-cream-dark rounded-2xl p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">{p.label}</p>
              <p class="text-sm text-ink-mid leading-relaxed">{p.finding}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════ TESTIMONIALS ═══════════ -->
  <section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">What clients say</p>
    <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-12">
      Real results from real businesses.
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {testimonials.map((t) => (
        <figure class="bg-white border border-cream-dark rounded-2xl p-7 flex flex-col shadow-sm">
          <span class="text-orange-bright text-sm tracking-tight mb-4" aria-label="5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <blockquote class="font-serif italic text-[0.9375rem] text-ink leading-relaxed flex-1">
            "{t.quote}"
          </blockquote>
          <figcaption class="mt-5 pt-4 border-t border-cream-dark">
            <p class="font-semibold text-ink text-sm">{t.name}</p>
            <p class="text-xs text-ink-light mt-0.5">{t.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ═══════════ FAQ ═══════════ -->
  <section class="bg-white border-y border-cream-dark">
    <div class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange mb-3">Questions</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-10">
        Straight answers.
      </h2>
      <dl class="divide-y divide-cream-dark border-y border-cream-dark">
        {COMPACT_FAQ.map(({ q, a }) => (
          <div class="py-6">
            <dt class="font-semibold text-ink mb-2">{q}</dt>
            <dd class="text-sm text-ink-mid leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ═══════════ CLOSING CTA ═══════════ -->
  <CtaBlock heading="Five minutes from now you'll know where the leaks are." />
</BaseLayout>
