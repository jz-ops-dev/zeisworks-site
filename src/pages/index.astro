---
import LandingLayout from '../layouts/LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import OfferLadder from '../components/OfferLadder.astro';

const navLinks = [
  { label: 'Problem', href: '#the-problem' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Demo', href: '#demo' },
  { label: 'Fit', href: '#fit' },
];

const knowledgeInputs = [
  'Owner judgment',
  'Senior estimator',
  'Pricing sheets',
  'Slack threads',
  'CRM notes',
  'SOP',
  'Email history',
  'Sales playbook',
  'Field notes',
];

const knowledgeFiles = [
  'pricing.md',
  'estimating.md',
  'customers.md',
  'escalation.md',
  'brand-voice.md',
  'policies.md',
];

const aiOutputs = [
  'Answer with sources',
  'Price with rules',
  'Draft proposals',
  'Train new hires',
  'Research accounts',
  'Qualify leads',
  'Support customers',
  'Guide operations',
];

const problems = [
  {
    title: 'Everything runs through one person',
    body: 'The owner, senior estimator, or operations lead keeps getting interrupted because the real answers live with them.',
  },
  {
    title: 'Your AI gives plausible answers, not company answers',
    body: "ChatGPT knows the internet. It does not know your pricing logic, escalation rules, customer red flags, or proposal standards.",
  },
  {
    title: 'Training takes forever',
    body: 'New employees learn through shadowing, repeated questions, and a long trail of small exceptions nobody has written down.',
  },
  {
    title: 'Important rules are scattered everywhere',
    body: "Some rules are in SOPs. Some are in spreadsheets. Some are in Slack. The decisive ones may only exist in someone's head.",
  },
  {
    title: 'You have key-person risk',
    body: 'When one experienced employee leaves, the company can lose the judgment behind years of pricing, sales, and operations decisions.',
  },
  {
    title: "You want AI, but do not trust it",
    body: 'The issue is rarely the model alone. It is that the model has not been taught how your company actually operates.',
  },
];

const demoQuestions = [
  {
    question: 'Can I give this customer a 15% discount?',
    files: ['pricing.md', 'approval-rules.md'],
    answer: 'No direct approval at the account-manager level. Discounts up to 10% are allowed. Discounts from 11-20% require sales manager approval and must preserve the minimum margin in pricing.md.',
  },
  {
    question: 'Should we take this customer?',
    files: ['customers.md', 'risk-signals.md'],
    answer: 'Proceed only with prepaid terms or manager approval. This account matches two risk signals: urgent timeline and prior scope disputes.',
  },
  {
    question: 'How should we price this job?',
    files: ['estimating.md', 'pricing.md', 'exceptions.md'],
    answer: 'Use standard project pricing, then add the access surcharge and complexity adjustment because the site has constrained entry and after-hours work.',
  },
  {
    question: 'What happens when a customer requests a refund?',
    files: ['policies.md', 'escalation.md'],
    answer: 'Support can review refunds inside 30 days. Custom work and refunds above $500 require escalation before anyone commits to the customer.',
  },
];

const coreKnowledge = [
  'Rules',
  'Exceptions',
  'Judgment',
  'Processes',
  'Pricing logic',
  'Customer definitions',
  'Escalation paths',
  'Brand voice',
  'Institutional memory',
];

const beforeItems = [
  'Senior employees answer the same questions repeatedly',
  'Pricing knowledge is inconsistent',
  'AI produces generic responses',
  'SOPs go stale',
  "Critical judgment exists only in people's heads",
  'Automations break when exceptions occur',
];

const afterItems = [
  'Employees can query company knowledge',
  'AI follows real pricing logic',
  'Answers reference actual company rules',
  'Institutional knowledge is explicit',
  'New hires have an internal knowledge system',
  'Updates happen at the knowledge layer',
];

const exampleCaptured = [
  'Pricing logic and common exceptions',
  'Customer qualification criteria',
  'Proposal structure and approved language',
  'Escalation rules for edge cases',
  'Role-specific operating notes for new hires',
];

const exampleBuilt = [
  'An internal question-answering system with source references',
  'A pricing and scope reference for estimators',
  'A proposal draft workflow using company language',
  'A living file structure the team can review and update',
];

const outcomes = [
  {
    title: 'Sales',
    items: ['Lead qualification', 'Proposal drafting', 'Customer research', 'Follow-up', 'Pricing guidance'],
  },
  {
    title: 'Operations',
    items: ['Process Q&A', 'Escalation guidance', 'Internal support', 'Decision assistance', 'Workflow automation'],
  },
  {
    title: 'Training',
    items: ['New hire onboarding', 'Role-specific assistants', 'Process explanations', 'Internal knowledge search'],
  },
  {
    title: 'Estimating',
    items: ['Pricing guidance', 'Scope assistance', 'Historical context', 'Exception handling'],
  },
  {
    title: 'Customer service',
    items: ['Policy-aware responses', 'Escalation', 'Account context', 'Consistent answers'],
  },
];

const ownershipRows = [
  ['Knowledge hidden inside a platform', 'Knowledge stored in readable files'],
  ['Consultant understands the system', 'Your team can understand the system'],
  ['Dependent on one AI provider', 'AI-provider independent'],
  ['Black-box answers', 'Traceable source material'],
  ['Leave the vendor, lose the system', 'Leave ZeisWorks, keep the system'],
  ['Automation first', 'Knowledge first'],
];

const processSteps = [
  {
    n: '01',
    title: 'Map',
    body: 'Identify where the important knowledge currently lives: people, documents, software, spreadsheets, and processes.',
  },
  {
    n: '02',
    title: 'Capture',
    body: 'Interview the people who know how the business really operates, then document rules, exceptions, judgment, and decision logic.',
  },
  {
    n: '03',
    title: 'Build',
    body: 'Turn that knowledge into useful AI systems: assistants, internal search, estimating tools, proposal workflows, and automations.',
  },
  {
    n: '04',
    title: 'Transfer',
    body: 'Your company owns the knowledge, files, systems, and documentation. Continue if it creates value. Leave if it does not.',
  },
];

const greatFit = [
  'A few employees hold a disproportionate amount of important knowledge',
  'Work involves judgment rather than simple checklists',
  'You have meaningful exceptions and edge cases',
  'Employees repeatedly ask the same internal questions',
  'Training employees takes a long time',
  'You want AI but do not trust generic output',
  'Losing a senior employee would create serious problems',
];

const notFit = [
  'You just need a simple chatbot',
  'Your business processes are extremely standardized',
  'Everything important is already documented and maintained',
  'You only want AI because it is trendy',
  'You expect AI to replace your team overnight',
];
---

<LandingLayout
  title="ZeisWorks - Your company already knows the answer"
  description="ZeisWorks captures the rules, judgment, processes, and expertise inside your company, then turns that knowledge into AI systems your team can trust and own."
  ogImage="/og.png"
  navLinks={navLinks}
  ctaLabel="See your knowledge map"
>
  <span id="top" aria-hidden="true"></span>

  <section class="zw-hero bg-zw-cream border-b border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-hero-grid">
        <div class="zw-hero-copy">
          <p class="zw-eyebrow mb-4 zw-reveal">Institutional knowledge, made usable</p>
          <h1 class="zw-h1 zw-reveal">
            Your company already knows the answer. Your AI doesn't.
          </h1>
          <p class="zw-hero-lede zw-reveal">
            The useful intelligence is already inside your people, documents, spreadsheets, and
            daily decisions. ZeisWorks captures it, structures it, and turns it into AI systems
            your team can actually trust.
          </p>
          <div class="zw-hero-actions zw-reveal">
            <AuditCta
              location="hero"
              label="See what my company knows"
              class="zw-btn zw-btn-primary"
            />
            <a href="#demo" class="zw-btn zw-btn-secondary">Watch the knowledge demo</a>
          </div>
          <p class="zw-proof-line zw-reveal">
            Knowledge first. Automation second. Everything we build is yours to keep.
          </p>
        </div>

        <div class="zw-flow zw-reveal" data-anim="hero" aria-label="Company knowledge becoming structured AI infrastructure">
          <div class="zw-flow-title">
            <span>Company knowledge</span>
            <strong>from scattered to usable</strong>
          </div>
          <div class="zw-flow-col">
            <p>What your company knows</p>
            <div class="zw-chip-cloud">
              {knowledgeInputs.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <div class="zw-flow-arrow" aria-hidden="true"></div>
          <div class="zw-flow-col zw-flow-center">
            <p>Your company's knowledge</p>
            <div class="zw-file-stack">
              {knowledgeFiles.map((file) => (
                <span>
                  <svg width="14" height="16" viewBox="0 0 14 16" fill="none" aria-hidden="true">
                    <path d="M2 1h6l4 4v10H2V1z" stroke="currentColor" stroke-width="1.2" />
                    <path d="M8 1v4h4" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                  {file}
                </span>
              ))}
            </div>
          </div>
          <div class="zw-flow-arrow" aria-hidden="true"></div>
          <div class="zw-flow-col">
            <p>What your AI can now do</p>
            <div class="zw-chip-cloud zw-chip-cloud-tight">
              {aiOutputs.map((item) => <span>{item}</span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="zw-strip bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-strip-line zw-reveal">
        The problem with your AI probably isn't the AI. It's what the AI knows about your company.
      </p>
    </div>
  </section>

  <section id="the-problem" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Does this sound familiar?</p>
        <h2 class="zw-h2 zw-reveal">The most valuable rules in the business are often the least accessible.</h2>
      </div>
      <div class="zw-problem-grid">
        {problems.map((problem) => (
          <article class="zw-card zw-reveal">
            <h3>{problem.title}</h3>
            <p>{problem.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="demo" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal" style="color:#F0A184;">See it working</p>
        <h2 class="zw-h2 zw-reveal text-zw-cream">A trustworthy answer has a trail back to company knowledge.</h2>
      </div>

      <div class="zw-demo zw-reveal" data-demo>
        <div class="zw-demo-panel">
          <p class="zw-demo-label">Employee question</p>
          <p class="zw-demo-question" data-demo-question>{demoQuestions[0].question}</p>
          <div class="zw-demo-presets" aria-label="Example questions">
            {demoQuestions.map((item, i) => (
              <button type="button" data-demo-preset={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                {item.question}
              </button>
            ))}
          </div>
        </div>

        <div class="zw-demo-rail" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="zw-demo-panel">
          <p class="zw-demo-label">Company knowledge</p>
          <div class="zw-demo-files" data-demo-files>
            {demoQuestions[0].files.map((file) => <span>{file}</span>)}
          </div>
        </div>

        <div class="zw-demo-rail" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="zw-demo-panel zw-demo-answer-panel">
          <p class="zw-demo-label">Company AI</p>
          <p class="zw-demo-answer" data-demo-answer>{demoQuestions[0].answer}</p>
          <div>
            <p class="zw-demo-label">Sources used</p>
            <div class="zw-demo-sources" data-demo-sources>
              {demoQuestions[0].files.map((file) => <span>{file}</span>)}
            </div>
          </div>
        </div>
      </div>
      <p class="zw-demo-note zw-reveal">
        The point is not another chatbot. It is question -> company knowledge -> answer with sources.
      </p>
    </div>
  </section>

  <section id="how-it-works" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-core-grid">
        <div>
          <p class="zw-eyebrow mb-4 zw-reveal">The core idea</p>
          <h2 class="zw-h2 mb-6 zw-reveal">Before you automate the workflow, capture the judgment behind it.</h2>
          <p class="text-zw-muted zw-reveal">
            Most AI projects start by asking, "What should we automate?" ZeisWorks starts one
            level deeper: "What does the company need to know to do this correctly?" Once that
            knowledge is explicit, it can power assistants, search, proposals, estimating, training,
            and operations support.
          </p>
        </div>
        <div class="zw-knowledge-list zw-reveal">
          {coreKnowledge.map((item) => <span>{item}</span>)}
        </div>
      </div>

      <div class="zw-vik-block zw-reveal">
        <div>
          <p class="zw-eyebrow mb-4">What we build</p>
          <h2 class="zw-h2 mb-5">The finished knowledge system is your VIK.</h2>
          <p>
            VIK means Visualized Institutional Knowledge: a structured, human-readable
            representation of how your business thinks and operates. It becomes the source material
            behind your AI systems.
          </p>
          <p class="zw-vik-own">Readable files. Traceable answers. Owned by your company.</p>
        </div>
        <div class="zw-vik-files" aria-label="Example VIK files">
          {knowledgeFiles.map((file) => <span>{file}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="zw-section bg-white/45 border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Before and after</p>
        <h2 class="zw-h2 zw-reveal">The same company, without the hidden bottleneck.</h2>
      </div>
      <div class="zw-before-after">
        <article class="zw-compare zw-compare-before zw-reveal">
          <h3>Before ZeisWorks</h3>
          <ul>
            {beforeItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="zw-compare zw-compare-after zw-reveal">
          <h3>After ZeisWorks</h3>
          <ul>
            {afterItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-example zw-reveal">
        <div>
          <p class="zw-eyebrow mb-4">Example engagement</p>
          <h2 class="zw-h2 mb-5">From "ask the senior person" to a system the team can use.</h2>
          <p>
            For a founder-led service business, the most important operating knowledge is rarely in
            one clean manual. It is spread across pricing decisions, proposal habits, edge-case
            calls, and the judgment of experienced people. A ZeisWorks engagement turns that into a
            working internal knowledge layer before building AI on top of it.
          </p>
        </div>
        <div class="zw-example-lists">
          <div>
            <h3>What gets captured</h3>
            <ul>
              {exampleCaptured.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3>What can be built</h3>
            <ul>
              {exampleBuilt.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="zw-section bg-white/45 border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Business outcomes</p>
        <h2 class="zw-h2 zw-reveal">Once the knowledge exists, the AI work gets easier.</h2>
        <p class="zw-head-copy zw-reveal">
          The exact systems depend on the company. The foundation is the same: company-specific
          knowledge that people and AI can both use.
        </p>
      </div>
      <div class="zw-outcome-grid">
        {outcomes.map((outcome) => (
          <article class="zw-card zw-reveal">
            <h3>{outcome.title}</h3>
            <ul>
              {outcome.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-ownership-grid">
        <div>
          <p class="zw-eyebrow mb-4 zw-reveal" style="color:#F0A184;">Ownership</p>
          <h2 class="zw-h2 mb-6 zw-reveal text-zw-cream">We don't want to own your AI. We want you to own it.</h2>
          <p class="text-zw-cream/75 zw-reveal">
            Most implementations hide the real knowledge inside someone else's platform. ZeisWorks
            keeps the knowledge readable, portable, and useful even if the tool stack changes.
          </p>
        </div>
        <div class="zw-ownership-table zw-reveal">
          <div class="zw-table-head">
            <span>Typical AI implementation</span>
            <span>ZeisWorks</span>
          </div>
          {ownershipRows.map(([typical, zeis]) => (
            <div class="zw-table-row">
              <span>{typical}</span>
              <span>{zeis}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Process</p>
        <h2 class="zw-h2 zw-reveal">Four steps, no mystery box.</h2>
      </div>
      <ol class="zw-process">
        {processSteps.map((step) => (
          <li class="zw-reveal">
            <span>{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="fit" class="zw-anchor zw-section bg-white/45 border-y border-zw-border">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Who this is for</p>
        <h2 class="zw-h2 zw-reveal">ZeisWorks works best when your company runs on expertise.</h2>
      </div>
      <div class="zw-fit-grid">
        <article class="zw-card zw-reveal">
          <h3>Great fit if:</h3>
          <ul>
            {greatFit.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="zw-card zw-reveal">
          <h3>Probably not a fit if:</h3>
          <ul>
            {notFit.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section id="pricing" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <div class="zw-section-head">
        <p class="zw-eyebrow mb-4 zw-reveal">Pricing</p>
        <h2 class="zw-h2 zw-reveal">Build an AI knowledge asset for less than the cost of another hire.</h2>
        <p class="zw-head-copy zw-reveal">
          Unlike a traditional retainer, the work accumulates. Every process captured becomes part
          of an asset your company keeps.
        </p>
      </div>
      <OfferLadder variant="full" />
    </div>
  </section>

  <section id="start" class="zw-anchor zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8 zw-final-cta">
      <p class="zw-eyebrow mb-4 zw-reveal" style="color:#F0A184;">Start here</p>
      <h2 class="zw-h2 mb-6 zw-reveal text-zw-cream">Your company already has an AI advantage.</h2>
      <p class="zw-reveal">It is what your best people know. Let's make it usable.</p>
      <AuditCta
        location="footer"
        label="See what my company knows"
        class="zw-btn zw-btn-light zw-reveal"
      />
    </div>
  </section>

  <script is:inline define:vars={{ demoQuestions }}>
    (function () {
      var root = document.querySelector('[data-demo]');
      if (!root) return;
      var question = root.querySelector('[data-demo-question]');
      var answer = root.querySelector('[data-demo-answer]');
      var files = root.querySelector('[data-demo-files]');
      var sources = root.querySelector('[data-demo-sources]');
      var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-demo-preset]'));

      function render(index) {
        var item = demoQuestions[index];
        if (!item) return;
        question.textContent = item.question;
        answer.textContent = item.answer;
        files.innerHTML = '';
        sources.innerHTML = '';
        item.files.forEach(function (file) {
          var fileChip = document.createElement('span');
          fileChip.textContent = file;
          files.appendChild(fileChip);
          var sourceChip = document.createElement('span');
          sourceChip.textContent = file;
          sources.appendChild(sourceChip);
        });
        buttons.forEach(function (button, i) {
          button.setAttribute('aria-pressed', i === index ? 'true' : 'false');
        });
      }

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          render(Number(button.getAttribute('data-demo-preset')));
        });
      });
    })();
  </script>
</LandingLayout>

<style is:global>
  .zw-anchor { scroll-margin-top: 5rem; }
  .zw-section {
    padding-top: clamp(3.4rem, 7vw, 5.8rem);
    padding-bottom: clamp(3.4rem, 7vw, 5.8rem);
  }
  .zw-h2 {
    font-size: clamp(1.6rem, 2.7vw, 2.25rem);
    line-height: 1.14;
  }
  .zw-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }
  .zw-card {
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: 8px;
    padding: 1.15rem;
  }
  .zw-card h3 {
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .zw-card p,
  .zw-card li {
    color: var(--zw-muted);
    font-size: 0.91rem;
    line-height: 1.48;
  }
  .zw-card ul,
  .zw-compare ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .zw-card li,
  .zw-compare li {
    position: relative;
    padding-left: 1rem;
  }
  .zw-card li::before,
  .zw-compare li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--zw-teal);
  }
  .zw-section-head {
    max-width: 760px;
    margin-bottom: clamp(1.6rem, 3.8vw, 2.65rem);
  }
  .zw-head-copy {
    margin-top: 0.85rem;
    max-width: 680px;
    color: var(--zw-muted);
    line-height: 1.55;
  }
  .zw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 999px;
    padding: 0.78rem 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    transition: background 0.2s var(--zw-ease), color 0.2s var(--zw-ease), border-color 0.2s var(--zw-ease);
  }
  .zw-btn-primary {
    background: var(--zw-teal);
    color: white;
  }
  .zw-btn-primary:hover { background: var(--zw-rust); }
  .zw-btn-secondary {
    border: 1px solid rgba(29, 29, 31, 0.18);
    color: var(--zw-ink);
    background: transparent;
  }
  .zw-btn-secondary:hover { border-color: var(--zw-teal); color: var(--zw-teal); }
