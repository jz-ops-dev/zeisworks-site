<script>
// ── Animate on scroll ──────────────────────────────────────────────────────
const aosEls = document.querySelectorAll('.aos');
const aosObs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); aosObs.unobserve(e.target); } });
}, { threshold: 0.12 });
aosEls.forEach(el => aosObs.observe(el));

// ── Before/After slider ────────────────────────────────────────────────────
(function() {
  const wrap = document.getElementById('ba-slider');
  const beforePanel = document.getElementById('ba-before-panel');
  const beforeImg = document.getElementById('ba-before-img');
  const divider = document.getElementById('ba-divider');
  const handle = document.getElementById('ba-handle');
  const lblBefore = document.getElementById('ba-lbl-before');
  const lblAfter = document.getElementById('ba-lbl-after');
  if (!wrap) return;
  let pos = 50, dragging = false;

  function setPos(p) {
    pos = Math.min(100, Math.max(0, p));
    beforePanel.style.width = pos + '%';
    beforeImg.style.width = wrap.offsetWidth + 'px';
    divider.style.left = pos + '%';
    handle.style.left = pos + '%';
    lblBefore.style.opacity = pos > 15 ? '1' : '0';
    lblAfter.style.opacity = pos < 85 ? '1' : '0';
  }
  function fromEvent(clientX) {
    const rect = wrap.getBoundingClientRect();
    setPos(((clientX - rect.left) / rect.width) * 100);
  }
  wrap.addEventListener('mousedown', e => { e.preventDefault(); dragging = true; });
  wrap.addEventListener('touchstart', () => { dragging = true; }, { passive: true });
  window.addEventListener('mousemove', e => { if (dragging) fromEvent(e.clientX); });
  window.addEventListener('touchmove', e => { if (dragging) fromEvent(e.touches[0].clientX); }, { passive: true });
  window.addEventListener('mouseup', () => { dragging = false; });
  window.addEventListener('touchend', () => { dragging = false; });
  window.addEventListener('resize', () => setPos(pos));
  setPos(50);
})();

// ── Trash Day Scheduler ────────────────────────────────────────────────────
(function() {
  const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const today = new Date();
  let selectedDay = null, selectedDate = null;
  let calYear = today.getFullYear(), calMonth = today.getMonth();

  const dayBtns = document.querySelectorAll('.day-btn');
  const calSection = document.getElementById('cal-section');
  const calMonthLabel = document.getElementById('cal-month-label');
  const calCells = document.getElementById('cal-cells');
  const calHint = document.getElementById('cal-hint');
  const calConfirm = document.getElementById('cal-confirm');
  const schedulerConfirm = document.getElementById('scheduler-confirm');
  const confirmMsg = document.getElementById('confirm-msg');
  const schedulerBox = document.getElementById('scheduler-box');

  function getDayName(date) { return date.toLocaleDateString('en-US', { weekday: 'long' }); }
  function getAvailableDates(dayName, year, month) {
    const dates = [];
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    for (let d = 1; d <= daysInMonth; d++) {
      if (getDayName(new Date(year, month, d)) === dayName) dates.push(d);
    }
    return dates;
  }
  function isPast(d) { return new Date(calYear, calMonth, d) < new Date(today.getFullYear(), today.getMonth(), today.getDate()); }

  function renderCal() {
    if (!selectedDay) return;
    calMonthLabel.textContent = MONTH_NAMES[calMonth] + ' ' + calYear;
    calHint.textContent = 'Highlighted dates are your ' + selectedDay + ' pickup days';
    const available = getAvailableDates(selectedDay, calYear, calMonth);
    const firstDay = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    calCells.innerHTML = '';
    for (let i = 0; i < firstDay; i++) {
      const el = document.createElement('div'); el.className = 'cal-cell'; calCells.appendChild(el);
    }
    for (let d = 1; d <= daysInMonth; d++) {
      const el = document.createElement('div');
      const avail = available.includes(d) && !isPast(d);
      const sel = selectedDate === d;
      el.className = 'cal-cell' + (avail ? ' available' : '') + (sel ? ' selected' : '') + (!avail && isPast(d) ? ' past' : '');
      el.textContent = d;
      if (avail) {
        el.addEventListener('click', () => {
          selectedDate = d;
          renderCal();
          calConfirm.textContent = 'Schedule Clean — ' + MONTH_NAMES[calMonth] + ' ' + d + ' →';
          calConfirm.style.opacity = '1';
          calConfirm.style.cursor = 'pointer';
          calConfirm.disabled = false;
        });
      }
      calCells.appendChild(el);
    }
  }

  dayBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      dayBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedDay = btn.dataset.day;
      selectedDate = null;
      calConfirm.textContent = 'Select a date above';
      calConfirm.style.opacity = '0.4';
      calConfirm.style.cursor = 'default';
      calConfirm.disabled = true;
      calSection.style.display = 'block';
      renderCal();
    });
  });

  document.getElementById('cal-prev').addEventListener('click', () => {
    if (calMonth === 0) { calMonth = 11; calYear--; } else calMonth--;
    selectedDate = null;
    calConfirm.textContent = 'Select a date above';
    calConfirm.style.opacity = '0.4';
    calConfirm.disabled = true;
    renderCal();
  });
  document.getElementById('cal-next').addEventListener('click', () => {
    if (calMonth === 11) { calMonth = 0; calYear++; } else calMonth++;
    selectedDate = null;
    calConfirm.textContent = 'Select a date above';
    calConfirm.style.opacity = '0.4';
    calConfirm.disabled = true;
    renderCal();
  });

  calConfirm.addEventListener('click', () => {
    if (!selectedDate || !selectedDay) return;
    const dateStr = MONTH_NAMES[calMonth] + ' ' + selectedDate + ', ' + calYear;
    confirmMsg.innerHTML = "We'll clean your bins on <strong>" + dateStr + "</strong> — right after your <strong>" + selectedDay + "</strong> pickup. We'll confirm by text.";
    schedulerBox.querySelectorAll('.scheduler-step').forEach(s => s.style.display = 'none');
    schedulerConfirm.classList.add('show');
  });
})();

// ── FAQ accordion ──────────────────────────────────────────────────────────
document.querySelectorAll('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const idx = btn.dataset.faq;
    const body = document.getElementById('faq-body-' + idx);
    const chevron = document.getElementById('faq-chevron-' + idx);
    const isOpen = body.classList.contains('open');
    document.querySelectorAll('.faq-body').forEach(b => b.classList.remove('open'));
    document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('open'));
    if (!isOpen) { body.classList.add('open'); chevron.classList.add('open'); }
  });
});

// ── Quote form ─────────────────────────────────────────────────────────────
document.getElementById('quote-form').addEventListener('submit', function(e) {
  e.preventDefault();
  const btn = this.querySelector('button[type=submit]');
  btn.textContent = 'Sending…'; btn.disabled = true;
  setTimeout(() => {
    this.style.display = 'none';
    document.getElementById('form-success').classList.add('show');
  }, 800);
});
</script>

</body>
