---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Golden Boy Bin Co. — Trash Can Cleaning & Power Washing in Golden, CO</title>
  <meta name="description" content="Trash can cleaning and small power washing for Golden-area homeowners. Done right after pickup, using up to 80% less water than a garden hose. Call or text 720-650-2447." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --gold: #F5B800;
      --gold-dark: #C89500;
      --ink: #1A1814;
      --ink-mid: #4A4640;
      --ink-light: #8A8680;
      --cream: #F7F4EE;
      --cream-dark: #EDE8DC;
      --green-dark: #1E3A2E;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', system-ui, sans-serif; background: var(--cream); color: var(--ink); line-height: 1.6; }
    h1,h2,h3,h4 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; text-transform: uppercase; line-height: 0.95; letter-spacing: 0.01em; }
    .label { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-light); }
    .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 1.25rem; }
    @media(min-width:640px){ .container{ padding: 0 2rem; } }
    @media(min-width:1024px){ .container{ padding: 0 2.5rem; } }

    /* Buttons */
    .btn-gold {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
      background: var(--gold); color: var(--ink); border: 3px solid var(--ink);
      font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1rem;
      text-transform: uppercase; letter-spacing: 0.06em; padding: 0.7rem 1.75rem;
      cursor: pointer; text-decoration: none; transition: transform 120ms, box-shadow 120ms;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.18); }
    .btn-gold:active { transform: scale(0.97); }
    .btn-outline {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
      background: transparent; color: var(--gold); border: 3px solid var(--gold);
      font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1rem;
      text-transform: uppercase; letter-spacing: 0.06em; padding: 0.7rem 1.75rem;
      cursor: pointer; text-decoration: none; transition: all 150ms;
    }
    .btn-outline:hover { background: var(--gold); color: var(--ink); }

    /* Nav */
    .gbbc-nav {
      position: sticky; top: 0; z-index: 50;
      background: var(--cream); border-bottom: 4px solid var(--gold);
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    }
    .gbbc-nav .inner { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; }
    .gbbc-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
    .gbbc-logo-icon { background: var(--gold); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border: 2px solid var(--ink); font-size: 1.1rem; flex-shrink: 0; }
    .gbbc-logo-text { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); }
    .nav-links { display: flex; align-items: center; gap: 1.5rem; }
    .nav-links a { color: var(--ink-mid); font-size: 0.88rem; font-weight: 500; text-decoration: none; transition: color 150ms; }
    .nav-links a:hover { color: var(--gold-dark); }
    @media(max-width:767px){ .nav-links { display: none; } }

    /* Hero */
    .hero {
      position: relative; min-height: 92vh; display: flex; align-items: center;
      background: var(--ink); overflow: hidden;
    }
    .hero-bg { position: absolute; inset: 0; background-image: url(var(--hero-img)); background-size: cover; background-position: center 40%; opacity: 0.32; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,24,20,0.97) 0%, rgba(26,24,20,0.72) 55%, rgba(26,24,20,0.3) 100%); }
    .hero-content { position: relative; z-index: 1; padding: 4rem 0; max-width: 700px; }
    .hero h1 { font-size: clamp(3.5rem, 9vw, 7rem); color: #fff; margin-bottom: 1.5rem; }
    .hero h1 span { color: var(--gold); }
    .hero p { font-size: clamp(1rem, 2.5vw, 1.2rem); color: rgba(255,255,255,0.78); max-width: 480px; line-height: 1.65; margin-bottom: 2.5rem; }
    .hero-btns { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; }
    .hero-trust { display: flex; flex-wrap: wrap; gap: 1.5rem; }
    .hero-trust span { display: flex; align-items: center; gap: 0.4rem; color: rgba(255,255,255,0.75); font-size: 0.88rem; font-weight: 500; }
    .hero-trust span::before { content: "✓"; color: var(--gold); font-weight: 700; }
    .hero-location { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 1.25rem; }
    .hero-location span { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
    .scroll-hint { position: absolute; bottom: 1.75rem; left: 50%; transform: translateX(-50%); color: var(--gold); opacity: 0.65; animation: bounce 2s infinite; font-size: 1.5rem; text-decoration: none; }
    @keyframes bounce { 0%,100%{ transform: translateX(-50%) translateY(0); } 50%{ transform: translateX(-50%) translateY(8px); } }

    /* Sections */
    .section { padding: 5rem 0; }
    .section-sm { padding: 3rem 0; }
    .section-title { margin-bottom: 0.5rem; }
    .section-h2 { font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 1rem; }

    /* Services */
    .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 3rem; }
    .service-card { border: 3px solid var(--ink); padding: 2.5rem; display: flex; flex-direction: column; transition: transform 200ms, box-shadow 200ms; }
    .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.1); }
    .service-icon { background: var(--gold); width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; border: 2px solid var(--ink); margin-bottom: 1.5rem; }
    .service-card h3 { font-size: 1.75rem; margin-bottom: 1rem; }
    .service-card p { color: var(--ink-mid); line-height: 1.65; margin-bottom: 1.5rem; flex-grow: 1; }
    .check-list { list-style: none; margin-bottom: 2rem; }
    .check-list li { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 500; }
    .check-list li::before { content: "✓"; color: var(--gold); font-weight: 700; flex-shrink: 0; }

    /* Water callout */
    .water-callout { background: var(--green-dark); border-top: 4px solid var(--ink); border-bottom: 4px solid var(--ink); }
    .water-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; }
    .water-icon { background: var(--gold); width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; border: 3px solid var(--ink); flex-shrink: 0; }
    .water-text h3 { font-size: clamp(1.4rem, 3vw, 2rem); color: #fff; margin-bottom: 0.5rem; }
    .water-text p { color: rgba(255,255,255,0.72); font-size: 0.95rem; line-height: 1.65; max-width: 560px; }

    /* Before/After */
    .ba-wrap { position: relative; width: 100%; max-width: 680px; margin: 0 auto; aspect-ratio: 4/3; overflow: hidden; border: 3px solid var(--ink); cursor: grab; user-select: none; }
    .ba-wrap:active { cursor: grabbing; }
    .ba-after { position: absolute; inset: 0; }
    .ba-after img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .ba-before { position: absolute; inset: 0; overflow: hidden; }
    .ba-before img { position: absolute; top: 0; left: 0; height: 100%; width: 680px; max-width: none; object-fit: cover; object-position: center; }
    .ba-divider { position: absolute; top: 0; bottom: 0; width: 3px; background: var(--gold); transform: translateX(-50%); pointer-events: none; }
    .ba-handle { position: absolute; top: 50%; width: 48px; height: 48px; border-radius: 50%; background: var(--gold); border: 3px solid var(--ink); display: flex; align-items: center; justify-content: center; transform: translate(-50%, -50%); pointer-events: none; box-shadow: 0 4px 16px rgba(0,0,0,0.28); font-size: 1rem; }
    .ba-label { position: absolute; top: 14px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 10px; }
    .ba-label-before { left: 14px; background: var(--ink); color: #fff; }
    .ba-label-after  { right: 14px; background: var(--gold); color: var(--ink); }
    .ba-hint { text-align: center; margin-top: 0.75rem; font-size: 0.82rem; color: var(--ink-light); }

    /* Scheduler */
    .scheduler-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4rem; align-items: start; }
    .scheduler-box { border: 3px solid var(--ink); background: #fff; overflow: hidden; }
    .scheduler-step { padding: 1.75rem 2rem; }
    .scheduler-step + .scheduler-step { border-top: 2px solid var(--cream-dark); }
    .step-label { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-light); margin-bottom: 0.75rem; }
    .day-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .day-btn { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.45rem 1rem; border: 2px solid var(--ink); background: transparent; cursor: pointer; transition: all 150ms; }
    .day-btn:hover, .day-btn.active { background: var(--gold); }
    .cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
    .cal-month { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .cal-nav-btn { background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 1.1rem; color: var(--ink); }
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
    .cal-day-header { text-align: center; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 0.68rem; letter-spacing: 0.1em; color: var(--ink-light); padding: 4px 0; }
    .cal-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 500; border: 2px solid transparent; border-radius: 2px; cursor: default; transition: all 120ms; }
    .cal-cell.available { background: #FFF8E1; cursor: pointer; font-weight: 600; }
    .cal-cell.available:hover { background: var(--gold); border-color: var(--ink); }
    .cal-cell.selected { background: var(--gold); border-color: var(--ink); font-weight: 700; }
    .cal-cell.past { color: #ccc; }
    .cal-hint { font-size: 0.78rem; color: var(--ink-light); text-align: center; margin-top: 0.75rem; }
    .scheduler-confirm { display: none; padding: 2.5rem; text-align: center; }
    .scheduler-confirm.show { display: block; }
    .confirm-icon { font-size: 3rem; margin-bottom: 1rem; }
    .confirm-h { font-size: 1.75rem; margin-bottom: 0.75rem; }

    /* Pricing */
    .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; margin-top: 3rem; }
    .price-card { border: 2px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.06); padding: 2rem 1.25rem; text-align: center; transition: transform 200ms; }
    .price-card:hover { transform: translateY(-4px); }
    .price-card.highlight { border: 3px solid var(--gold); background: var(--gold); }
    .price-label { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 0.75rem; }
    .price-card.highlight .price-label { color: var(--ink-mid); }
    .price-amount { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 2.25rem; line-height: 1; color: #fff; margin-bottom: 0.4rem; }
    .price-card.highlight .price-amount { color: var(--ink); }
    .price-note { font-size: 0.8rem; color: rgba(255,255,255,0.45); }
    .price-card.highlight .price-note { color: var(--ink-mid); }

    /* Reviews */
    .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
    .review-card { background: var(--ink); padding: 2rem; border: 2px solid var(--ink); }
    .stars { color: var(--gold); font-size: 1rem; margin-bottom: 1rem; letter-spacing: 0.1em; }
    .review-quote { color: rgba(255,255,255,0.8); line-height: 1.65; font-style: italic; margin-bottom: 1.25rem; }
    .review-name { font-weight: 600; color: #fff; font-size: 0.9rem; }
    .review-hood { color: rgba(255,255,255,0.4); font-size: 0.78rem; }

    /* FAQ */
    .faq-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4rem; align-items: start; }
    .faq-list { }
    .faq-item { border-bottom: 2px solid var(--cream-dark); }
    .faq-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 0; background: none; border: none; cursor: pointer; text-align: left; gap: 1rem; }
    .faq-q { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.1rem; text-transform: uppercase; color: var(--ink); }
    .faq-chevron { flex-shrink: 0; color: var(--gold); font-size: 1.1rem; transition: transform 200ms; }
    .faq-chevron.open { transform: rotate(180deg); }
    .faq-body { overflow: hidden; max-height: 0; transition: max-height 300ms cubic-bezier(0.23,1,0.32,1); }
    .faq-body.open { max-height: 300px; }
    .faq-body p { color: var(--ink-mid); line-height: 1.7; padding-bottom: 1.2rem; font-size: 0.93rem; }

    /* Quote form */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    @media(max-width:480px){ .form-grid { grid-template-columns: 1fr; } }
    .form-label { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.4rem; }
    .form-input { width: 100%; padding: 0.75rem 1rem; border: 2px solid var(--cream-dark); background: var(--cream); font-size: 0.93rem; outline: none; transition: border-color 150ms; font-family: 'DM Sans', sans-serif; }
    .form-input:focus { border-color: var(--gold); }
    .form-mb { margin-bottom: 1rem; }
    .form-box { border: 3px solid var(--ink); padding: 2.5rem; background: #fff; }
    .form-success { display: none; text-align: center; padding: 3rem; }
    .form-success.show { display: block; }

    /* Footer */
    .gbbc-footer { background: var(--ink); border-top: 4px solid var(--gold); padding: 2.5rem 0; }
    .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
    .footer-brand { display: flex; align-items: center; gap: 0.6rem; }
    .footer-brand-icon { background: var(--gold); width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .footer-brand-text { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1.05rem; text-transform: uppercase; color: var(--gold); letter-spacing: 0.04em; }
    .footer-copy { color: rgba(255,255,255,0.35); font-size: 0.8rem; }
    .footer-phone { color: var(--gold); font-weight: 600; font-size: 0.9rem; text-decoration: none; }

    /* Animate on scroll */
    .aos { opacity: 0; transform: translateY(24px); transition: opacity 0.55s cubic-bezier(0.23,1,0.32,1), transform 0.55s cubic-bezier(0.23,1,0.32,1); }
    .aos.visible { opacity: 1; transform: none; }
    .aos-d1 { transition-delay: 80ms; }
    .aos-d2 { transition-delay: 160ms; }
    .aos-d3 { transition-delay: 240ms; }
  </style>
</head>

<body>

<!-- NAV -->
<nav class="gbbc-nav">
  <div class="container">
    <div class="inner">
      <a href="/book-gbbc" class="gbbc-logo">
        <div class="gbbc-logo-icon">🗑️</div>
        <span class="gbbc-logo-text">Golden Boy Bin Co.</span>
      </a>
      <nav class="nav-links">
        <a href="#services">Services</a>
        <a href="#results">Results</a>
        <a href="#schedule">Schedule</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href={PHONE_HREF} class="btn-gold" style="padding:0.45rem 1.25rem;font-size:0.88rem;">📞 Call Now</a>
      </nav>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero" style={`--hero-img: url(${HERO_IMG})`}>
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-location">
        <span>📍</span>
        <span>Golden, Colorado</span>
      </div>
      <h1>Your Bins,<br /><span>Spotless.</span></h1>
      <p>Trash can cleaning &amp; small power washing for Golden-area homeowners — done right after pickup, using up to 80% less water than a garden hose.</p>
      <div class="hero-btns">
        <a href="#schedule" class="btn-gold" style="font-size:1.2rem;padding:0.9rem 2.25rem;">Pick Your Trash Day</a>
        <a href={PHONE_HREF} class="btn-outline" style="font-size:1.1rem;padding:0.9rem 2rem;">📞 Call / Text</a>
      </div>
      <div class="hero-trust">
        <span>Local &amp; Insured</span>
        <span>No Contracts</span>
        <span>Water-Conscious</span>
      </div>
    </div>
  </div>
  <a href="#services" class="scroll-hint" aria-label="Scroll down">↓</a>
</section>

<!-- SERVICES -->
<section id="services" class="section" style="background:#fff;border-top:4px solid var(--ink)">
