---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    id: 'ai',
    heading: 'Automation and workflows',
    sub: 'Workflow tools I rely on daily.',
    tools: [
      {
        name: 'n8n',
        affiliate: false,
        desc: 'Open-source workflow automation with full code flexibility.',
        why: "My preferred automation tool for clients who want self-hosted control or complex conditional logic. More powerful than Zapier for custom workflows. Requires more setup but saves money and gives you full ownership long-term.",
        link: 'https://n8n.io',
        icon: 'n8',
      },
      {
        name: 'Make.com',
        affiliate: true,
        desc: 'Visual workflow automation with a generous free tier.',
        why: "When n8n is overkill and Zapier is too limiting, Make hits the middle. The visual builder makes multi-step flows easy to audit and hand off to clients. I use it for integrations that don't need self-hosting.",
        link: 'https://make.com',
        icon: 'Mk',
      },
    ],
  },
  {
    id: 'crm',
    heading: 'CRM and prospecting',
    sub: 'Where leads, contacts, and pipeline live.',
    tools: [
      {
        name: 'HubSpot',
        affiliate: true,
        desc: 'CRM, marketing, and sales hub with a generous free tier.',
        why: "Better starting point than Salesforce for most businesses under $5M in revenue. The free CRM is genuinely good. Marketing automation gets expensive fast, so scope carefully before you commit to the paid tiers.",
        link: 'https://www.hubspot.com',
        icon: 'HS',
      },
      {
        name: 'Apollo.io',
        affiliate: true,
        desc: 'Prospecting database with built-in outreach sequencing.',
        why: "I use this for lead list building and outbound sequencing. The contact database is solid for B2B. Works well as a first-touch channel before moving qualified leads into a CRM.",
        link: 'https://www.apollo.io',
        icon: 'Ap',
      },
      {
        name: 'Clay',
        affiliate: true,
        desc: 'Data enrichment and personalization at scale.',
        why: "The most powerful enrichment tool I've used. Pulls from 50+ data sources, runs custom logic across every row, and pipes clean data into your outreach or CRM. Steep learning curve — worth it for serious prospecting.",
        link: 'https://clay.com',
        icon: 'Cl',
      },
    ],
  },
  {
    id: 'marketing',
    heading: 'Marketing and outreach',
    sub: 'Lead generation, outbound, and visibility.',
    tools: [
      {
        name: 'Instantly',
        affiliate: true,
        desc: 'Cold email platform with deliverability infrastructure.',
        why: "Used for outbound email campaigns where deliverability matters. Handles sending volume, domain warming, and inbox rotation. Pair it with Apollo or Clay for a full prospecting-to-outreach stack.",
        link: 'https://instantly.ai',
        icon: 'In',
      },
    ],
  },
  {
    id: 'web',
    heading: 'Web and ops',
    sub: 'How sites get built and work gets managed.',
    tools: [
      {
        name: 'Astro',
        affiliate: false,
        desc: 'Static site framework with component islands.',
        why: "What this site is built on. Fast by default, flexible enough for dynamic features, and easy to deploy. Good choice for content-heavy marketing sites that need performance without a heavy CMS.",
        link: 'https://astro.build',
        icon: 'As',
      },
      {
        name: 'Netlify',
        affiliate: false,
        desc: 'Web hosting and deployment platform.',
        why: "Where zeisworks.com is deployed. Handles forms, edge functions, and CI/CD without needing a separate infrastructure setup. The free tier covers most small sites with no configuration overhead.",
        link: 'https://netlify.com',
        icon: 'Nt',
      },
      {
        name: 'Notion',
        affiliate: false,
        desc: 'Docs, wikis, and databases in one workspace.',
        why: "Where I manage project notes, client documentation, and internal processes. Works as a lightweight CMS for content that changes frequently. Every client gets a shared workspace as part of the engagement.",
        link: 'https://www.notion.so',
        icon: 'No',
      },
    ],
  },
];
---

<BaseLayout
  title="What I Use"
  description="The tools I actually use to run ZeisWorks and build for clients. If it's not here, I'm not using it."
  ogTitle="What I Use | zeisWorks"
  ogDescription="The tools I actually use to run ZeisWorks and build for clients. Updated when something changes."
>
  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Tools I actually use</p>
      <h1 class="font-serif text-4xl font-semibold text-ink leading-tight">
        What I Use
      </h1>
      <p class="mt-4 text-ink-mid text-lg leading-relaxed max-w-xl">
        Part of what you're paying for is knowing which tools are worth your time and which ones are noise. This is what I actually use to run ZeisWorks and build for clients. If it's not here, I'm not using it.
      </p>
    </div>

    <!-- Tool sections -->
    {sections.map(section => (
      <section id={section.id}>
        <h2 class="font-serif text-2xl font-semibold text-ink mb-1">{section.heading}</h2>
        <p class="text-ink-mid text-sm mb-6">{section.sub}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {section.tools.map(tool => (
            <div class="rounded-xl border border-cream-dark bg-cream p-5 flex flex-col gap-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-orange/10 flex items-center justify-center shrink-0">
                    <span class="text-xs font-bold text-orange font-mono">{tool.icon}</span>
                  </div>
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-serif font-semibold text-ink">{tool.name}</h3>
                      {tool.affiliate && (
                        <span class="text-xs bg-orange/10 text-orange px-2 py-0.5 rounded font-medium">affiliate</span>
                      )}
                    </div>
                    <p class="text-xs text-ink-light mt-0.5">{tool.desc}</p>
                  </div>
                </div>
                {tool.link && (
                  <a href={tool.link} target="_blank" rel="noopener noreferrer" class="text-xs text-navy font-medium shrink-0 hover:underline mt-1">
                    Visit →
                  </a>
                )}
              </div>
              <p class="text-sm text-ink leading-relaxed">{tool.why}</p>
            </div>
          ))}
        </div>

        {/* Contextual CTA after Automation section */}
        {section.id === 'ai' && (
          <div class="mt-6 p-5 rounded-xl border border-orange/20 bg-orange/5 flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1">
              <p class="text-sm font-semibold text-ink mb-1">Want this built for you?</p>
              <p class="text-sm text-ink-mid leading-relaxed">n8n and Make are powerful, but the setup takes time. I build custom automation stacks for service businesses — workflows that run without you touching them.</p>
            </div>
            <a href="/operations" class="shrink-0 text-sm font-medium text-navy border border-navy/30 rounded-lg px-4 py-2 hover:bg-navy hover:text-cream transition-colors whitespace-nowrap">
              See Operations →
            </a>
          </div>
        )}

        {/* Contextual CTA after CRM section */}
        {section.id === 'crm' && (
          <div class="mt-6 p-5 rounded-xl border border-orange/20 bg-orange/5 flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1">
              <p class="text-sm font-semibold text-ink mb-1">Need a full prospecting-to-close system?</p>
              <p class="text-sm text-ink-mid leading-relaxed">HubSpot, Apollo, and Clay are the stack — but getting them to talk to each other correctly is where most businesses get stuck. I set up the full pipeline and hand it off ready to run.</p>
            </div>
            <a href="/custom-tools" class="shrink-0 text-sm font-medium text-navy border border-navy/30 rounded-lg px-4 py-2 hover:bg-navy hover:text-cream transition-colors whitespace-nowrap">
              See Custom Tools →
            </a>
          </div>
        )}

        {/* Contextual CTA after Marketing section */}
        {section.id === 'marketing' && (
          <div class="mt-6 p-5 rounded-xl border border-orange/20 bg-orange/5 flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="flex-1">
              <p class="text-sm font-semibold text-ink mb-1">Don't have time to run outbound yourself?</p>
              <p class="text-sm text-ink-mid leading-relaxed">Instantly is the infrastructure. I handle the strategy, sequences, and list building — so the leads come in without you managing the platform.</p>
            </div>
            <a href="/marketing" class="shrink-0 text-sm font-medium text-navy border border-navy/30 rounded-lg px-4 py-2 hover:bg-navy hover:text-cream transition-colors whitespace-nowrap">
              See Marketing →
            </a>
          </div>
        )}
      </section>
    ))}

    <!-- Disclosure -->
    <div class="rounded-xl border border-cream-dark bg-cream-dark p-6">
      <p class="text-xs text-ink-light uppercase tracking-widest mb-2">Disclosure</p>
      <p class="text-sm text-ink-mid leading-relaxed">
        Some tools on this page are marked <span class="text-orange font-medium">affiliate</span> — I earn a commission if you sign up through my link, at no extra cost to you. I only list tools I actually use. If something stops being useful, it comes off this page.
      </p>
    </div>

  </div>
</BaseLayout>
