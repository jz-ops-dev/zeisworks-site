---
// Pre-launch placeholder. Fully self-contained on purpose: it links to none
// of the real site pages and uses inline (is:inline) styles/scripts so it has
// zero /_astro asset dependencies. That lets netlify.toml force-redirect every
// other route here while only the video + favicons need to pass through.
// Reversal: delete this file and the "Pre-launch placeholder" block in
// netlify.toml to restore the full site.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>ZeisWorks — Coming Soon</title>
    <meta
      name="description"
      content="ZeisWorks, run by Jack Zeis in Golden, Colorado, makes your business readable to AI. A new site is on the way — leave your email for first access."
    />

    <!-- Social-share preview. Page is noindex, but links still get shared in
         iMessage/Slack/LinkedIn — these give them a branded card. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZeisWorks" />
    <meta property="og:title" content="ZeisWorks — VIK: Visualized Institutional Knowledge" />
    <meta
      property="og:description"
      content="Institutional knowledge lives in people's heads. VIK is what you own when it stays. A new ZeisWorks site is on the way — leave your email for first access."
    />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ZeisWorks — VIK: Visualized Institutional Knowledge" />
    <meta
      name="twitter:description"
      content="Institutional knowledge lives in people's heads. VIK is what you own when it stays."
    />
    <meta name="twitter:image" content="/og.png" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500;1,600&family=DM+Sans:wght@300;400;500&family=DM+Mono&display=swap"
      rel="stylesheet"
    />

    <style is:inline>
      :root {
        --ink: #0f172a;
        --ink-mid: #475569;
        --ink-light: #64748b;
        --cream: #f8fafc;
        --cream-dark: #e2e8f0;
        --navy: #1e3a8a;
        --orange: #c2410c;
        --orange-bright: #ea580c;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      #vik, #notify { scroll-margin-top: 28px; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: "DM Sans", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .wrap {
        flex: 1;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        padding: 56px 24px 40px;
        display: flex;
        flex-direction: column;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
      }
      .brand svg { width: 36px; height: 36px; border-radius: 9px; }
      .brand .name {
        font-family: "Lora", Georgia, serif;
        font-weight: 600;
        font-size: 1.35rem;
        letter-spacing: -0.01em;
      }
      .brand .name .dot { color: var(--orange-bright); }
      .eyebrow {
        font-family: "DM Mono", monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--orange);
        margin: 0 0 18px;
      }
      h1 {
        font-family: "Lora", Georgia, serif;
        font-weight: 600;
        font-size: clamp(2rem, 6vw, 2.85rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 28px;
      }
      .lede {
        font-size: 1.075rem;
        line-height: 1.7;
        color: var(--ink-mid);
        margin: 0 0 18px;
        max-width: 56ch;
      }
      .lede + .lede { margin-top: 4px; }

      /* ── VIK: the named deliverable you own (leads; ICM sits underneath) ── */
      .vik { margin: 28px 0 36px; }
      .vik .eyebrow { margin: 0 0 12px; }
      .vik-h {
        font-family: "Lora", Georgia, serif;
        font-weight: 600;
        font-size: clamp(1.5rem, 4.5vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 16px;
      }
      .vik-lede {
        font-size: 1rem;
        line-height: 1.65;
        color: var(--ink-mid);
        margin: 0 0 20px;
        max-width: 60ch;
      }
      /* The "you own this" plate deliberately rhymes with the ICM plate below:
         two layers — the deliverable (VIK) and the method (ICM). */
      .vik-card {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
        border: 2px solid var(--orange);
        background: rgba(194, 65, 12, 0.05);
        border-radius: 12px;
        padding: 14px 16px;
      }
      .vik-tag {
        flex: none;
        font-family: "DM Mono", monospace;
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--orange);
        border: 1px solid rgba(194, 65, 12, 0.45);
        border-radius: 6px;
        padding: 3px 7px;
      }
      .vik-thesis {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.55;
        color: var(--ink-mid);
      }
      .vik-thesis strong { color: var(--ink); font-weight: 600; }

      /* ── ICM: three appeals → one method ── */
      .appeals { margin: 32px 0; }
      .appeals .eyebrow { margin: 0 0 12px; }
      .appeals-intro {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-mid);
        margin: 0 0 24px;
        max-width: 60ch;
      }
      .appeals-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-bottom: 40px;
      }
      .appeal {
        position: relative;
        background: #fff;
        border: 1px solid var(--cream-dark);
        border-left: 3px solid var(--orange);
        border-radius: 12px;
        padding: 16px 16px 18px;
      }
      .appeal .greek {
        font-family: "Lora", Georgia, serif;
        font-style: italic;
        font-weight: 600;
        font-size: 1.35rem;
        line-height: 1.1;
        color: var(--ink);
        margin: 0 0 6px;
      }
      .appeal .gloss {
        font-size: 0.86rem;
        line-height: 1.5;
        color: var(--ink-mid);
        margin: 0;
      }
      .appeal .trace {
        display: block;
        height: 2px;
        margin: 14px 0 10px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--orange), rgba(194, 65, 12, 0.25));
        transform: scaleX(1);
        transform-origin: left center;
      }
      .appeal .maps {
        font-family: "DM Mono", monospace;
        font-size: 0.72rem;
        color: var(--orange);
        margin: 0;
      }
      .appeal .maps::before { content: "→ "; opacity: 0.7; }
      .appeal .connector {
        position: absolute;
        left: 50%;
        bottom: -28px;
        width: 2px;
        height: 28px;
        background: linear-gradient(rgba(194, 65, 12, 0.55), rgba(194, 65, 12, 0.2));
        transform: translateX(-50%) scaleY(1);
        transform-origin: top center;
      }
      .appeals-icm {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        border: 2px solid var(--orange);
        background: rgba(194, 65, 12, 0.05);
        border-radius: 12px;
        padding: 14px 16px;
      }
      .appeals-icm .tag {
        flex: none;
        font-family: "DM Mono", monospace;
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--orange);
        border: 1px solid rgba(194, 65, 12, 0.45);
        border-radius: 6px;
        padding: 3px 7px;
      }
      .appeals-icm .txt {
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--ink-mid);
      }
      @media (min-width: 560px) {
        .appeals-grid { grid-template-columns: repeat(3, 1fr); }
      }
      @media (max-width: 559px) {
        .appeal .connector { display: none; }
      }

      /* Motion-on path. Armed by JS only when motion is allowed; the resting
         state above stays fully revealed for no-JS / reduced-motion. */
      .appeals.is-armed .appeal {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
        transition-delay: calc(var(--i) * 0.16s);
      }
      .appeals.is-armed.play .appeal { opacity: 1; transform: none; }
      .appeals.is-armed .trace {
        transform: scaleX(0);
        transition: transform 0.7s var(--ease);
        transition-delay: calc(var(--i) * 0.16s + 0.45s);
      }
      .appeals.is-armed.play .trace { transform: scaleX(1); }
      .appeals.is-armed .maps {
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
        transition-delay: calc(var(--i) * 0.16s + 0.9s);
      }
      .appeals.is-armed.play .maps { opacity: 1; transform: none; }
      .appeals.is-armed .connector {
        transform: translateX(-50%) scaleY(0);
        transition: transform 0.5s var(--ease);
        transition-delay: calc(var(--i) * 0.16s + 1.15s);
      }
      .appeals.is-armed.play .connector { transform: translateX(-50%) scaleY(1); }
      .appeals.is-armed .appeals-icm {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
        transition-delay: 1.5s;
      }
      .appeals.is-armed.play .appeals-icm {
        opacity: 1;
        transform: none;
        animation: icmLock 0.9s var(--ease) 1.7s both;
      }
      @keyframes icmLock {
        0% { box-shadow: 0 0 0 0 rgba(194, 65, 12, 0); }
        45% { box-shadow: 0 0 0 7px rgba(194, 65, 12, 0.12); }
        100% { box-shadow: 0 0 0 0 rgba(194, 65, 12, 0); }
      }

      /* Sample production layer: the file the ICM plate points to. */
      .sample-lead {
        font-size: 0.82rem;
        color: var(--ink-light);
        margin: 16px 0 8px;
      }
      .sample {
        margin: 0;
        background: #fff;
        border: 1px solid var(--cream-dark);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
      }
      .sample-bar {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--cream-dark);
        background: rgba(15, 23, 42, 0.02);
      }
      .sample-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--cream-dark); }
      .sample-name {
        font-family: "DM Mono", monospace;
        font-size: 0.72rem;
        color: var(--ink-mid);
        margin-left: 6px;
      }
      .sample-tag {
        margin-left: auto;
        font-family: "DM Mono", monospace;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--orange);
        border: 1px solid rgba(194, 65, 12, 0.35);
        border-radius: 5px;
        padding: 2px 6px;
      }
      .sample-body {
        margin: 0;
        padding: 14px 16px;
        font-family: "DM Mono", monospace;
        font-size: 0.78rem;
        line-height: 1.85;
        color: var(--ink);
        white-space: pre;
        overflow-x: auto;
      }
      .sample-body .c { color: var(--orange); }
      .appeals.is-armed .sample,
      .appeals.is-armed .sample-lead {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
        transition-delay: 2s;
      }
      .appeals.is-armed.play .sample,
      .appeals.is-armed.play .sample-lead { opacity: 1; transform: none; }
      /* ── Hero: the intro clip now lives IN the page as a full-bleed banner ──
         The clip plays as a dimmed, looping texture behind a brand gradient +
         scrim. If it can't autoplay (reduced-motion, no-JS, blocked, or the
         browser lacks the codec), the gradient hero stands on its own. */
      .hero {
        position: relative;
        isolation: isolate;
        min-height: clamp(520px, 86vh, 820px);
        display: flex;
        overflow: hidden;
        color: #fff;
        background:
          radial-gradient(125% 90% at 88% 0%, rgba(224, 69, 48, 0.34), transparent 58%),
          linear-gradient(158deg, #123a31 0%, #0c2620 55%, #071a16 100%);
      }
      .hero-video {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1.2s var(--ease);
      }
      .hero-video.is-playing { opacity: 0.78; }
      /* Scrim weighted to the bottom-left, where the headline sits. */
      .hero-scrim {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          linear-gradient(to top, rgba(6, 18, 15, 0.94) 0%, rgba(6, 18, 15, 0.45) 48%, rgba(6, 18, 15, 0.28) 100%),
          linear-gradient(to right, rgba(6, 18, 15, 0.62), transparent 62%);
      }
      /* Same 640 column as the body below, so the hero headline and the VIK
         section share one left edge — the whole page reads on one axis while
         the gradient/video stay full-bleed. */
      .hero-inner {
        position: relative;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        padding: 30px 24px clamp(40px, 7vh, 72px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 48px;
      }
      .brand--on-dark .name { color: #fff; }
      .brand--on-dark .name .dot { color: #F0A184; }
      .hero-copy { max-width: 100%; }
      .eyebrow--accent { color: #F0A184; margin-bottom: 16px; }
      .hero-h1 {
        font-family: "Lora", Georgia, serif;
        font-weight: 600;
        font-size: clamp(2.05rem, 6vw, 3.45rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin: 0 0 22px;
        color: #fff;
        text-wrap: balance;
      }
      .hero-h1 .accent { color: #F0A184; font-style: italic; }
      .hero-sub {
        font-size: clamp(1.05rem, 1.9vw, 1.3rem);
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.86);
        max-width: 54ch;
        margin: 0 0 30px;
      }
      .hero-sub strong { color: #fff; font-weight: 600; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
      .btn-primary, .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 26px;
        font: inherit;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 999px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.18s var(--ease), border-color 0.18s var(--ease), transform 0.18s var(--ease);
      }
      .btn-primary { color: #fff; background: var(--orange); }
      .btn-primary:hover { background: var(--orange-bright); transform: translateY(-1px); }
      .btn-ghost { color: #fff; font-weight: 500; background: transparent; border: 1px solid rgba(255, 255, 255, 0.45); }
      .btn-ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.7); }
      .btn-primary:focus-visible, .btn-ghost:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      .capture { margin-top: 8px; }
      .capture label {
        display: block;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--ink);
        margin-bottom: 10px;
      }
      .field { display: flex; gap: 10px; flex-wrap: wrap; }
      .field input[type="email"] {
        flex: 1 1 220px;
        min-width: 0;
        padding: 13px 15px;
        font: inherit;
        font-size: 1rem;
        color: var(--ink);
        background: #fff;
        border: 1px solid var(--cream-dark);
        border-radius: 11px;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .field input[type="email"]:focus {
        border-color: var(--navy);
        box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12);
      }
      .field button {
        flex: 0 0 auto;
        padding: 13px 22px;
        font: inherit;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        background: var(--orange);
        border: 0;
        border-radius: 11px;
        cursor: pointer;
        transition: background 0.15s;
      }
      .field button:hover { background: var(--orange-bright); }
      .field button:focus-visible {
        outline: 2px solid var(--navy);
        outline-offset: 2px;
      }
      .field button:disabled { opacity: 0.6; cursor: default; }
      .hp { position: absolute; left: -9999px; opacity: 0; }
      .note { font-size: 0.82rem; color: var(--ink-light); margin-top: 12px; }
      .success {
        margin-top: 8px;
        padding: 16px 18px;
        background: #fff;
        border: 1px solid var(--cream-dark);
        border-radius: 12px;
        font-size: 1rem;
        color: var(--ink);
      }
      .success strong { color: var(--navy); }
      .hidden { display: none; }
      footer {
        max-width: 640px;
        margin: 40px auto 0;
        width: 100%;
        padding: 20px 24px 28px;
        font-family: "DM Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.03em;
        color: var(--ink-light);
        border-top: 1px solid var(--cream-dark);
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; }
        html { scroll-behavior: auto; }
        /* Don't autoplay the hero clip; the gradient hero stands on its own. */
        .hero-video { display: none; }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <video class="hero-video" id="zw-hero-video" muted loop playsinline preload="auto" aria-hidden="true">
        <source src="/intro.mp4" type="video/mp4" />
      </video>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="brand brand--on-dark">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="100" height="100" rx="22" fill="#E04530" />
            <rect x="15" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="40" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="65" y="15" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="40" y="40" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="15" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="40" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
            <rect x="65" y="65" width="20" height="20" rx="4" fill="#FAF8F3" />
          </svg>
          <span class="name">zeisWorks<span class="dot">.</span></span>
        </div>

        <div class="hero-copy">
          <p class="eyebrow eyebrow--accent">ZeisWorks &middot; Coming soon</p>
          <h1 class="hero-h1">
            Your institutional knowledge shouldn't
            <span class="accent">walk out the door.</span>
          </h1>
          <p class="hero-sub">
            We build your <strong>VIK</strong> &mdash; Visualized Institutional
            Knowledge: a living system that holds how your business runs and keeps
            working when your people move on.
          </p>
          <div class="hero-actions">
            <a class="btn-primary" href="#notify">Get first access &rarr;</a>
            <a class="btn-ghost" href="#vik">What's a VIK?</a>
          </div>
        </div>
      </div>
    </header>

    <main class="wrap">
      <section class="vik" id="vik" aria-label="VIK — Visualized Institutional Knowledge, the deliverable you own">
        <p class="eyebrow">What you own</p>
        <h2 class="vik-h">VIK — Visualized Institutional Knowledge.</h2>
        <p class="vik-lede">
          Institutional knowledge lives in people's heads. It walks out the door
          when they do. Your VIK is what you own when it stays — a living,
          queryable system that holds how your business runs and does work with
          it. Not a slide. Not a diagram. A working system you keep.
        </p>
        <div class="vik-card">
          <span class="vik-tag">VIK</span>
          <p class="vik-thesis">
            Tools depreciate. Context compounds. ICM is how we compound it.
            <strong>VIK is what you own when we're done.</strong>
          </p>
        </div>
      </section>

      <section class="appeals" data-appeals aria-label="The three appeals behind Interpretable Context Methodology">
        <p class="eyebrow">The method, in three appeals</p>
        <p class="appeals-intro">
          Three classical ways to be believed — ethos, pathos, logos — each built
          into how the AI actually works. That's ICM: trust by structure, not
          performance.
        </p>
        <div class="appeals-grid">
          <div class="appeal" style="--i:0">
            <p class="greek">Ethos</p>
            <p class="gloss">Credibility — authority that's sourced, not asserted.</p>
            <span class="trace" aria-hidden="true"></span>
            <p class="maps">Identity + traceability</p>
            <span class="connector" aria-hidden="true"></span>
          </div>
          <div class="appeal" style="--i:1">
            <p class="greek">Pathos</p>
            <p class="gloss">The felt experience — confidence that's earned, not performed.</p>
            <span class="trace" aria-hidden="true"></span>
            <p class="maps">Working outputs</p>
            <span class="connector" aria-hidden="true"></span>
          </div>
          <div class="appeal" style="--i:2">
            <p class="greek">Logos</p>
            <p class="gloss">Reason and evidence — logic you can inspect, not hidden.</p>
            <span class="trace" aria-hidden="true"></span>
            <p class="maps">Routing + reference</p>
            <span class="connector" aria-hidden="true"></span>
          </div>
        </div>
        <div class="appeals-icm">
          <span class="tag">ICM</span>
          <span class="txt">
            Interpretable Context Methodology — every answer traces back to a file
            you can read and edit.
          </span>
        </div>

        <p class="sample-lead">One of those files, in production:</p>
        <figure class="sample" aria-label="A sample production file from the routing layer">
          <figcaption class="sample-bar">
            <span class="sample-dot" aria-hidden="true"></span>
            <span class="sample-dot" aria-hidden="true"></span>
            <span class="sample-dot" aria-hidden="true"></span>
            <span class="sample-name">routing.md</span>
            <span class="sample-tag">production layer</span>
          </figcaption>
          <pre class="sample-body"><span class="c"># the AI reads the right file for each question</span>
pricing      → reference/pricing.md
refund       → reference/refund-policy.md
tone & voice → identity.md
escalation   → working/handoffs.md</pre>
        </figure>
      </section>

      <p class="lede" id="notify">
        We're rebuilding the site around your VIK. Leave your email and we'll tell
        you the moment it's live.
      </p>

      <form
        id="waitlist-form"
        class="capture"
        name="waitlist"
        method="POST"
        action="/coming-soon/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="waitlist" />
        <p class="hp">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>
        <label for="email">Want first access?</label>
        <div class="field">
          <input
            id="email"
            type="email"
            name="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
          />
          <button type="submit">Notify me</button>
        </div>
        <p class="note">No spam. One email, when we launch.</p>
      </form>

      <div id="waitlist-success" class="success hidden" role="status" aria-live="polite">
        <strong>You're on the list.</strong> We'll be in touch when the new site goes live.
      </div>
    </main>

    <footer>
      &copy; {new Date().getFullYear()} ZeisWorks, a High Range Living LLC company &middot; Golden, CO
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Hero clip: loop quietly as a background texture. Fade it in only once
        // it's actually playing, so a blocked/codec-less clip leaves the gradient
        // hero untouched. Reduced-motion never starts it (CSS hides it too).
        var heroVideo = document.getElementById("zw-hero-video");
        if (heroVideo && !reduce) {
          heroVideo.addEventListener("playing", function () {
            heroVideo.classList.add("is-playing");
          }, { once: true });
          var hp = heroVideo.play();
          if (hp && typeof hp.catch === "function") hp.catch(function () {});
        }

        // ICM appeals: play the convergence once it scrolls into view.
        var appeals = document.querySelector("[data-appeals]");
        if (appeals && !reduce && "IntersectionObserver" in window) {
          appeals.classList.add("is-armed");
          var appealsObs = new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("play");
              obs.unobserve(entry.target);
            });
          }, { threshold: 0.25 });
          appealsObs.observe(appeals);
        }

        var form = document.getElementById("waitlist-form");
        if (!form) return;
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var btn = form.querySelector("button");
          if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
          var body = new URLSearchParams(new FormData(form)).toString();
          fetch(form.getAttribute("action"), {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body,
          })
            .then(function () {
              form.classList.add("hidden");
              document.getElementById("waitlist-success").classList.remove("hidden");
            })
            .catch(function () {
              // Fall back to a normal submission so the email is never lost.
              form.submit();
            });
        });
      })();
    </script>
  </body>
</html>
