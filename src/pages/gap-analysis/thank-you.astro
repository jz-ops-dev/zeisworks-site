---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Request received — zeisWorks"
  description="Your gap analysis request has been received. I'll run the analysis and send you the results within 48 hours."
>

<style>
  .ty-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    background: var(--cream);
  }
  .ty-inner {
    max-width: 600px;
    width: 100%;
    text-align: center;
  }
  .ty-icon {
    width: 64px;
    height: 64px;
    background: var(--forest-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
  }
  .ty-icon svg {
    width: 28px;
    height: 28px;
    stroke: var(--forest-mid);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ty-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 1rem;
  }
  .ty-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .ty-body {
    font-size: 1rem;
    color: var(--ink-mid);
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }
  .ty-steps {
    background: var(--cream-dark);
    border: 1px solid #E8E3D8;
    border-radius: 1rem;
    padding: 1.75rem;
    text-align: left;
    margin-bottom: 2.5rem;
  }
  .ty-steps-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-light);
    margin-bottom: 1.25rem;
  }
  .ty-step {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .ty-step:last-child { margin-bottom: 0; }
  .ty-step-num {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border-radius: 50%;
    background: var(--terra-light);
    color: var(--terra);
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    font-family: var(--font-sans);
  }
  .ty-step p {
    font-size: 0.9rem;
    color: var(--ink-mid);
    line-height: 1.6;
    margin: 0;
  }
  .ty-step p strong {
    color: var(--ink);
    font-weight: 500;
    display: block;
    margin-bottom: 0.125rem;
  }
  .ty-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--terra);
    color: #fff;
    padding: 0.8rem 1.75rem;
    border-radius: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover { background: var(--terra-dark); transform: translateY(-1px); }
  .btn-ghost {
    color: var(--ink-mid);
    font-size: 0.9375rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1.5rem;
    border: 1.5px solid #D8D3C8;
    border-radius: 0.625rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--terra); color: var(--terra); }
</style>

<section class="ty-section">
  <div class="ty-inner">
    <div class="ty-icon">
      <svg viewBox="0 0 24 24">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>

    <p class="ty-label">Request received</p>
    <h1 class="ty-title">You're all set.<br>I'll take it from here.</h1>
    <p class="ty-body">
      Your gap analysis request has been received. I'll run the full analysis on your business
      and send the results directly to your inbox — typically within 48 hours.
    </p>

    <div class="ty-steps">
      <p class="ty-steps-label">What happens next</p>
      <div class="ty-step">
        <div class="ty-step-num">1</div>
        <p>
          <strong>I run the analysis</strong>
          I'll audit your AI visibility, local search presence, and competitive positioning — no action needed from you.
        </p>
      </div>
      <div class="ty-step">
        <div class="ty-step-num">2</div>
        <p>
          <strong>You get the results</strong>
          A written breakdown lands in your inbox within 48 hours. It'll show exactly where the gaps are and what to do about them.
        </p>
      </div>
      <div class="ty-step">
        <div class="ty-step-num">3</div>
        <p>
          <strong>You decide what's next</strong>
          No pressure. You can act on the findings yourself, have me handle it, or schedule a call to go deeper. The report stands on its own.
        </p>
      </div>
    </div>

    <div class="ty-actions">
      <a href="/guides/" class="btn-primary">Read the guides while you wait →</a>
      <a href="/" class="btn-ghost">Back to home</a>
    </div>
  </div>
</section>

</BaseLayout>
