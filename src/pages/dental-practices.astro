---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How do I get my dental practice into the Google Maps 3-pack?",
    a: "The three highest-leverage actions are: (1) fully completing and optimizing your Google Business Profile with all service categories, photos, and a consistent NAP; (2) building review velocity — a steady stream of recent 5-star reviews; and (3) ensuring your practice is listed consistently across key dental directories like Healthgrades, Zocdoc, and Yelp. Most practices see meaningful ranking improvements within 60–90 days of addressing all three.",
  },
  {
    q: "What keywords should a dental practice target for local SEO?",
    a: "Start with your core service terms combined with your city or neighborhood: 'dentist [city]', 'family dentist [city]', 'teeth whitening [city]', 'emergency dentist [city]'. Don't ignore high-value specialty terms like 'Invisalign provider [city]' or 'dental implants [city]' — these searches have high commercial intent and convert at a premium.",
  },
  {
    q: "How important are patient reviews for dental practice SEO?",
    a: "Reviews are a top-3 local ranking signal. Google weighs both review quantity and recency. A practice with 200 reviews but none in the last 6 months will often rank below a competitor with 80 reviews and a consistent stream of new ones. The goal is a review acquisition system that generates 3–5 new reviews per month, not a one-time push.",
  },
  {
    q: "Should my dental practice use Google Ads or focus on organic SEO?",
    a: "For new patient acquisition, both have a role. Organic SEO builds a durable, compounding asset — rankings you own. Google Ads provide immediate visibility for high-value terms like 'dental implants near me' or 'emergency dentist open now'. The right approach for most practices is to build the organic foundation first, then layer in targeted paid campaigns for your highest-margin services.",
  },
  {
    q: "What does a Marketing Gap Analysis include for a dental practice?",
    a: "The analysis covers your Google Business Profile completeness, local search rankings for your core services benchmarked against your top 3–5 competitors, citation consistency across dental directories, review velocity and rating compared to competitors, and a prioritized list of specific fixes. Most practices have 3–5 quick wins they can act on immediately.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Dental Practice Marketing & Local SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'ZeisWorks',
    url: 'https://zeisworks.com',
  },
  description: 'Local SEO, Google Business Profile optimization, and new patient acquisition systems for independent dental practices.',
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: 'Marketing Consulting',
};
---

<BaseLayout
  title="Dental Practice Marketing & Local SEO"
  description="Get your dental practice into the Google Maps 3-pack and drive more new patient calls. Local SEO, GBP optimization, and review systems built for independent dentists."
  ogTitle="Dental Practice Marketing & Local SEO | zeisWorks"
  ogDescription="More new patient calls from organic search. Local SEO and Google Business Profile optimization built for independent dental practices."
  canonicalUrl="https://zeisworks.com/dental-practices/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <nav class="text-sm text-ink-mid mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">Dental Practices</li>
        </ol>
      </nav>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Dental Practices</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink leading-tight mb-6">
        More new patients.<br class="hidden sm:block" /> From the searches<br class="hidden sm:block" /> already happening.
      </h1>
      <p class="text-ink-mid text-lg leading-relaxed max-w-xl mb-8">
        Every day, people in your area search "dentist near me" and "family dentist [your city]." The practice that shows up in the top 3 gets the call. I build the local search presence that puts you there — and keeps you there.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/gap-analysis" class="bg-navy text-cream text-sm px-5 py-2.5 rounded-lg hover:bg-navy/90 transition-colors font-medium">
          Get a free Gap Analysis →
        </a>
        <a href="/local-search-checklist" class="border border-ink-light text-ink-mid text-sm px-5 py-2.5 rounded-lg hover:border-navy hover:text-navy transition-colors font-medium">
          Free Local Search Checklist
        </a>
      </div>
    </div>

    <!-- Outcome strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-y border-cream-dark">
      {[
        { stat: '90 days', label: 'to top-3 Maps placement in competitive markets' },
        { stat: '5.0 ★', label: 'Upwork rating · 100% Job Success Score' },
        { stat: '$0', label: 'to find out if I can help — gap analysis is free' },
        { stat: '1 person', label: 'direct line, no handoffs, no account managers' },
      ].map(({ stat, label }) => (
        <div>
          <div class="font-serif text-2xl font-semibold text-ink mb-1">{stat}</div>
          <div class="text-xs text-ink-mid leading-snug">{label}</div>
        </div>
      ))}
    </div>

    <!-- The problem -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">The problem</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-5">New patient acquisition shouldn't depend entirely on referrals.</h2>
      <div class="space-y-4 text-ink-mid leading-relaxed">
        <p>
          Referrals are valuable. But they're unpredictable, and they don't scale. The practices that grow consistently have a second engine: local search. When someone new to the area searches for a dentist, or when an existing patient's friend needs a recommendation and turns to Google instead of asking — that's where organic search wins or loses.
        </p>
        <p>
          The challenge is that most dental practices set up a Google Business Profile once and never touch it again. They don't have a system for generating reviews. Their website isn't optimized for the specific services they want to grow. And they're competing against practices that have invested in exactly these things.
        </p>
        <p>
          The gap is closable. And it closes faster than most practice owners expect.
        </p>
      </div>
    </section>

    <!-- What's included -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">What's included</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">A complete local search system for your practice.</h2>
      <div class="space-y-6">
        {[
          {
            title: 'Google Business Profile Optimization',
            body: 'Your GBP is the single most important asset for local search visibility. I audit and optimize every field — service categories, photos, Q&A, posts, and the specific attributes that influence your Maps ranking.',
          },
          {
            title: 'Review Acquisition System',
            body: 'A consistent stream of new reviews is a top-3 local ranking signal. I build a simple system that asks patients for a review at the right moment — right after a positive appointment — and routes them directly to your Google profile.',
          },
          {
            title: 'Dental Directory Citations',
            body: 'Consistent NAP data across Healthgrades, Zocdoc, Yelp, WebMD, and 40+ other directories signals legitimacy to Google. I audit, fix, and build the citations your competitors already have.',
          },
          {
            title: 'Service Page SEO',
            body: 'Each high-value service you offer — implants, Invisalign, whitening, emergency care — deserves its own optimized page. I build or optimize these pages to rank for the specific searches that drive your highest-margin appointments.',
          },
          {
            title: 'Conversion Optimization',
            body: 'Getting found is step one. Getting the call is step two. I audit your booking flow and contact page to remove friction and increase the percentage of visitors who actually reach out.',
          },
        ].map(({ title, body }) => (
          <div class="flex gap-4 items-start">
            <span class="mt-2 w-2 h-2 rounded-full bg-orange shrink-0"></span>
            <div>
              <h3 class="font-semibold text-ink mb-1">{title}</h3>
              <p class="text-ink-mid text-sm leading-relaxed">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <p class="text-sm font-medium text-orange uppercase tracking-widest mb-3">Common questions</p>
      <h2 class="font-serif text-3xl font-semibold text-ink mb-8">What dentists ask before getting started.</h2>
      <div class="space-y-6">
        {faqItems.map(({ q, a }) => (
          <div class="border-b border-cream-dark pb-6">
            <h3 class="font-semibold text-ink mb-2">{q}</h3>
            <p class="text-ink-mid text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy text-cream rounded-2xl p-10 text-center">
      <h2 class="font-serif text-3xl font-semibold mb-4">See exactly where your practice is losing new patients to competitors.</h2>
      <p class="text-cream/75 mb-8 max-w-lg mx-auto leading-relaxed">
        The free Gap Analysis shows how your local search presence compares to your top 3–5 competitors — with specific fixes and priorities. No call required. Results in your inbox within 12 hours.
      </p>
      <a href="/gap-analysis" class="inline-block bg-white text-ink font-medium px-8 py-3 rounded-lg hover:bg-cream transition-colors">
        Get your free Gap Analysis →
      </a>
      <p class="text-cream/50 text-xs mt-4">Free. No call required. No obligation.</p>
    </section>

  </div>
</BaseLayout>
