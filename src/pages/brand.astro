---
import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
  { name: 'Cream', token: 'cream', hex: '#FAF8F3', textClass: 'text-ink', desc: 'Page background' },
  { name: 'Cream Dark', token: 'cream-dark', hex: '#F0EAD9', textClass: 'text-ink', desc: 'Borders, dividers' },
  { name: 'Ink', token: 'ink', hex: '#1E1C18', textClass: 'text-cream', desc: 'Primary text' },
  { name: 'Ink Mid', token: 'ink-mid', hex: '#5A5650', textClass: 'text-cream', desc: 'Secondary text' },
  { name: 'Ink Light', token: 'ink-light', hex: '#9A9590', textClass: 'text-ink', desc: 'Muted text, captions' },
  { name: 'Navy', token: 'navy', hex: '#2D4A6B', textClass: 'text-cream', desc: 'Links, CTAs, logo mark' },
  { name: 'Forest', token: 'forest', hex: '#2C4A3E', textClass: 'text-cream', desc: 'Code blocks' },
  { name: 'Orange', token: 'orange', hex: '#C85A20', textClass: 'text-cream', desc: 'Accent, logo period' },
];

const extendedColors = [
  { name: 'Terra Light', hex: '#D6E0EC', textClass: 'text-ink' },
  { name: 'Terra Dark', hex: '#1E3350', textClass: 'text-cream' },
  { name: 'Orange Light', hex: '#F2E0D5', textClass: 'text-ink' },
  { name: 'Forest Mid', hex: '#3D6B5A', textClass: 'text-cream' },
  { name: 'Forest Light', hex: '#D8EAE4', textClass: 'text-ink' },
  { name: 'Forest Dark', hex: '#1C3029', textClass: 'text-cream' },
];
---

<BaseLayout
  title="Brand Kit"
  description="zeisWorks brand assets — colors, typography, logo, and usage guidelines."
>
  <meta name="robots" content="noindex" slot="head" />
  <div class="max-w-3xl mx-auto px-6 py-16 space-y-20">

    <!-- Header -->
    <div>
      <p class="text-sm font-medium text-ink-mid uppercase tracking-widest mb-3">Brand Kit</p>
      <h1 class="font-serif text-4xl font-semibold text-ink leading-tight">
        zeisWorks<span class="text-orange">.</span> Visual Identity
      </h1>
      <p class="mt-4 text-ink-mid text-lg">
        A reference for colors, typography, logo usage, and UI patterns used across zeisWorks.
      </p>
    </div>

    <!-- Logo -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">Logo</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <!-- Light background -->
        <div class="rounded-xl border border-cream-dark bg-cream p-10 flex flex-col items-center gap-6">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-10 h-10 shrink-0">
              <rect width="32" height="32" rx="6" fill="#2D3F6B"/>
              <text x="16" y="23" font-family="Georgia, serif" font-size="20" font-weight="700" text-anchor="middle" fill="#FAF8F3">Z</text>
            </svg>
            <span class="font-serif text-2xl font-semibold text-ink">
              zeisWorks<span class="text-orange">.</span>
            </span>
          </div>
          <p class="text-xs text-ink-light">On light / cream</p>
        </div>
        <!-- Dark background -->
        <div class="rounded-xl bg-ink p-10 flex flex-col items-center gap-6">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-10 h-10 shrink-0">
              <rect width="32" height="32" rx="6" fill="#2D4A6B"/>
              <text x="16" y="23" font-family="Georgia, serif" font-size="20" font-weight="700" text-anchor="middle" fill="#FAF8F3">Z</text>
            </svg>
            <span class="font-serif text-2xl font-semibold text-cream">
              zeisWorks<span class="text-orange">.</span>
            </span>
          </div>
          <p class="text-xs text-ink-light">On dark</p>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-cream-dark bg-cream p-6 space-y-3">
        <h3 class="font-serif font-semibold text-ink">Mark only</h3>
        <div class="flex items-end gap-6">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-8 h-8">
            <rect width="32" height="32" rx="6" fill="#2D3F6B"/>
            <text x="16" y="23" font-family="Georgia, serif" font-size="20" font-weight="700" text-anchor="middle" fill="#FAF8F3">Z</text>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-12 h-12">
            <rect width="32" height="32" rx="6" fill="#2D3F6B"/>
            <text x="16" y="23" font-family="Georgia, serif" font-size="20" font-weight="700" text-anchor="middle" fill="#FAF8F3">Z</text>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-16 h-16">
            <rect width="32" height="32" rx="6" fill="#2D3F6B"/>
            <text x="16" y="23" font-family="Georgia, serif" font-size="20" font-weight="700" text-anchor="middle" fill="#FAF8F3">Z</text>
          </svg>
        </div>
        <p class="text-sm text-ink-mid">Navy mark (#2D3F6B) with cream "Z" on rounded rectangle. Use as favicon and icon-only contexts.</p>
      </div>
    </section>

    <!-- Primary Colors -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-2">Colors</h2>
      <p class="text-ink-mid mb-6">Primary palette used throughout the site and Tailwind config.</p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
        {colors.map(c => (
          <div class="rounded-xl overflow-hidden border border-cream-dark">
            <div class="h-20" style={`background:${c.hex}`}></div>
            <div class="p-3 bg-cream">
              <p class="font-medium text-sm text-ink">{c.name}</p>
              <p class="font-mono text-xs text-ink-mid mt-0.5">{c.hex}</p>
              <p class="text-xs text-ink-light mt-1">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <h3 class="font-serif font-semibold text-ink mb-3">Extended palette</h3>
      <p class="text-sm text-ink-mid mb-4">Tints and shades used on the homepage and in detailed UI work.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {extendedColors.map(c => (
          <div class="rounded-xl overflow-hidden border border-cream-dark">
            <div class="h-14" style={`background:${c.hex}`}></div>
            <div class="p-3 bg-cream">
              <p class="font-medium text-sm text-ink">{c.name}</p>
              <p class="font-mono text-xs text-ink-mid mt-0.5">{c.hex}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">Typography</h2>

      <div class="space-y-6">
        <!-- Serif -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <div class="flex items-start justify-between mb-4">
            <div>
              <p class="text-xs text-ink-light uppercase tracking-widest mb-1">Serif — Headlines</p>
              <p class="font-medium text-ink">Lora</p>
            </div>
            <span class="text-xs font-mono bg-cream-dark text-ink-mid px-2 py-1 rounded">Google Fonts</span>
          </div>
          <p class="font-serif text-4xl font-semibold text-ink leading-tight mb-2">
            Operations that actually work.
          </p>
          <p class="font-serif text-2xl text-ink mb-2">Salesforce done right.</p>
          <p class="font-serif text-xl italic text-ink-mid">
            "Clear systems, real results."
          </p>
          <div class="mt-4 pt-4 border-t border-cream-dark grid grid-cols-3 gap-4 text-sm">
            <div>
              <p class="text-ink-light text-xs mb-1">Weights</p>
              <p class="text-ink">400 · 600 · 700</p>
            </div>
            <div>
              <p class="text-ink-light text-xs mb-1">Styles</p>
              <p class="text-ink">Regular · Italic</p>
            </div>
            <div>
              <p class="text-ink-light text-xs mb-1">Fallback</p>
              <p class="text-ink">Georgia, serif</p>
            </div>
          </div>
        </div>

        <!-- Sans -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <div class="flex items-start justify-between mb-4">
            <div>
              <p class="text-xs text-ink-light uppercase tracking-widest mb-1">Sans-serif — Body & UI</p>
              <p class="font-medium text-ink">DM Sans</p>
            </div>
            <span class="text-xs font-mono bg-cream-dark text-ink-mid px-2 py-1 rounded">Google Fonts</span>
          </div>
          <p class="text-lg text-ink leading-relaxed mb-2">
            We help small and mid-size businesses build operations that scale — without adding headcount.
          </p>
          <p class="text-sm text-ink-mid">
            From Salesforce builds to process documentation, zeisWorks handles the operational complexity so you can focus on growth.
          </p>
          <div class="mt-4 pt-4 border-t border-cream-dark grid grid-cols-3 gap-4 text-sm">
            <div>
              <p class="text-ink-light text-xs mb-1">Weights</p>
              <p class="text-ink">300 · 400 · 500</p>
            </div>
            <div>
              <p class="text-ink-light text-xs mb-1">Body size</p>
              <p class="text-ink">1.0625rem / 17px</p>
            </div>
            <div>
              <p class="text-ink-light text-xs mb-1">Fallback</p>
              <p class="text-ink">system-ui, sans-serif</p>
            </div>
          </div>
        </div>

        <!-- Type scale -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-4">Type scale</p>
          <div class="space-y-3">
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">H1</span>
              <span class="font-serif font-bold text-ink" style="font-size: clamp(2.25rem, 4vw, 3.25rem); line-height: 1.1;">Page Title</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">H2</span>
              <span class="font-serif font-semibold text-ink text-3xl">Section Heading</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">H3</span>
              <span class="font-serif font-semibold text-ink text-xl">Subsection</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">Body</span>
              <span class="text-ink text-base">Standard body copy at 1rem / 16px, DM Sans 400.</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">Small</span>
              <span class="text-ink-mid text-sm">Secondary text, captions, metadata at 0.875rem.</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-ink-light w-12 shrink-0">Label</span>
              <span class="text-ink-light text-xs uppercase tracking-widest">Eyebrow label · All caps · Tracked</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- UI Components -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-6">UI Components</h2>

      <div class="space-y-6">
        <!-- Buttons -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-4">Buttons</p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="#" class="bg-navy text-cream text-sm px-4 py-2 rounded-lg hover:bg-navy/90 transition-colors font-medium">
              Primary CTA
            </a>
            <a href="#" class="border border-navy text-navy text-sm px-4 py-2 rounded-lg hover:bg-navy/5 transition-colors font-medium">
              Secondary
            </a>
            <a href="#" class="text-navy text-sm font-medium hover:underline">
              Text link →
            </a>
            <a href="#" class="bg-orange text-cream text-sm px-4 py-2 rounded-lg hover:bg-orange/90 transition-colors font-medium">
              Accent
            </a>
          </div>
        </div>

        <!-- Cards -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-4">Cards</p>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-cream-dark p-5 hover:border-navy/30 transition-colors">
              <p class="text-xs text-ink-light uppercase tracking-widest mb-2">Guide</p>
              <h3 class="font-serif font-semibold text-ink mb-1">Article title example</h3>
              <p class="text-sm text-ink-mid">Short description of the guide content goes here, two lines maximum.</p>
              <p class="text-xs text-ink-light mt-3">5 min read · Apr 2026</p>
            </div>
            <div class="rounded-xl bg-navy/5 border border-navy/15 p-5">
              <p class="text-xs text-navy uppercase tracking-widest mb-2">Featured</p>
              <h3 class="font-serif font-semibold text-ink mb-1">Highlighted card variant</h3>
              <p class="text-sm text-ink-mid">Used for featured content or callout sections.</p>
            </div>
          </div>
        </div>

        <!-- CTA box -->
        <div class="rounded-xl border border-navy/20 bg-navy/5 p-6">
          <p class="text-xs text-navy uppercase tracking-widest mb-2">CTA Box — Soft</p>
          <h3 class="font-serif font-semibold text-ink text-xl mb-2">Free operations diagnosis</h3>
          <p class="text-sm text-ink-mid mb-4">Tell me what's wrong. I'll figure out the rest. No pitch, no obligation.</p>
          <a href="/#contact" class="inline-block bg-navy text-cream text-sm px-4 py-2 rounded-lg font-medium hover:bg-navy/90 transition-colors">
            Get my free diagnosis
          </a>
        </div>

        <!-- Inline code -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-4">Code</p>
          <p class="text-ink text-sm mb-3">Inline <code class="font-mono text-forest bg-forest/10 px-1.5 py-0.5 rounded text-sm">code</code> appears in forest green on a tinted background.</p>
          <pre class="bg-forest text-cream rounded-lg p-4 text-sm font-mono overflow-x-auto"><code>// Code blocks: forest bg, cream text
SELECT Id, Name FROM Account
WHERE Industry = 'Technology'</code></pre>
        </div>

        <!-- Dividers & spacing -->
        <div class="rounded-xl border border-cream-dark bg-cream p-6">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-4">Dividers</p>
          <hr class="border-cream-dark mb-4" />
          <p class="text-sm text-ink-mid mb-4">Standard <code class="font-mono text-xs text-forest">border-cream-dark</code> divider above. Border radius tokens: <code class="font-mono text-xs text-forest">rounded-lg</code> (8px), <code class="font-mono text-xs text-forest">rounded-xl</code> (12px).</p>
          <div class="flex gap-3">
            <div class="w-10 h-10 rounded-lg bg-navy/20"></div>
            <div class="w-10 h-10 rounded-xl bg-navy/20"></div>
            <div class="w-10 h-10 rounded-2xl bg-navy/20"></div>
            <div class="w-10 h-10 rounded-full bg-navy/20"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Voice & Tone -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-4">Voice & Tone</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-cream-dark bg-cream p-5">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-3">Do</p>
          <ul class="space-y-2 text-sm text-ink">
            <li class="flex gap-2"><span class="text-forest font-bold">✓</span> Direct and specific — name the problem</li>
            <li class="flex gap-2"><span class="text-forest font-bold">✓</span> Confident without being salesy</li>
            <li class="flex gap-2"><span class="text-forest font-bold">✓</span> Practical, outcome-focused language</li>
            <li class="flex gap-2"><span class="text-forest font-bold">✓</span> Short sentences. Plain words.</li>
          </ul>
        </div>
        <div class="rounded-xl border border-cream-dark bg-cream p-5">
          <p class="text-xs text-ink-light uppercase tracking-widest mb-3">Don't</p>
          <ul class="space-y-2 text-sm text-ink">
            <li class="flex gap-2"><span class="text-orange font-bold">✗</span> Buzzwords: "synergy", "leverage", "scalable solutions"</li>
            <li class="flex gap-2"><span class="text-orange font-bold">✗</span> Passive voice or hedging</li>
            <li class="flex gap-2"><span class="text-orange font-bold">✗</span> Overlong paragraphs</li>
            <li class="flex gap-2"><span class="text-orange font-bold">✗</span> All-caps except eyebrow labels</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Token reference -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-ink mb-4">Token Reference</h2>
      <p class="text-ink-mid text-sm mb-4">Tailwind color tokens map directly to CSS custom properties in <code class="font-mono text-forest text-xs">tailwind.config.mjs</code>.</p>
      <div class="rounded-xl border border-cream-dark overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-cream-dark">
            <tr>
              <th class="text-left px-4 py-3 font-medium text-ink-mid text-xs uppercase tracking-wide">Tailwind Token</th>
              <th class="text-left px-4 py-3 font-medium text-ink-mid text-xs uppercase tracking-wide">Hex</th>
              <th class="text-left px-4 py-3 font-medium text-ink-mid text-xs uppercase tracking-wide hidden sm:table-cell">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cream-dark bg-cream">
            {colors.map(c => (
              <tr>
                <td class="px-4 py-3 font-mono text-forest text-xs">bg-{c.token} / text-{c.token}</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-2">
                    <span class="w-4 h-4 rounded border border-cream-dark shrink-0" style={`background:${c.hex}`}></span>
                    <span class="font-mono text-ink-mid text-xs">{c.hex}</span>
                  </span>
                </td>
                <td class="px-4 py-3 text-ink-mid hidden sm:table-cell">{c.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </div>
</BaseLayout>
