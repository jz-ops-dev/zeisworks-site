---
// The Proof page: real reviews now, case studies as they land in
// src/data/case-studies.ts (see that file for how to add one — no code
// changes needed). No invented names, quotes, or numbers, ever.
import LandingLayout from '../layouts/LandingLayout.astro';
import AuditCta from '../components/AuditCta.astro';
import Testimonials from '../components/Testimonials.astro';
import { CASE_STUDIES } from '../data/case-studies';

const navLinks = [
  { label: 'See it working', href: '/#demo' },
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
];
---

<LandingLayout
  title="Proof · ZeisWorks"
  description="Real client reviews, verified on Upwork, and case studies from real engagements. No invented names, quotes, or numbers."
  ogImage="/og.png"
  navLinks={navLinks}
  brandHref="/"
>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="zw-section zw-hero-pad bg-zw-cream border-b border-zw-border">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure-wide">
      <p class="zw-eyebrow mb-4 zw-reveal" style="color: var(--zw-rust);">Proof</p>
      <h1 class="zw-h1 text-zw-ink mb-6 zw-reveal">Real reviews. Real work. Nothing invented.</h1>
      <p class="zw-lede zw-reveal">
        Every quote on this page is from a real client, published where it can be verified.
        As engagements produce results we're allowed to share, they'll appear here too &mdash;
        with the client's permission and numbers we can defend.
      </p>
    </div></div>
  </section>

  <!-- ═══════════════════ REVIEWS ═══════════════════ -->
  <section id="reviews" class="zw-anchor zw-section">
    <div class="zw-wrap px-5 sm:px-8">
      <p class="zw-eyebrow mb-4 zw-reveal">What clients say</p>
      <h2 class="zw-h2 mb-8 zw-reveal">On the record.</h2>
      <Testimonials tone="on-white" />
    </div>
  </section>

  {CASE_STUDIES.length > 0 && (
    <!-- ═══════════════════ CASE STUDIES ═══════════════════ -->
    <section id="case-studies" class="zw-anchor zw-section bg-white border-y border-zw-border">
      <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure">
        <p class="zw-eyebrow mb-4 zw-reveal">Case studies</p>
        <h2 class="zw-h2 mb-8 zw-reveal">What actually changed.</h2>
        <div class="space-y-8">
          {CASE_STUDIES.map((c) => (
            <article class="zw-card zw-reveal">
              <h3 class="zw-h3 mb-1">{c.client}</h3>
              {c.relationship === 'employer' && (
                <p class="zw-mono text-xs text-zw-muted mb-3">(full-time role, not a client engagement)</p>
              )}
              <dl class="space-y-4 text-sm leading-relaxed mt-4">
                <div>
                  <dt class="font-semibold text-zw-ink">The situation</dt>
                  <dd class="text-zw-muted">{c.situation}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-zw-ink">What we found</dt>
                  <dd class="text-zw-muted">{c.found}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-zw-ink">What changed</dt>
                  <dd class="text-zw-muted">{c.changed}</dd>
                </div>
                {c.numbers && (
                  <div>
                    <dt class="font-semibold text-zw-ink">The numbers</dt>
                    <dd class="text-zw-muted">{c.numbers}</dd>
                  </div>
                )}
              </dl>
            </article>
          ))}
        </div>
      </div></div>
    </section>
  )}

  <!-- ═══════════════════ CTA ═══════════════════ -->
  <section class="zw-section bg-zw-forest text-zw-cream">
    <div class="zw-wrap px-5 sm:px-8"><div class="zw-measure mx-auto text-center">
      <p class="zw-eyebrow zw-eyebrow-dark mb-4 zw-reveal">Get started</p>
      <h2 class="zw-h2 mb-6 text-zw-cream zw-reveal">See your own business first.</h2>
      <p class="text-zw-cream/75 mb-9 zw-reveal">
        Book a quick intro call and the first thing you'll see is your own firm: where the
        knowledge that keeps it running actually lives, and where that leaves AI guessing today.
        Free, and what it surfaces is yours to keep.
      </p>
      <AuditCta
        location="footer"
        label="Book a free intro call"
        class="inline-flex items-center justify-center bg-zw-cream text-zw-forest font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors zw-reveal"
      />
    </div></div>
  </section>
</LandingLayout>
