---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GROWBOTIK_FUNNEL_URL } from '../../config';
import { COMPACT_FAQ } from '../../data/faq';

const faqItems = COMPACT_FAQ;

const deliverables = [
  {
    title: "Marketing gap analysis",
    desc: "A side-by-side comparison of your current performance against your true potential: organic, paid, conversion, and funnel ROI. Shows exactly where revenue is leaking and why.",
  },
  {
    title: "12-month predictive revenue plan",
    desc: "Month-by-month projections with exact revenue targets, client volume, cost to acquire a new client, and total budget required. Based on your specific market and revenue goal, not a template.",
  },
  {
    title: "Execution roadmap",
    desc: "The complete plan to run it, with every tactic tied to a revenue outcome and projected ROI per channel. Run it yourself or hand it to us. Cancel anytime.",
  },
];

const testimonials = [
  {
    quote: "Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him for any sales or operations work.",
    name: "Ray Updyke",
    title: "Alpaca VC · 254 hrs logged",
    chips: ["Collaborative", "Detail Oriented", "Reliable"],
  },
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: "Alex Zemianek",
    title: "Owner & CEO, JZ Vacation Rentals",
    chips: ["Long-term Partnership", "Exceeded Expectations"],
  },
  {
    quote: "Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team. We know he will be the first person we reach out to for similar projects in the future.",
    name: "Verified Client",
    title: "Upwork · 5.0",
    chips: ["Collaborative", "Clear Communicator", "Reliable"],
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Free Revenue Audit: Gap Analysis + 12-Month Plan | ZeisWorks"
  description="Run a free 5-minute revenue audit. Get a data-backed gap analysis and a month-by-month plan to fix the leaks. No call, no contracts."
  ogTitle="See Where Revenue Is Leaking. Get the 12-Month Plan to Fix It."
  ogDescription="Run a free 5-minute revenue audit on your service business. Get a personalized gap analysis and 12-month plan. Free. No call required. No contracts."
  canonicalUrl="https://zeisworks.com/revenue-audit/"
  bodyPage="revenue-audit"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!-- OpenAI Ads pixel -->
    <script>
      !function(w, d, s, u) {
        if (w.oaiq) return;
        var q = function() { q.q.push(arguments); };
        q.q = [];
        w.oaiq = q;
        var j = d.createElement(s);
        j.async = 1;
        j.src = u;
        var f = d.getElementsByTagName(s)[0];
        f.parentNode.insertBefore(j, f);
      }(window, document, "script", "https://bzrcdn.openai.com/sdk/oaiq.min.js");

      oaiq("init", {
        pixelId: "RRQqeHMx2HbAnFHRxWWxQM",
      });
    </script>

    <style>
      .aa-page { font-size: 1.0625rem; line-height: 1.75; }

      /* ── ALERT TICKER ── */
      .aa-ticker {
        background: #2a1f0e;
        border-bottom: 1px solid rgba(245,158,11,0.25);
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
      }
      .aa-ticker-flag {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: #f59e0b;
        color: #1a1206;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.55rem 0.9rem;
        z-index: 2;
        white-space: nowrap;
      }
      .aa-ticker-pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #1a1206;
        animation: aa-pulse 1.4s ease-in-out infinite;
      }
      @keyframes aa-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.35; transform: scale(0.7); }
      }
      .aa-ticker-viewport {
        overflow: hidden;
        flex: 1;
        position: relative;
      }
      .aa-ticker-track {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        will-change: transform;
        animation: aa-marquee 32s linear infinite;
      }
      .aa-ticker-track span {
        font-size: 0.8125rem;
        font-weight: 500;
        color: rgba(255,255,255,0.78);
        padding: 0.55rem 0;
        margin-right: 3.5rem;
      }
      .aa-ticker-track span strong { color: #fbbf24; font-weight: 600; }
      @keyframes aa-marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }
      .aa-ticker:hover .aa-ticker-track { animation-play-state: paused; }
      @media (prefers-reduced-motion: reduce) {
        .aa-ticker-track { animation: none; padding-left: 1rem; }
      }

      /* ── HERO ── */
      .aa-hero {
        background: #172554;
        padding: 5.5rem 1.5rem 5rem;
        position: relative;
        overflow: hidden;
      }
      .aa-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,0.28) 0%, transparent 70%);
        pointer-events: none;
      }
      .aa-hero-inner {
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .aa-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #93C5FD;
        margin-bottom: 1.5rem;
        background: rgba(59,130,246,0.15);
        border: 1px solid rgba(59,130,246,0.3);
        padding: 0.35rem 0.875rem;
        border-radius: 999px;
      }
      .aa-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2.1rem, 5vw, 3.25rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: #fff;
        margin-bottom: 1.375rem;
      }
      .aa-h1 em {
        font-style: normal;
        color: #93C5FD;
      }
      .aa-subhead {
        font-size: 1.125rem;
        color: rgba(255,255,255,0.7);
        max-width: 620px;
        margin: 0 auto 2.5rem;
        line-height: 1.75;
      }
      .aa-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.25rem;
      }
      .aa-btn-primary {
        background: #C2410C;
        color: #fff;
        padding: 1rem 2.25rem;
        border-radius: 0.625rem;
        font-size: 1.0625rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 24px rgba(234,88,12,0.35);
      }
      .aa-btn-primary:hover {
        background: #9A3412;
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(234,88,12,0.45);
      }
      .aa-btn-primary:focus-visible {
        outline: 2px solid #93C5FD;
        outline-offset: 3px;
      }
      .aa-hero-note {
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.35);
        margin-top: 0.375rem;
      }

      /* ── INDUSTRY TICKER ── */
      .aa-industry-strip {
        background: #13161f;
        border-top: 1px solid rgba(255,255,255,0.06);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 0.875rem 1.5rem;
        text-align: center;
      }
      .aa-industry-inner {
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.4);
        letter-spacing: 0.02em;
      }

      /* ── TRUST STRIP ── */
      .aa-trust-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.375rem 1.25rem;
        padding: 0.875rem 1.5rem;
        background: var(--cream);
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }
      .aa-trust-sep { color: theme('colors.ink-light'); }

      /* ── SECTION BASE ── */
      .aa-section { padding: 4.5rem 1.5rem; }
      .aa-section-inner { max-width: 720px; margin: 0 auto; }
      .aa-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .aa-section-body {
        color: theme('colors.ink-mid');
        line-height: 1.8;
        max-width: 580px;
        margin-bottom: 2rem;
      }

      /* ── EXAMPLE OUTPUT CARDS ── */
      .aa-examples-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1.75rem 0 2rem; }
      @media (max-width: 640px) { .aa-examples-grid { grid-template-columns: 1fr; } }
      .aa-example-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 0.875rem; padding: 1.25rem 1.5rem; }
      .aa-example-roi { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1rem; }
      .aa-example-roi-block { display: flex; flex-direction: column; gap: 0.125rem; }
      .aa-example-roi-num { font-family: theme('fontFamily.serif'); font-size: 1.625rem; font-weight: 700; line-height: 1; }
      .aa-example-roi-num.current { color: theme('colors.ink-light'); }
      .aa-example-roi-num.projected { color: #C2410C; }
      .aa-example-roi-label { font-size: 0.6875rem; color: theme('colors.ink-light'); letter-spacing: 0.03em; }
      .aa-example-arrow { color: #E2E8F0; font-size: 1.125rem; flex-shrink: 0; margin-top: -0.5rem; }
      .aa-example-target { font-size: 0.8125rem; color: theme('colors.ink-mid'); border-top: 1px solid #F1F5F9; padding-top: 0.75rem; }
      .aa-example-target strong { color: theme('colors.ink'); font-weight: 600; }

      /* ── VIDEO ── */
      .aa-video-wrap {
        margin: 2rem 0 1.75rem;
        border-radius: 0.875rem;
        overflow: hidden;
        border: 1px solid #E2E8F0;
        background: #172554;
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
      }
      .aa-video-wrap iframe {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        border: none;
      }

      /* ── AUDIT SECTION ── */
      .aa-audit-section {
        background: #F1F5F9;
        border-top: 1px solid #E2E8F0;
        border-bottom: 1px solid #E2E8F0;
      }

      /* ── DELIVERABLES ── */
      .aa-deliverables-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) { .aa-deliverables-grid { grid-template-columns: 1fr; } }
      .aa-deliverable-card {
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .aa-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
      }
      .aa-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }
      .aa-deliverables-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }

      /* ── BEFORE / AFTER ── */
      .aa-ba { background: #F1F5F9; border-top: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0; }
      .aa-ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
      @media (max-width: 620px) { .aa-ba-grid { grid-template-columns: 1fr; } }
      .aa-ba-card { border-radius: 0.875rem; padding: 1.75rem; }
      .aa-ba-before { background: #172554; }
      .aa-ba-after { background: #fff; border: 1px solid #E2E8F0; }
      .aa-ba-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
      }
      .aa-ba-before .aa-ba-label { color: rgba(255,255,255,0.35); }
      .aa-ba-after .aa-ba-label { color: theme('colors.orange'); }
      .aa-ba-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.875rem; }
      .aa-ba-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem; line-height: 1.55; }
      .aa-ba-before .aa-ba-list li { color: rgba(255,255,255,0.65); }
      .aa-ba-after .aa-ba-list li { color: theme('colors.ink-mid'); }
      .aa-ba-before .aa-ba-list li::before { content: '✕'; color: rgba(255,255,255,0.25); font-size: 0.8rem; flex-shrink: 0; margin-top: 0.15em; }
      .aa-ba-after .aa-ba-list li::before { content: '✓'; color: #C2410C; font-weight: 700; font-size: 0.85rem; flex-shrink: 0; margin-top: 0.1em; }

      /* ── PROOF BAR ── */
      .aa-proof-bar { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; padding: 1rem 1.5rem; background: rgba(242,238,228,0.5); border-top: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0; font-size: 0.8125rem; font-weight: 500; color: theme('colors.ink-mid'); text-align: center; }

      /* ── TESTIMONIALS ── */
      .aa-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
      @media (max-width: 700px) { .aa-testimonials-grid { grid-template-columns: 1fr; } }
      .aa-tcard { background: #fff; border: 1px solid #E2E8F0; border-radius: 0.875rem; padding: 1.5rem; display: flex; flex-direction: column; }
      .aa-tcard-stars { color: theme('colors.orange'); font-size: 0.875rem; letter-spacing: 0.05em; margin-bottom: 0.875rem; }
      .aa-tcard-quote { font-family: theme('fontFamily.serif'); font-style: italic; font-size: 0.9375rem; color: theme('colors.ink'); line-height: 1.75; flex: 1; margin: 0; }
      .aa-tcard-divider { border-top: 1px solid #E2E8F0; margin: 1rem 0; }
      .aa-tcard-name { font-weight: 600; color: theme('colors.ink'); font-size: 0.875rem; margin: 0; }
      .aa-tcard-title { font-size: 0.75rem; color: theme('colors.ink-light'); margin: 0.125rem 0 0.5rem; }
      .aa-tcard-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
      .aa-chip { font-size: 0.7rem; background: #F1F5F9; color: theme('colors.ink-mid'); padding: 0.2rem 0.625rem; border-radius: 999px; }

      /* ── FAQ ── */
      .aa-faq-list { margin-top: 2.5rem; border-top: 1px solid #E2E8F0; }
      .aa-faq-item { padding: 1.375rem 0; border-bottom: 1px solid #E2E8F0; }
      .aa-faq-q { font-size: 0.9375rem; font-weight: 600; color: theme('colors.ink'); margin-bottom: 0.5rem; line-height: 1.4; }
      .aa-faq-a { font-size: 0.9rem; color: theme('colors.ink-mid'); line-height: 1.75; margin: 0; }

      /* ── MID-PAGE CTA BAND ── */
      .aa-midcta {
        background: #172554;
        padding: 3.5rem 1.5rem;
        text-align: center;
      }
      .aa-midcta-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.75rem;
        line-height: 1.25;
      }
      .aa-midcta-sub {
        font-size: 1rem;
        color: rgba(255,255,255,0.6);
        margin-bottom: 1.75rem;
        line-height: 1.7;
      }

      /* ── CLOSING CTA ── */
      .aa-closing { background: #172554; padding: 5.5rem 1.5rem; position: relative; overflow: hidden; }
      .aa-closing::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 50% 100%, rgba(234,88,12,0.16) 0%, transparent 70%); pointer-events: none; }
      .aa-closing-inner { max-width: 640px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
      .aa-closing-title { font-family: theme('fontFamily.serif'); font-size: clamp(1.875rem, 3.5vw, 2.625rem); font-weight: 700; color: #fff; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 0.875rem; }
      .aa-closing-sub { font-size: 1rem; color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 2.25rem; }
      .aa-closing-cta-group { display: flex; flex-wrap: wrap; gap: 0.875rem; justify-content: center; align-items: center; }
      .aa-btn-closing { background: #C2410C; color: #fff; padding: 1rem 2.25rem; border-radius: 0.625rem; font-size: 1.0625rem; font-weight: 600; transition: background 0.2s, transform 0.15s, box-shadow 0.2s; border: none; cursor: pointer; font-family: inherit; box-shadow: 0 4px 24px rgba(234,88,12,0.35); }
      .aa-btn-closing:hover { background: #9A3412; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(234,88,12,0.45); }
      .aa-btn-closing:focus-visible { outline: 2px solid #93C5FD; outline-offset: 3px; }
      .aa-closing-phone { margin-top: 1.25rem; font-size: 0.875rem; color: rgba(255,255,255,0.35); }
      .aa-closing-phone a { color: rgba(255,255,255,0.55); font-weight: 500; text-decoration: none; transition: color 0.2s; }
      .aa-closing-phone a:hover { color: #fff; }

      /* ── HIDE GLOBAL HEADER ON THIS PAGE (paid landing) ── */
      body[data-page="revenue-audit"] header { display: none !important; }
    </style>
  </Fragment>

  <div class="aa-page">

    <!-- ══════════════════════════════════════
         ALERT TICKER
    ══════════════════════════════════════ -->
    <div class="aa-ticker" role="alert" aria-label="Important update on Google Search changes">
      <span class="aa-ticker-flag"><span class="aa-ticker-pulse" aria-hidden="true"></span>Heads up</span>
      <div class="aa-ticker-viewport">
        <div class="aa-ticker-track">
          <span><strong>Google now answers many searches right on the results page.</strong> Local service businesses are seeing organic clicks drop as fewer people reach your site.</span>
          <span>If your marketing still relies on old SEO, <strong>you're losing leads to competitors who've adapted.</strong> Find your gaps now.</span>
          <span><strong>Google now answers many searches right on the results page.</strong> Local service businesses are seeing organic clicks drop as fewer people reach your site.</span>
          <span>If your marketing still relies on old SEO, <strong>you're losing leads to competitors who've adapted.</strong> Find your gaps now.</span>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 1 — HERO
    ══════════════════════════════════════ -->
    <section class="aa-hero" id="top">
      <div class="aa-hero-inner">
        <span class="aa-eyebrow">Free Revenue Audit · <span id="aa-eyebrow-location">Water Damage &amp; Garage Door Operators</span></span>
        <h1 class="aa-h1">
          See where revenue is leaking.<br>
          <em>Get the 12-month plan to fix it.</em>
        </h1>
        <p class="aa-subhead">
          Run a 5-minute audit on your service business. Walk away with a gap analysis and a month-by-month revenue plan you keep, whether you hire us or not. No contracts. Cancel anytime.
        </p>
        <div class="aa-cta-group">
          <a class="aa-btn-primary" href={GROWBOTIK_FUNNEL_URL} data-audit-cta data-cta-location="hero">
            Start the free audit →
          </a>
        </div>
        <p class="aa-hero-note">Free. 5 minutes. No call required. No contracts.</p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         INDUSTRY STRIP
    ══════════════════════════════════════ -->
    <div class="aa-industry-strip">
      <div class="aa-industry-inner">Built for water damage restoration and garage door operators doing $500K–$5M/year.</div>
    </div>

    <!-- ══════════════════════════════════════
         TRUST STRIP
    ══════════════════════════════════════ -->
    <div class="aa-trust-strip">
      <span>Built for water damage &amp; garage door operators</span>
      <span class="aa-trust-sep" aria-hidden="true">·</span>
      <span>Free 12-month revenue plan included</span>
      <span class="aa-trust-sep" aria-hidden="true">·</span>
      <span>Results in your browser</span>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 2 — THE AUDIT (VIDEO + CTA)
    ══════════════════════════════════════ -->
    <section class="aa-section aa-audit-section" id="audit">
      <div class="aa-section-inner">
        <h2 class="aa-section-title">The 5-minute marketing gap analysis</h2>
        <p class="aa-section-body" style="margin-bottom:0.375rem;">
          Answer a few questions, including what you actually want to make. The audit is built around your revenue goal, not projections on traffic.
        </p>
        <p style="font-size:0.875rem;color:#64748B;margin-bottom:1.5rem;line-height:1.6;">
          I look at your website, Google Business profile, areas served, services offered, how often inquiries convert, and how quickly you follow up. From getting found to getting paid, the full funnel.
        </p>

        <div class="aa-examples-grid">
          <div class="aa-example-card">
            <div class="aa-example-roi">
              <div class="aa-example-roi-block">
                <span class="aa-example-roi-num current">1.4x</span>
                <span class="aa-example-roi-label">Current ROI</span>
              </div>
              <span class="aa-example-arrow">→</span>
              <div class="aa-example-roi-block">
                <span class="aa-example-roi-num projected">2.9x</span>
                <span class="aa-example-roi-label">Projected ROI</span>
