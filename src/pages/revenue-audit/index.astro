<script>
  // ── UTM capture ──
  (function () {
    const params = new URLSearchParams(window.location.search);
    const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    const utm: Record<string, string> = {};
    keys.forEach(k => { const v = params.get(k); if (v) utm[k] = v; });
    if (Object.keys(utm).length) sessionStorage.setItem('zw_utm', JSON.stringify(utm));
  })();

  // ── GA4: page view ──
  if (typeof gtag !== 'undefined') gtag('event', 'revenue_audit_page_view');

  // ── GA4: phone click ──
  document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach(el => {
    el.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') gtag('event', 'revenue_audit_phone_click');
    });
  });

  // ── Growth plan modal ──
  function openAudit() {
    if (typeof (window as any).openGpModal === 'function') (window as any).openGpModal();
  }

  document.getElementById('hero-cta')?.addEventListener('click', openAudit);
  document.getElementById('midpage-cta')?.addEventListener('click', openAudit);
  document.getElementById('closing-cta')?.addEventListener('click', openAudit);
  document.getElementById('audit-inline-cta')?.addEventListener('click', openAudit);

  // ── Wire floating button to audit (not the generic contact modal) ──
  const floatBtn = document.getElementById('ga-float-btn');
  if (floatBtn) {
    floatBtn.removeAttribute('data-modal');
    floatBtn.setAttribute('aria-label', 'Get your free growth plan');
    floatBtn.childNodes.forEach(node => {
      if (node.nodeType === 3 && node.textContent?.trim()) node.textContent = ' Get free growth plan';
    });
    floatBtn.addEventListener('click', () => {
      if (typeof fbq !== 'undefined') {
        fbq('track', 'StartTrial', { content_name: 'revenue-audit', content_category: 'zeisworks_form' });
        fbq('track', 'Lead', { content_name: 'revenue-audit', content_category: 'zeisworks_form' });
      }
      openAudit();
    });
  }

  // ── Exit intent ──
  (function () {
    const STORAGE_KEY = 'zw_exit_shown';
    if (sessionStorage.getItem(STORAGE_KEY)) return;
    const overlay = document.getElementById('aa-exit-overlay');
    const closeBtn = document.getElementById('aa-exit-close');
    const dismissBtn = document.getElementById('aa-exit-dismiss');
    const auditBtn = document.getElementById('aa-exit-audit-btn');
    if (!overlay) return;

    function showOverlay() {
      if (sessionStorage.getItem(STORAGE_KEY)) return;
      sessionStorage.setItem(STORAGE_KEY, '1');
      overlay.classList.add('is-visible');
      closeBtn?.focus();
    }
    function hideOverlay() { overlay.classList.remove('is-visible'); }

    document.addEventListener('mouseleave', (e) => { if (e.clientY <= 0) showOverlay(); });
    const mobileTimer = setTimeout(showOverlay, 45000);
    document.addEventListener('touchstart', () => clearTimeout(mobileTimer), { once: true });

    closeBtn?.addEventListener('click', hideOverlay);
    dismissBtn?.addEventListener('click', hideOverlay);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) hideOverlay(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideOverlay(); });
    auditBtn?.addEventListener('click', () => {
      hideOverlay();
      if (typeof fbq !== 'undefined') {
        fbq('track', 'StartTrial', { content_name: 'revenue-audit', content_category: 'zeisworks_form' });
        fbq('track', 'Lead', { content_name: 'revenue-audit', content_category: 'zeisworks_form' });
      }
      openAudit();
    });
  })();
</script>

<!-- Geo-personalization -->
<script>
(function () {
  const CITY_KEY = 'zw_city';

  async function getCity() {
    const cached = sessionStorage.getItem(CITY_KEY);
    if (cached) return cached;
    try {
      const res = await fetch('https://ipapi.co/json/');
      const data = await res.json();
      const city = data.city || '';
      if (city) sessionStorage.setItem(CITY_KEY, city);
      return city;
    } catch {
      return '';
    }
  }

  getCity().then(function (city) {
    if (!city) return;
    const eyebrow = document.getElementById('aa-eyebrow-location');
    if (eyebrow) eyebrow.textContent = city + ' Service Businesses';
  });
})();
</script>

