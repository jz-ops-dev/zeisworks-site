---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How is this different from other marketing agencies?",
    a: "Most agencies sell services (PPC, SEO, etc.) and measure inputs (impressions, rankings). We sell revenue outcomes and measure pipeline. The 12-month plan you'll receive includes projected client volume and revenue per month, not just deliverables.",
  },
  {
    q: "How do you actually project revenue?",
    a: "Our AI engine analyzes 500+ data points per firm: current marketing, market size, competition, conversion infrastructure, niche economics, and historical performance from comparable campaigns. Projections come from real comparable data, not template assumptions. The methodology is in the report.",
  },
  {
    q: "What does this actually cost after the audit?",
    a: "The audit and plan are free. If you decide to run the plan with us, monthly investment scales with your revenue goal and market position — typically $2,500 to $5,000 per month. The full cost is in the plan you receive, before any commitment.",
  },
  {
    q: "I already have a marketing agency. Why should I run this?",
    a: "Because your current agency's incentive is to sell you more services. Ours is to show you what's actually moving revenue. Run the audit, compare the findings against what your current agency reports. If they line up, keep your agency. If they don't, you have data for the conversation.",
  },
  {
    q: "Do I have to get on a call?",
    a: "No. The audit runs in the browser. You get the report and plan in your inbox. If you want to talk through the plan, that's optional, not required.",
  },
];

const deliverables = [
  {
    title: "Twelve-month revenue plan",
    desc: "Month-by-month roadmap with revenue projections, client volume targets, and the marketing budget required to hit them. Based on your specific market, niche, and current position. Not pulled from a template.",
  },
  {
    title: "AI search visibility audit",
    desc: "Where your business appears, and where it doesn't, when prospects search Google, Maps, ChatGPT, and Gemini for what you offer. Side-by-side with the businesses showing up instead of you.",
  },
  {
    title: "Customer acquisition cost projection",
    desc: "What a new client actually costs to acquire in your market given your current positioning. So you can compare what you're spending now against what it should cost.",
  },
];

const testimonials = [
  {
    quote: "Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him for any sales or operations work.",
    name: "Ray Updyke",
    title: "Alpaca VC · 254 hrs logged",
    chips: ["Collaborative", "Detail Oriented", "Reliable"],
  },
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: "Alex Zemianek",
    title: "Owner & CEO, JZ Vacation Rentals",
    chips: ["Long-term Partnership", "Exceeded Expectations"],
  },
  {
    quote: "Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team. We know he will be the first person we reach out to for similar projects in the future.",
    name: "Verified Client",
    title: "Upwork · 5.0",
    chips: ["Collaborative", "Clear Communicator", "Reliable"],
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Free Local Search Visibility Audit"
  description="Find out where your business is invisible in local and AI search — and get a free 12-month revenue plan to fix it. No call required."
  ogTitle="Free Local Search Visibility Audit | zeisWorks"
  ogDescription="Find out where your business is invisible in local and AI search — and get a free 12-month revenue plan to fix it. No call required."
  canonicalUrl="https://zeisworks.com/ai-audit/"
  bodyPage="ai-audit"
>
  <Fragment slot="head">
    <!-- NOINDEX: Remove before sunsetting paid traffic iteration period (14 days post-launch) -->
    <meta name="robots" content="noindex, follow" />

    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!--
      OpenAI Ads conversion pixel
      TODO: Replace with script from OpenAI Ads Manager dashboard.
      Verify in OpenAI's pixel testing tool before campaigns go live.
      Fire the conversion event on ai_audit_chat_complete (wired below in page script).
    -->
    <!-- <script>/* OpenAI Ads pixel goes here */</script> -->

    <style>
      .aa-page { font-size: 1.0625rem; line-height: 1.75; }

      /* ── HERO ── */
      .aa-hero {
        background: var(--cream);
        padding: 5rem 1.5rem 4rem;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-hero-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }
      .aa-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 1.25rem;
      }
      .aa-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: theme('colors.ink');
        margin-bottom: 1.25rem;
      }
      .aa-subhead {
        font-size: 1.125rem;
        color: theme('colors.ink-mid');
        max-width: 600px;
        margin: 0 auto 2.25rem;
        line-height: 1.75;
      }
      .aa-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1rem;
      }
      .aa-btn-primary {
        background: theme('colors.navy');
        color: #fff;
        padding: 0.875rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-family: inherit;
      }
      .aa-btn-primary:hover {
        background: #1e3350;
        transform: translateY(-1px);
      }
      .aa-btn-primary:focus-visible {
        outline: 2px solid theme('colors.navy');
        outline-offset: 3px;
      }
      .aa-btn-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: theme('colors.ink-mid');
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .aa-btn-phone:hover { color: theme('colors.ink'); }
      .aa-btn-phone:focus-visible { outline: 2px solid theme('colors.navy'); outline-offset: 2px; border-radius: 2px; }
      .aa-hero-note {
        font-size: 0.8125rem;
        color: theme('colors.ink-light');
        margin-top: 0.25rem;
      }

      /* ── TRUST STRIP ── */
      .aa-trust-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.375rem 0.75rem;
        padding: 0.875rem 1.5rem;
        background: rgba(242, 238, 228, 0.5);
        border-bottom: 1px solid #e8e3d8;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }
      .aa-trust-sep {
        color: theme('colors.ink-light');
      }

      /* ── SECTION BASE ── */
      .aa-section {
        padding: 4.5rem 1.5rem;
      }
      .aa-section-inner {
        max-width: 720px;
        margin: 0 auto;
      }
      .aa-section-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.75rem;
      }
      .aa-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .aa-section-body {
        color: theme('colors.ink-mid');
        line-height: 1.8;
        max-width: 560px;
        margin-bottom: 2rem;
      }

      /* ── CHAT EMBED ── */
      .aa-audit-section {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-chat-container {
        max-width: 720px;
        margin: 2rem auto 0;
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid #e8e3d8;
        background: #fff;
        min-height: 480px;
      }
      /* Placeholder shown until embed is installed */
      .aa-chat-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 480px;
        padding: 2rem;
        text-align: center;
        gap: 0.75rem;
        color: theme('colors.ink-light');
        font-size: 0.875rem;
        background: repeating-linear-gradient(
          45deg,
          transparent,
          transparent 10px,
          rgba(200, 195, 185, 0.1) 10px,
          rgba(200, 195, 185, 0.1) 20px
        );
      }
      .aa-chat-placeholder p { margin: 0; }
      .aa-chat-placeholder strong { color: theme('colors.ink-mid'); display: block; margin-top: 0.5rem; }

      /* ── DELIVERABLES ── */
      .aa-deliverables-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .aa-deliverables-grid { grid-template-columns: 1fr; }
      }
      .aa-deliverable-card {
        background: #f2ede4;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .aa-deliverable-num {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.125rem;
      }
      .aa-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
      }
      .aa-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }
      .aa-deliverables-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }

      /* ── NOT FOR EVERYONE ── */
      .aa-nfe {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-nfe-body p {
        font-size: 0.9375rem;
        color: theme('colors.ink-mid');
        line-height: 1.8;
        margin-bottom: 0.875rem;
      }
      .aa-nfe-body p:last-child { margin-bottom: 0; }

      /* ── PROOF BAR ── */
      .aa-proof-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(242, 238, 228, 0.5);
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
        text-align: center;
      }

      /* ── TESTIMONIALS ── */
      .aa-testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 700px) {
        .aa-testimonials-grid { grid-template-columns: 1fr; }
      }
      .aa-tcard {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
      }
      .aa-tcard-stars {
        color: theme('colors.orange');
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        margin-bottom: 0.875rem;
      }
      .aa-tcard-quote {
        font-family: theme('fontFamily.serif');
        font-style: italic;
        font-size: 0.9375rem;
        color: theme('colors.ink');
        line-height: 1.75;
        flex: 1;
        margin: 0;
      }
      .aa-tcard-divider {
        border-top: 1px solid #e8e3d8;
        margin: 1rem 0;
      }
      .aa-tcard-name {
        font-weight: 600;
        color: theme('colors.ink');
        font-size: 0.875rem;
        margin: 0;
      }
      .aa-tcard-title {
        font-size: 0.75rem;
        color: theme('colors.ink-light');
        margin: 0.125rem 0 0.5rem;
      }
      .aa-tcard-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }
      .aa-chip {
        font-size: 0.7rem;
        background: #f2ede4;
        color: theme('colors.ink-mid');
        padding: 0.2rem 0.625rem;
        border-radius: 999px;
      }

      /* ── ABOUT ── */
      .aa-about {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
      }
      .aa-about-inner {
        max-width: 720px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 3rem;
        align-items: start;
      }
      @media (max-width: 640px) {
        .aa-about-inner { grid-template-columns: 1fr; gap: 1.75rem; }
      }
      .aa-about-photo {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 0.875rem;
        object-fit: cover;
        border: 1px solid #e8e3d8;
      }
      .aa-about-body h2 {
        font-family: theme('fontFamily.serif');
        font-size: 1.5rem;
        font-weight: 700;
        color: theme('colors.ink');
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .aa-about-body p {
        font-size: 0.9375rem;
        color: theme('colors.ink-mid');
        line-height: 1.8;
        margin-bottom: 0.875rem;
      }
      .aa-about-body p:last-child { margin-bottom: 0; }
      .aa-about-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }
      .aa-about-tag {
        font-size: 0.75rem;
        background: theme('colors.cream');
        border: 1px solid #e8e3d8;
        color: theme('colors.ink-mid');
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      /* ── FAQ ── */
      .aa-faq-list {
        margin-top: 2.5rem;
        border-top: 1px solid #e8e3d8;
      }
      .aa-faq-item {
        padding: 1.375rem 0;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-faq-q {
        font-size: 0.9375rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }
      .aa-faq-a {
        font-size: 0.9rem;
        color: theme('colors.ink-mid');
        line-height: 1.75;
        margin: 0;
      }

      /* ── HOOKS ── */
      .aa-hooks { border-top: 1px solid #e8e3d8; }
      .aa-hooks-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) {
        .aa-hooks-grid { grid-template-columns: 1fr; }
      }
      .aa-hook-card {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
      }
      .aa-hook-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .aa-hook-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }

      /* ── CLOSING CTA ── */
      .aa-closing {
        background: theme('colors.forest');
        padding: 5rem 1.5rem;
      }
      .aa-closing-inner {
        max-width: 640px;
        margin: 0 auto;
        text-align: center;
      }
      .aa-closing-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.45);
        margin-bottom: 1rem;
      }
      .aa-closing-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 0.875rem;
      }
      .aa-closing-sub {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.65);
        line-height: 1.75;
        margin-bottom: 2rem;
      }
      .aa-closing-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
      }
      .aa-btn-closing {
        background: theme('colors.orange');
        color: #fff;
        padding: 0.875rem 2rem;
        border-radius: 0.625rem;
        font-size: 1rem;
        font-weight: 500;
        transition: background 0.2s, transform 0.15s;
        border: none;
        cursor: pointer;
        font-family: inherit;
      }
      .aa-btn-closing:hover {
        background: #a8511f;
        transform: translateY(-1px);
      }
      .aa-btn-closing:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }
      .aa-closing-phone {
        margin-top: 1.25rem;
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.45);
      }
      .aa-closing-phone a {
        color: rgba(255, 255, 255, 0.65);
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .aa-closing-phone a:hover { color: #fff; }
      .aa-closing-phone a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 2px; }
    </style>
  </Fragment>

  <div class="aa-page">

    <!-- ══════════════════════════════════════
         SECTION 1 — HERO
    ══════════════════════════════════════ -->
    <section class="aa-hero" id="top">
      <div class="aa-hero-inner">
        <p class="aa-eyebrow">Free local search audit · Colorado businesses</p>
        <h1 class="aa-h1">Get found where your customers are looking.</h1>
        <p class="aa-subhead">
          Someone just searched for a business like yours and didn't find you. We'll show you
          exactly where you're invisible — in Google, Maps, and AI search — what it's costing
          you in revenue, and give you a 12-month plan to fix it.
        </p>
        <div class="aa-cta-group">
          <button type="button" class="aa-btn-primary" id="hero-cta">
            Start the free audit →
          </button>
          <a
            href="tel:+17206502447"
            class="aa-btn-phone"
            aria-label="Call (720) 650-2447"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.4a16 16 0 0 0 6.29 6.29l1.76-1.76a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Prefer to call? (720) 650-2447
          </a>
        </div>
        <p class="aa-hero-note">5 minutes. No call required. No retainer.</p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 2 — TRUST STRIP
    ══════════════════════════════════════ -->
    <div class="aa-trust-strip" role="list">
      <span role="listitem">
        <span aria-hidden="true">✓</span> Based in Golden, CO
      </span>
      <span class="aa-trust-sep" aria-hidden="true">·</span>
      <span role="listitem">
        <span aria-hidden="true">✓</span> 5.0 on Upwork · 100% Job Success
      </span>
      <span class="aa-trust-sep" aria-hidden="true">·</span>
      <span role="listitem">
        <span aria-hidden="true">✓</span> Free 12-month plan, no retainer
      </span>
    </div>

    <!-- ══════════════════════════════════════
         SECTION 3 — THE AUDIT (CHAT EMBED)
    ══════════════════════════════════════ -->
    <section class="aa-section aa-audit-section" id="audit">
      <div class="aa-section-inner">
        <p class="aa-section-label">Free audit</p>
        <h2 class="aa-section-title">The 5-minute audit</h2>
        <p class="aa-section-body">
          We map your AI search visibility, review profile, conversion infrastructure, and
          competitive position against your revenue goal. You get a 12-month plan with monthly
          revenue projections and the cost to execute it.
        </p>

        <!--
          CHAT EMBED — Replace the placeholder below with the white-label platform's
          embed snippet from the agency admin dashboard.

          Requirements before going live (spec section 5):
          - No third-party branding visible at any point in the chat flow
          - Avatar replaced with ZW logo or generic AI icon
          - All loading screens free of platform branding
          - Footer links inside chat do not link to the underlying platform
          - "Powered by" / attribution strings removed or replaced with "ZeisWorks"
          - Full white-label confirmed by completing the chat in a clean browser
            on both desktop and mobile

          If white-labeling cannot be confirmed, redirect paid traffic to
          /gap-analysis/ instead of shipping this placeholder.

          Lazy-load the embed script if the platform supports it:
          use the IntersectionObserver in the page <script> below to inject
          the script tag only when this section scrolls into view.
        -->
        <div
          id="audit-chat-container"
          class="aa-chat-container"
          role="region"
          aria-label="AI audit video"
        >
          <iframe
            src="https://drive.google.com/file/d/13c0IGxcmy-nyjlWozb2RVvbSIUMAF-iv/preview"
            title="ZeisWorks AI Audit"
            style="border:none;display:block;width:100%;height:480px;"
            allow="autoplay"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         SECTION 4 — WHAT YOU'LL ACTUALLY GET
    ══════════════════════════════════════ -->
    <section class="aa-section">
      <div class="aa-section-inner">
        <p class="aa-section-label">What's included</p>
        <h2 class="aa-section-title">What you'll actually get</h2>
        <div class="aa-deliverables-grid">
          {deliverables.map((d, i) => (
            <div class="aa-deliverable-card">
              <p class="aa-deliverable-num">0{i + 1}</p>
              <p class="aa-deliverable-title">{d.title}</p>
              <p class="aa-deliverable-desc">{d.desc}</p>
