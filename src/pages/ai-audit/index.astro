      if (btn) {
        btn.addEventListener('click', function() {
          if (typeof fbq === 'function') {
            fbq('trackCustom', 'StartGapAnalysis', {
              content_name: 'ai-audit',
              content_category: 'zeisworks_form',
            });
          }
        });
      }
    });
  });
</script>
