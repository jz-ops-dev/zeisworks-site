---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqItems = [
  {
    q: "How is this different from other marketing agencies?",
    a: "Most agencies sell services (PPC, SEO, etc.) and measure inputs (impressions, rankings). We sell revenue outcomes and measure pipeline. The 12-month plan you'll receive includes projected client volume and revenue per month, not just deliverables.",
  },
  {
    q: "How do you actually project revenue?",
    a: "Our AI engine analyzes 500+ data points per firm: current marketing, market size, competition, conversion infrastructure, niche economics, and historical performance from comparable campaigns. Projections come from real comparable data, not template assumptions. The methodology is in the report.",
  },
  {
    q: "What does this actually cost after the audit?",
    a: "The audit and plan are free. If you decide to run the plan with us, your investment scales with your revenue goal and market position. The full cost is in the plan you receive, before any commitment.",
  },
  {
    q: "I already have a marketing agency. Why should I run this?",
    a: "Because your current agency's incentive is to sell you more services. Ours is to show you what's actually moving revenue. Run the audit, compare the findings against what your current agency reports. If they line up, keep your agency. If they don't, you have data for the conversation.",
  },
  {
    q: "Do I have to get on a call?",
    a: "No. The audit runs in the browser. You get the report and plan in your inbox. If you want to talk through the plan, that's optional, not required.",
  },
];

const deliverables = [
  {
    title: "Marketing gap analysis",
    desc: "A side-by-side comparison of your current marketing performance against your true potential — organic, paid, conversions, and funnel ROI. Shows exactly where revenue is leaking and why.",
  },
  {
    title: "12-month predictive revenue plan",
    desc: "Month-by-month projections with exact revenue targets, client volume, cost to acquire a new client, and total budget required. Based on your specific market and revenue goal — not a template.",
  },
  {
    title: "Done-for-you execution roadmap",
    desc: "The complete plan to run it — so you can focus on your business while the system handles client acquisition. Every tactic tied to a revenue outcome, with projected ROI per channel.",
  },
];

const testimonials = [
  {
    quote: "Jack was amazing to work with, which is why he worked for us on a long-term basis. He is thorough, accurate, and timely. I highly recommend him for any sales or operations work.",
    name: "Ray Updyke",
    title: "Alpaca VC · 254 hrs logged",
    chips: ["Collaborative", "Detail Oriented", "Reliable"],
  },
  {
    quote: "I've had the pleasure to work closely with Jack in numerous projects, roles, and challenges. All of which have exceeded my expectations as a company leader.",
    name: "Alex Zemianek",
    title: "Owner & CEO, JZ Vacation Rentals",
    chips: ["Long-term Partnership", "Exceeded Expectations"],
  },
  {
    quote: "Jack was great at communicating, efficient, personable and dependable. He was easy to work with and a great asset to our team. We know he will be the first person we reach out to for similar projects in the future.",
    name: "Verified Client",
    title: "Upwork · 5.0",
    chips: ["Collaborative", "Clear Communicator", "Reliable"],
  },
];

const industries = [
  "HVAC & Plumbing",
  "Dental & Med Spa",
  "Home Remodeling",
  "Roofing & Exteriors",
  "Attorneys & Law Firms",
  "Personal Trainers & Gyms",
  "Chiropractic & PT",
  "Accounting & Financial",
  "Landscaping",
  "Auto Services",
  "Therapists & Counselors",
  "Cleaning Services",
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="Is Your Service Business Invisible to AI Search? Free Audit"
  description="When customers ask ChatGPT, Gemini, or Google AI who to call for your service — are you showing up? Find out in 5 minutes. Free AI visibility audit + 12-month revenue plan."
  ogTitle="Your Customers Are Asking AI Who to Call. Are You on the List?"
  ogDescription="Free AI search visibility audit for service businesses. See exactly where you're invisible, what it's costing you, and get a 12-month plan to fix it. No call required."
  canonicalUrl="https://zeisworks.com/ai-audit/"
  bodyPage="ai-audit"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!-- OpenAI Ads pixel -->
    <script>
      !function(w, d, s, u) {
        if (w.oaiq) return;
        var q = function() { q.q.push(arguments); };
        q.q = [];
        w.oaiq = q;
        var j = d.createElement(s);
        j.async = 1;
        j.src = u;
        var f = d.getElementsByTagName(s)[0];
        f.parentNode.insertBefore(j, f);
      }(window, document, "script", "https://bzrcdn.openai.com/sdk/oaiq.min.js");

      oaiq("init", {
        pixelId: "RRQqeHMx2HbAnFHRxWWxQM",
        debug: true
      });
    </script>

    <style>
      .aa-page { font-size: 1.0625rem; line-height: 1.75; }

      /* ── HERO ── */
      .aa-hero {
        background: #1a1f2e;
        padding: 5.5rem 1.5rem 5rem;
        position: relative;
        overflow: hidden;
      }
      .aa-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(99,102,241,0.18) 0%, transparent 70%);
        pointer-events: none;
      }
      .aa-hero-inner {
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .aa-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #a5b4fc;
        margin-bottom: 1.5rem;
        background: rgba(99,102,241,0.12);
        border: 1px solid rgba(99,102,241,0.25);
        padding: 0.35rem 0.875rem;
        border-radius: 999px;
      }
      .aa-h1 {
        font-family: theme('fontFamily.serif');
        font-size: clamp(2.1rem, 5vw, 3.25rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: #fff;
        margin-bottom: 1.375rem;
      }
      .aa-h1 em {
        font-style: normal;
        color: #a5b4fc;
      }
      .aa-subhead {
        font-size: 1.125rem;
        color: rgba(255,255,255,0.7);
        max-width: 620px;
        margin: 0 auto 2.5rem;
        line-height: 1.75;
      }
      .aa-cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 1.25rem;
      }
      .aa-btn-primary {
        background: #6366f1;
        color: #fff;
        padding: 1rem 2.25rem;
        border-radius: 0.625rem;
        font-size: 1.0625rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        display: inline-block;
        border: none;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 24px rgba(99,102,241,0.35);
      }
      .aa-btn-primary:hover {
        background: #4f46e5;
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(99,102,241,0.45);
      }
      .aa-btn-primary:focus-visible {
        outline: 2px solid #a5b4fc;
        outline-offset: 3px;
      }
      .aa-btn-phone {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(255,255,255,0.5);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }
      .aa-btn-phone:hover { color: rgba(255,255,255,0.8); }
      .aa-hero-note {
        font-size: 0.8125rem;
        color: rgba(255,255,255,0.35);
        margin-top: 0.375rem;
      }

      /* ── INDUSTRY TICKER ── */
      .aa-industry-strip {
        background: #13161f;
        border-top: 1px solid rgba(255,255,255,0.06);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 0.875rem 1.5rem;
        overflow: hidden;
      }
      .aa-industry-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.25rem;
      }
      .aa-industry-tag {
        font-size: 0.75rem;
        font-weight: 500;
        color: rgba(255,255,255,0.4);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }
      .aa-industry-tag::before {
        content: '✓ ';
        color: #6366f1;
      }

      /* ── TRUST STRIP ── */
      .aa-trust-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.375rem 1.25rem;
        padding: 0.875rem 1.5rem;
        background: var(--cream);
        border-bottom: 1px solid #e8e3d8;
        font-size: 0.8125rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }
      .aa-trust-sep { color: theme('colors.ink-light'); }

      /* ── SECTION BASE ── */
      .aa-section { padding: 4.5rem 1.5rem; }
      .aa-section-inner { max-width: 720px; margin: 0 auto; }
      .aa-section-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2.125rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .aa-section-body {
        color: theme('colors.ink-mid');
        line-height: 1.8;
        max-width: 580px;
        margin-bottom: 2rem;
      }

      /* ── PAIN SECTION ── */
      .aa-pain {
        background: #f7f5f0;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-pain-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2rem;
      }
      @media (max-width: 600px) { .aa-pain-grid { grid-template-columns: 1fr; } }
      .aa-pain-card {
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
      }
      .aa-pain-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin-bottom: 0.375rem;
        line-height: 1.3;
      }
      .aa-pain-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }

      /* ── VIDEO ── */
      .aa-video-wrap {
        margin: 2rem 0 1.75rem;
        border-radius: 0.875rem;
        overflow: hidden;
        border: 1px solid #e8e3d8;
        background: #1a1f2e;
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
      }
      .aa-video-wrap iframe {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        border: none;
      }

      /* ── CHAT EMBED ── */
      .aa-audit-section {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }

      /* ── DELIVERABLES ── */
      .aa-deliverables-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2.5rem;
      }
      @media (max-width: 640px) { .aa-deliverables-grid { grid-template-columns: 1fr; } }
      .aa-deliverable-card {
        background: #f2ede4;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .aa-deliverable-title {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        line-height: 1.3;
      }
      .aa-deliverable-desc {
        font-size: 0.875rem;
        color: theme('colors.ink-mid');
        line-height: 1.65;
        margin: 0;
      }
      .aa-deliverables-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
        color: theme('colors.ink-mid');
      }

      /* ── AI VISIBILITY SCORE ── */
      .aa-score-section {
        background: #f2ede4;
        border-top: 1px solid #e8e3d8;
        border-bottom: 1px solid #e8e3d8;
      }
      .aa-score-card {
        margin-top: 2rem;
        background: #fff;
        border: 1px solid #e8e3d8;
        border-radius: 0.875rem;
        overflow: hidden;
      }
      .aa-score-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid #e8e3d8;
        gap: 1rem;
      }
      .aa-score-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.25rem;
      }
      .aa-score-biz {
        font-family: theme('fontFamily.serif');
        font-size: 1rem;
        font-weight: 600;
        color: theme('colors.ink');
        margin: 0;
      }
      .aa-score-num-wrap {
        display: flex;
        align-items: baseline;
        gap: 0.125rem;
        flex-shrink: 0;
      }
      .aa-score-num {
        font-family: theme('fontFamily.serif');
        font-size: 2.75rem;
        font-weight: 700;
        color: #c47c1a;
        line-height: 1;
      }
      .aa-score-denom { font-size: 1rem; color: theme('colors.ink-light'); font-weight: 500; }
      .aa-score-bar-wrap { padding: 0 1.75rem; margin: 1.25rem 0; }
      .aa-score-bar-track { height: 8px; background: #f2ede4; border-radius: 999px; overflow: hidden; }
      .aa-score-bar-fill { height: 100%; width: 42%; background: linear-gradient(90deg, #e8a020, #c47c1a); border-radius: 999px; }
      .aa-score-metrics { padding: 0 1.75rem 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
      .aa-score-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.875rem; }
      .aa-score-row-label { color: theme('colors.ink-mid'); }
      .aa-pill { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; padding: 0.2rem 0.75rem; border-radius: 999px; flex-shrink: 0; }
      .aa-pill-bad { background: #fde8e8; color: #c0392b; }
      .aa-pill-warn { background: #fef3e2; color: #a85e10; }
      .aa-score-disclaimer { font-size: 0.75rem; color: theme('colors.ink-light'); text-align: center; padding: 0.875rem 1.75rem; border-top: 1px solid #f2ede4; margin: 0; font-style: italic; }

      /* ── SCREENSHOT FINDINGS ── */
      .aa-screenshots-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
      @media (max-width: 700px) { .aa-screenshots-grid { grid-template-columns: 1fr; } }
      .aa-screenshot-card { border: 1px solid #e8e3d8; border-radius: 0.875rem; overflow: hidden; background: #fff; }
      .aa-screenshot-tag { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: theme('colors.ink-mid'); padding: 0.625rem 1rem; border-bottom: 1px solid #e8e3d8; background: #f2ede4; }
      .aa-screenshot-img { height: 180px; background: #f7f5f0; display: flex; align-items: center; justify-content: center; }
      .aa-screenshot-caption { font-size: 0.8125rem; color: theme('colors.ink-mid'); line-height: 1.6; padding: 0.875rem 1rem; margin: 0; border-top: 1px solid #f2ede4; }

      /* ── BEFORE / AFTER ── */
      .aa-ba { background: #f2ede4; border-top: 1px solid #e8e3d8; border-bottom: 1px solid #e8e3d8; }
      .aa-ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
      @media (max-width: 620px) { .aa-ba-grid { grid-template-columns: 1fr; } }
      .aa-ba-card { border-radius: 0.875rem; padding: 1.75rem; }
      .aa-ba-before { background: #1a1f2e; }
      .aa-ba-after { background: #fff; border: 1px solid #e8e3d8; }
      .aa-ba-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
      }
      .aa-ba-before .aa-ba-label { color: rgba(255,255,255,0.35); }
      .aa-ba-after .aa-ba-label { color: theme('colors.orange'); }
      .aa-ba-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.875rem; }
      .aa-ba-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem; line-height: 1.55; }
      .aa-ba-before .aa-ba-list li { color: rgba(255,255,255,0.65); }
      .aa-ba-after .aa-ba-list li { color: theme('colors.ink-mid'); }
      .aa-ba-before .aa-ba-list li::before { content: '✕'; color: rgba(255,255,255,0.25); font-size: 0.8rem; flex-shrink: 0; margin-top: 0.15em; }
      .aa-ba-after .aa-ba-list li::before { content: '✓'; color: #6366f1; font-weight: 700; font-size: 0.85rem; flex-shrink: 0; margin-top: 0.1em; }

      /* ── PROOF BAR ── */
      .aa-proof-bar { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; padding: 1rem 1.5rem; background: rgba(242,238,228,0.5); border-top: 1px solid #e8e3d8; border-bottom: 1px solid #e8e3d8; font-size: 0.8125rem; font-weight: 500; color: theme('colors.ink-mid'); text-align: center; }

      /* ── TESTIMONIALS ── */
      .aa-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
      @media (max-width: 700px) { .aa-testimonials-grid { grid-template-columns: 1fr; } }
      .aa-tcard { background: #fff; border: 1px solid #e8e3d8; border-radius: 0.875rem; padding: 1.5rem; display: flex; flex-direction: column; }
      .aa-tcard-stars { color: theme('colors.orange'); font-size: 0.875rem; letter-spacing: 0.05em; margin-bottom: 0.875rem; }
      .aa-tcard-quote { font-family: theme('fontFamily.serif'); font-style: italic; font-size: 0.9375rem; color: theme('colors.ink'); line-height: 1.75; flex: 1; margin: 0; }
      .aa-tcard-divider { border-top: 1px solid #e8e3d8; margin: 1rem 0; }
      .aa-tcard-name { font-weight: 600; color: theme('colors.ink'); font-size: 0.875rem; margin: 0; }
      .aa-tcard-title { font-size: 0.75rem; color: theme('colors.ink-light'); margin: 0.125rem 0 0.5rem; }
      .aa-tcard-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
      .aa-chip { font-size: 0.7rem; background: #f2ede4; color: theme('colors.ink-mid'); padding: 0.2rem 0.625rem; border-radius: 999px; }

      /* ── FAQ ── */
      .aa-faq-list { margin-top: 2.5rem; border-top: 1px solid #e8e3d8; }
      .aa-faq-item { padding: 1.375rem 0; border-bottom: 1px solid #e8e3d8; }
      .aa-faq-q { font-size: 0.9375rem; font-weight: 600; color: theme('colors.ink'); margin-bottom: 0.5rem; line-height: 1.4; }
      .aa-faq-a { font-size: 0.9rem; color: theme('colors.ink-mid'); line-height: 1.75; margin: 0; }

      /* ── MID-PAGE CTA BAND ── */
      .aa-midcta {
        background: #1a1f2e;
        padding: 3.5rem 1.5rem;
        text-align: center;
      }
      .aa-midcta-title {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.75rem;
        line-height: 1.25;
      }
      .aa-midcta-sub {
        font-size: 1rem;
        color: rgba(255,255,255,0.6);
        margin-bottom: 1.75rem;
        line-height: 1.7;
      }

      /* ── CLOSING CTA ── */
      .aa-closing { background: #1a1f2e; padding: 5.5rem 1.5rem; position: relative; overflow: hidden; }
      .aa-closing::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 50% 100%, rgba(99,102,241,0.2) 0%, transparent 70%); pointer-events: none; }
      .aa-closing-inner { max-width: 640px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
      .aa-closing-title { font-family: theme('fontFamily.serif'); font-size: clamp(1.875rem, 3.5vw, 2.625rem); font-weight: 700; color: #fff; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 0.875rem; }
      .aa-closing-sub { font-size: 1rem; color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 2.25rem; }
      .aa-closing-cta-group { display: flex; flex-wrap: wrap; gap: 0.875rem; justify-content: center; align-items: center; }
      .aa-btn-closing { background: #6366f1; color: #fff; padding: 1rem 2.25rem; border-radius: 0.625rem; font-size: 1.0625rem; font-weight: 600; transition: background 0.2s, transform 0.15s, box-shadow 0.2s; border: none; cursor: pointer; font-family: inherit; box-shadow: 0 4px 24px rgba(99,102,241,0.35); }
      .aa-btn-closing:hover { background: #4f46e5; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(99,102,241,0.45); }
      .aa-btn-closing:focus-visible { outline: 2px solid #a5b4fc; outline-offset: 3px; }
      .aa-closing-phone { margin-top: 1.25rem; font-size: 0.875rem; color: rgba(255,255,255,0.35); }
      .aa-closing-phone a { color: rgba(255,255,255,0.55); font-weight: 500; text-decoration: none; transition: color 0.2s; }
      .aa-closing-phone a:hover { color: #fff; }

      /* ── HIDE GLOBAL HEADER & FLOAT BTN ON THIS PAGE ── */
      body[data-page="ai-audit"] header { display: none !important; }
      body[data-page="ai-audit"] #ga-float-btn { display: flex !important; }

      /* ── EXIT INTENT OVERLAY ── */
      .aa-exit-overlay { position: fixed; inset: 0; background: rgba(30,28,24,0.55); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 1.5rem; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
      .aa-exit-overlay.is-visible { opacity: 1; pointer-events: all; }
