---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Search Audit"
  description="ZeisWorks AI audit — map your firm's AI search visibility, review profile, and competitive position in 5 minutes."
  canonicalUrl="https://zeisworks.com/ai-audit/start/"
  bodyPage="ai-audit-start"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style>
      .start-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1.5rem 4rem;
        max-width: 800px;
        margin: 0 auto;
      }
      .start-eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: theme('colors.orange');
        margin-bottom: 0.75rem;
        text-align: center;
      }
      .start-heading {
        font-family: theme('fontFamily.serif');
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: theme('colors.ink');
        line-height: 1.25;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        text-align: center;
      }
      .start-sub {
        font-size: 0.9375rem;
        color: theme('colors.ink-mid');
        line-height: 1.7;
        text-align: center;
        margin-bottom: 2rem;
        max-width: 520px;
      }
      .start-chat {
        width: 100%;
        border-radius: 0.875rem;
        overflow: hidden;
        border: 1px solid #e8e3d8;
        background: #fff;
        box-shadow: 0 4px 24px rgba(30, 28, 24, 0.07);
      }
      .start-chat iframe {
        display: block;
        width: 100%;
        height: 620px;
        border: none;
      }
      .start-note {
        margin-top: 1.25rem;
        font-size: 0.8125rem;
        color: theme('colors.ink-light');
        text-align: center;
      }
      .start-note a {
        color: theme('colors.ink-mid');
        font-weight: 500;
        text-decoration: none;
      }
      .start-note a:hover { color: theme('colors.ink'); }
      @media (max-width: 640px) {
        .start-chat iframe { height: 520px; }
      }
    </style>
  </Fragment>

  <div class="start-wrap">
    <p class="start-eyebrow">Free · 5 minutes · No call required</p>
    <h1 class="start-heading">ZeisWorks AI Search Audit</h1>
    <p class="start-sub">
      Answer a few questions about your firm. We'll map your AI search visibility,
      review profile, and competitive position — then deliver a 12-month revenue plan.
    </p>
    <div class="start-chat" role="region" aria-label="AI audit chat">
      <iframe
        src="https://app.mplannerpro.com/ab3e6ce00d/chat?pg=ff84446e91"
        title="ZeisWorks AI Audit"
        allow="clipboard-write"
        loading="eager"
      ></iframe>
    </div>
    <p class="start-note">
      Questions? Call <a href="tel:+17206502447" aria-label="Call (720) 650-2447">(720) 650-2447</a>
      or <a href="/ai-audit/">learn more about the audit</a>.
    </p>
  </div>
</BaseLayout>
